package Tests.Fabrication.Printing

use Libraries.Containers.Array
use Libraries.Language.Errors.InvalidArgumentError
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Slicing.PathGenerator
use Libraries.Fabrication.Slicing.PathOrderer
use Libraries.Fabrication.Printing.GcodeWriter
use Tests.LampreyTest
use Tests.TestModels
use Tests.TestFiles
use Tests.GcodeReader

/*
Tests Libraries.Fabrication.Printing.GcodeWriter by writing a 20 mm cube
and reading the file back the way a printer would.
*/
class GcodeWriterTest is LampreyTest
    TestModels models
    TestFiles files
    Array<Contour> ordered
    text startPath = ""
    text endPath = ""
    text lf = ""

    on create
        SetName("GcodeWriter")
        lf = lf:GetLineFeed()
    end

    action Run
        Array<Contour> outlines = models:Outlines(models:Cube(), 0.2)
        integer planes = models:GetLastPlaneCount()
        PathGenerator paths
        paths:Generate(outlines, planes)
        PathOrderer orderer
        ordered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)
        startPath = files:Write("gcode/start.gcode", "; test start" + lf + "M190 S{BED_TEMP}" + lf + "M109 S{NOZZLE_TEMP}" + lf + "; bed {BED_X} x {BED_Y}")
        endPath = files:Write("gcode/end.gcode", "; test end" + lf + "M104 S0")

        WritesAPrintableFile()
        ExtrudesTheRightAmount()
        DryRun()
        BambuExtras()
        TemplatesAndPlaceholders()
        RejectsBadSettings()
    end

    action Writer returns GcodeWriter
        GcodeWriter gcode
        gcode:SetLayerHeight(0.2)
        gcode:SetLineWidth(0.4)
        gcode:SetFilamentDiameter(1.75)
        gcode:SetTemperatures(210, 60)
        gcode:SetBed(220, 220)
        gcode:SetStartGCodeFile(startPath)
        gcode:SetEndGCodeFile(endPath)
        return gcode
    end

    action WritesAPrintableFile
        Case("a printable file")
        GcodeWriter gcode = Writer()
        text path = files:Path("gcode/cube.gcode")
        gcode:Write(ordered, path)
        Array<text> warnings = gcode:GetWarnings()
        ExpectInteger(warnings:GetSize(), 0, "no warnings")
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectTrue(gcodeText:StartsWith(";Generated by the Lamprey slicer"), "the header comes first")
        ExpectContains(gcodeText, "M190 S60" + lf + "M109 S210", "the start G-code with its placeholders filled in")
        ExpectContains(gcodeText, "; bed 220.0 x 220.0", "the bed size placeholders")
        ExpectContains(gcodeText, "; test end" + lf + "M104 S0", "the end G-code")
        ExpectContains(gcodeText, "M83", "relative extrusion")
        ExpectInteger(reader:GetLayerCount(), 100, ";LAYER: comments")
        ExpectNumber(reader:GetLayerZ(0), 0.2, 0.0001, "layer 0 is printed at Z 0.2")
        ExpectNumber(reader:GetLayerZ(1), 0.4, 0.0001, "layer 1 at Z 0.4")
        ExpectNumber(reader:GetLayerZ(99), 20.0, 0.0001, "the last layer at Z 20")
        ExpectInteger(reader:GetBadNumberCount(), 0, "every number is plain decimal text (first bad line: " + reader:GetFirstBadLine() + ")")
        ExpectTrue(reader:GetRetractCount() > 0, "travels retract")
        ExpectContains(gcodeText, "M106 S", "the fan comes on")
        ExpectContains(gcodeText, ";TYPE:WALL-OUTER", "feature comments")
        // a 20 mm cube centred on a 220 mm bed: 100 to 120 mm on both axes
        ExpectNumber(reader:GetMinX(), 100, 0.5, "left edge of the print")
        ExpectNumber(reader:GetMaxX(), 120, 0.5, "right edge of the print")
        ExpectNumber(reader:GetMinY(), 100, 0.5, "front edge of the print")
        ExpectNumber(reader:GetMaxY(), 120, 0.5, "back edge of the print")
        ExpectNumber(gcode:GetFilamentLength(), reader:GetExtruded(), gcode:GetFilamentLength() * 0.001, "GetFilamentLength matches the file")
        ExpectTrue(gcode:GetMoveSeconds() > 60, "the time estimate is filled in")
    end

    action ExtrudesTheRightAmount
        Case("extrusion per millimetre")
        GcodeWriter gcode = Writer()
        text path = files:Path("gcode/cube-ratio.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        // lineWidth * layerHeight / filament area = 0.4 * 0.2 / (pi * 0.875^2)
        number expected = 0.08 / (3.141592653589793 * 0.875 * 0.875)
        ExpectNumber(reader:GetMinRatio(), expected, expected * 0.02, "least filament per mm")
        ExpectNumber(reader:GetMaxRatio(), expected, expected * 0.02, "most filament per mm")
        // a 20 mm cube is 8000 mm^3; walls, skin and 20% infill use well under all of it
        number volume = gcode:GetFilamentLength() * 3.141592653589793 * 0.875 * 0.875
        ExpectTrue(volume > 1500 and volume < 8000, "the plastic used is plausible for a 20 mm cube (" + volume + " mm^3)")
    end

    action DryRun
        Case("dry run")
        GcodeWriter gcode = Writer()
        gcode:SetDryRun(true, 20)
        text path = files:Path("gcode/cube-dry.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectInteger(reader:GetPrintMoveCount(), 0, "no move extrudes")
        ExpectInteger(reader:GetRetractCount(), 0, "nothing retracts")
        ExpectNumber(reader:GetLayerZ(0), 20.2, 0.0001, "the first layer is traced 20 mm up")
        ExpectContains(gcodeText, "M104 S0", "the nozzle heater is off")
        ExpectNotContains(gcodeText, "M109", "it never waits for heat")
    end

    action BambuExtras
        Case("Bambu extras")
        GcodeWriter gcode = Writer()
        gcode:SetBambuExtras(true)
        text path = files:Path("gcode/cube-bambu.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectTrue(gcodeText:StartsWith("; HEADER_BLOCK_START"), "the header block comes first")
        ExpectContains(gcodeText, "; total layer number: 100", "the layer count")
        ExpectContains(gcodeText, "M73 P0 R", "progress starts at 0%")
        ExpectContains(gcodeText, "M991 S0 P99", "the last layer change is reported")
        ExpectContains(gcodeText, "; EXECUTABLE_BLOCK_END", "the block is closed")
    end

    action TemplatesAndPlaceholders
        Case("missing templates and unknown placeholders")
        files:Delete("gcode/created-start.gcode")
        GcodeWriter created = Writer()
        created:SetStartGCodeFile(files:Path("gcode/created-start.gcode"))
        created:Write(ordered, files:Path("gcode/cube-created.gcode"))
        ExpectTrue(files:Exists("gcode/created-start.gcode"), "a missing start file is created from the template")
        Array<text> createdWarnings = created:GetWarnings()
        ExpectInteger(createdWarnings:GetSize(), 1, "and the user is told")

        text oddStart = files:Write("gcode/odd-start.gcode", "M109 S{NOT_A_PLACEHOLDER}")
        GcodeWriter odd = Writer()
        odd:SetStartGCodeFile(oddStart)
        odd:Write(ordered, files:Path("gcode/cube-odd.gcode"))
        Array<text> oddWarnings = odd:GetWarnings()
        ExpectInteger(oddWarnings:GetSize(), 1, "an unknown placeholder is warned about")
        if oddWarnings:GetSize() = 1
            ExpectContains(oddWarnings:Get(0), "NOT_A_PLACEHOLDER", "the warning quotes the line")
        end

        Array<Contour> nothing
        GcodeWriter empty = Writer()
        empty:Write(nothing, files:Path("gcode/empty.gcode"))
        Array<text> emptyWarnings = empty:GetWarnings()
        ExpectInteger(emptyWarnings:GetSize(), 1, "writing no paths is warned about")
    end

    action RejectsBadSettings
        Case("bad settings are refused")
        ExpectTrue(Refuses(0, 30), "a layer height of 0")
        ExpectTrue(Refuses(0.2, 0), "a travel speed of 0 (every travel would take forever)")
        ExpectFalse(Refuses(0.2, 150), "sensible values are accepted")
        boolean fan = false
        check
            GcodeWriter gcode
            gcode:SetFan(300, 1, 3)
        detect e is InvalidArgumentError
            fan = true
        end
        ExpectTrue(fan, "a fan speed above 255")
    end

    action Refuses(number layerHeight, number travelSpeed) returns boolean
        boolean refused = false
        check
            GcodeWriter gcode
            gcode:SetLayerHeight(layerHeight)
            gcode:SetTravelSpeed(travelSpeed)
        detect e is InvalidArgumentError
            refused = true
        end
        return refused
    end
end
