package tool

use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Color
use Libraries.Interface.Events.KeyboardListener
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Containers.Array
use Libraries.Containers.HashTable
use Libraries.Compute.Math

use geometry.Contour
use geometry.OverhangGrid

class LineRender is Game, KeyboardListener
    Array<Contour> contours
    Array<number> planes
    integer currPlane = 0
    Array<Drawable> draws

    integer screenSize = 800
    number margin = 40.0
    number minX = 0.0
    number minY = 0.0
    number scale = 1.0

    Math math
    HashTable<integer, boolean> plotted
    integer pixelSize = 2

    OverhangGrid overhangs
    boolean hasOverhangs = false

    Array<Contour> walls
    Array<Contour> infill
    boolean hasPaths = false
    Array<Contour> skinLines

    action SetData(Array<number> p, Array<Contour> c)
        planes = p
        contours = c
    end

    // Optional: draw toolpaths instead of the raw contours. The outer wall is
    // red, inner walls blue, infill green, the sliced outline light gray.
    action SetPaths(Array<Contour> w, Array<Contour> i)
        walls = w
        infill = i
        hasPaths = true
    end

    // Optional: solid skin lines, drawn in purple.
    action SetSkin(Array<Contour> s)
        skinLines = s
    end

    // Optional: overhang cells are drawn in orange under the contour lines.
    action SetOverhangs(OverhangGrid grid)
        overhangs = grid
        hasOverhangs = true
    end

    action LineRender
        SetScreenSize(screenSize, screenSize)
        StartGame()
    end

    action CreateGame
        ComputeBounds()
        AddKeyboardListener(me)
        currPlane = planes:GetSize() / 2
        DrawPlane(currPlane)
    end

    action PressedKey(KeyboardEvent event)
        if event:keyCode = event:UP and currPlane < planes:GetSize() - 1
            currPlane = currPlane + 1
            DrawPlane(currPlane)
        elseif event:keyCode = event:DOWN and currPlane > 0
            currPlane = currPlane - 1
            DrawPlane(currPlane)
        end
    end

    action ReleasedKey(KeyboardEvent event)
    end

    private action Min2(number a, number b) returns number
        if a < b
            return a
        end
        return b
    end

    private action Max2(number a, number b) returns number
        if a > b
            return a
        end
        return b
    end

    private action AbsInt(integer a) returns integer
        if a < 0
            return -a
        end
        return a
    end

    // Bounds over every point of every contour, so all planes share one scale.
    private action ComputeBounds
        boolean any = false
        number maxX = 0.0
        number maxY = 0.0

        integer c = 0
        repeat while c < contours:GetSize()
            Contour con = contours:Get(c)
            integer i = 0
            repeat while i < con:GetSize()
                number x = con:xs:Get(i)
                number y = con:ys:Get(i)
                if not any
                    minX = x
                    minY = y
                    maxX = x
                    maxY = y
                    any = true
                else
                    minX = Min2(minX, x)
                    minY = Min2(minY, y)
                    maxX = Max2(maxX, x)
                    maxY = Max2(maxY, y)
                end
                i = i + 1
            end
            c = c + 1
        end

        if not any
            return now
        end

        number span = Max2(maxX - minX, maxY - minY)
        if span <= 0
            span = 1.0
        end
        scale = (cast(number, screenSize) - 2.0 * margin) / span
    end

    private action ToScreenX(number x) returns number
        return margin + (x - minX) * scale
    end

    private action ToScreenY(number y) returns number
        return margin + (y - minY) * scale
    end

    private action RoundToInt(number a) returns integer
        return cast(integer, a + 0.5)
    end

    private action Plot(integer x, integer y, Color color)
        integer key = y * screenSize + x
        if plotted:HasKey(key)
            return now
        end
        plotted:Add(key, true)

        Drawable dot
        dot:LoadFilledRectangle(pixelSize, pixelSize, color)
        dot:SetPosition(x, y)
        Add(dot)
        draws:Add(dot)
    end

    private action DrawBresenLine(integer x0, integer y0, integer x1, integer y1, Color color)
        integer dx = AbsInt(x1 - x0)
        integer dy = -AbsInt(y1 - y0)
        integer sx = 1
        if x0 > x1
            sx = -1
        end
        integer sy = 1
        if y0 > y1
            sy = -1
        end
        integer err = dx + dy
        integer x = x0
        integer y = y0

        boolean done = false
        repeat until done
            Plot(x, y, color)
            if x = x1 and y = y1
                done = true
            else
                integer e2 = 2 * err
                if e2 >= dy
                    err = err + dy
                    x = x + sx
                end
                if e2 <= dx
                    err = err + dx
                    y = y + sy
                end
            end
        end
    end

    private action DrawEdge(number x0, number y0, number x1, number y1, Color color)
        DrawBresenLine(RoundToInt(ToScreenX(x0)), RoundToInt(ToScreenY(y0)),
                       RoundToInt(ToScreenX(x1)), RoundToInt(ToScreenY(y1)), color)
    end

    private action DrawMarker(number x, number y, Color color)
        Drawable marker
        marker:LoadFilledRectangle(8, 8, color)
        marker:SetPosition(RoundToInt(ToScreenX(x)) - 4, RoundToInt(ToScreenY(y)) - 4)
        Add(marker)
        draws:Add(marker)
    end

    private action ClearDrawing
        integer d = 0
        repeat while d < draws:GetSize()
            Remove(draws:Get(d))
            d = d + 1
        end
        draws:Empty()
        plotted:Empty()
    end

    private action DrawPlane(integer p)
        ClearDrawing()
        DrawOverhangs(p)   // first, so the contour lines draw on top

        if hasPaths
            DrawPaths(p)
            return now
        end

        integer loopCount = 0
        integer openCount = 0

        integer c = 0
        repeat while c < contours:GetSize()
            Contour con = contours:Get(c)
            integer n = con:GetSize()
            if con:planeIndex = p and n >= 2
                number area2 = con:SignedArea2()
                text direction = "CCW"
                if area2 < 0
                    direction = "CW"
                end
                text kind = "outer"
                if con:isHole
                    kind = "hole"
                end
                output "Contour " + loopCount + ": " + n + " points, closed=" + con:closed
                    + ", " + kind + " (depth " + con:depth + "), " + direction + ", area=" + (area2 / 2.0)

                // Edges as a gradient: blue at the start -> red at the end.
                // A closed contour also draws the implied edge from last point back to first.
                integer j = 0
                integer edgeCount = n - 1
                if con:closed
                    edgeCount = n
                end
                j = 0
                repeat while j < edgeCount
                    integer k2 = j + 1
                    if k2 = n
                        k2 = 0
                    end
                    number t = cast(number, j) / cast(number, edgeCount)
                    Color col
                    col:SetColor(t, 0.2, 1.0 - t, 1.0)
                    DrawEdge(con:xs:Get(j), con:ys:Get(j), con:xs:Get(k2), con:ys:Get(k2), col)
                    j = j + 1
                end

                // Green square at the start point
                Color green
                green:SetColor(0.0, 0.8, 0.0, 1.0)
                DrawMarker(con:HeadX(), con:HeadY(), green)

                // Open contours also get a yellow square at the dangling end
                if not con:closed
                    Color yellow
                    yellow:SetColor(1.0, 0.85, 0.0, 1.0)
                    DrawMarker(con:TailX(), con:TailY(), yellow)
                    openCount = openCount + 1
                end

                loopCount = loopCount + 1
            end
            c = c + 1
        end

        text overhangText = ""
        if hasOverhangs
            overhangText = ", overhang " + overhangs:GetOverhangArea(p) + " mm^2"
        end
        output "Plane " + p + ": " + loopCount + " contours, " + openCount + " still open" + overhangText
    end

    private action DrawPaths(integer p)
        Color gray
        gray:SetColor(0.75, 0.75, 0.75, 1.0)
        Color red
        red:SetColor(0.85, 0.15, 0.1, 1.0)
        Color blue
        blue:SetColor(0.15, 0.35, 0.9, 1.0)
        Color green
        green:SetColor(0.1, 0.65, 0.25, 1.0)
        Color purple
        purple:SetColor(0.55, 0.2, 0.75, 1.0)

        // Plot keeps the first color drawn at each pixel, so draw in priority
        // order: walls, then infill, then the outline wherever it's still visible
        integer i = 0
        integer wallLoops = 0
        repeat while i < walls:GetSize()
            Contour wall = walls:Get(i)
            if wall:planeIndex = p
                if wall:wallIndex = 0
                    DrawPolyline(wall, true, red)
                else
                    DrawPolyline(wall, true, blue)
                end
                wallLoops = wallLoops + 1
            end
            i = i + 1
        end

        integer skinCount = 0
        i = 0
        repeat while i < skinLines:GetSize()
            Contour line = skinLines:Get(i)
            if line:planeIndex = p and line:GetSize() >= 2
                DrawPolyline(line, false, purple)
                skinCount = skinCount + 1
            end
            i = i + 1
        end

        integer infillCount = 0
        number infillLength = 0.0
        i = 0
        repeat while i < infill:GetSize()
            Contour seg = infill:Get(i)
            if seg:planeIndex = p and seg:GetSize() >= 2
                DrawPolyline(seg, false, green)
                number dx = seg:TailX() - seg:HeadX()
                number dy = seg:TailY() - seg:HeadY()
                infillLength = infillLength + math:SquareRoot(dx * dx + dy * dy)
                infillCount = infillCount + 1
            end
            i = i + 1
        end

        i = 0
        repeat while i < contours:GetSize()
            Contour con = contours:Get(i)
            if con:planeIndex = p
                DrawPolyline(con, con:closed, gray)
            end
            i = i + 1
        end

        text overhangText = ""
        if hasOverhangs
            overhangText = ", overhang " + overhangs:GetOverhangArea(p) + " mm^2"
        end
        output "Plane " + p + ": " + wallLoops + " wall loops, " + skinCount + " skin lines, "
            + infillCount + " infill lines (" + infillLength + " mm)" + overhangText
    end

    private action DrawPolyline(Contour con, boolean closeIt, Color color)
        integer n = con:GetSize()
        integer edgeCount = n - 1
        if closeIt
            edgeCount = n
        end
        integer j = 0
        repeat while j < edgeCount
            integer k = j + 1
            if k = n
                k = 0
            end
            DrawEdge(con:xs:Get(j), con:ys:Get(j), con:xs:Get(k), con:ys:Get(k), color)
            j = j + 1
        end
    end

    // Draws this plane's overhang cells as orange rectangles, merging each
    // row's consecutive cells into one rectangle to keep the drawable count low.
    private action DrawOverhangs(integer p)
        if not hasOverhangs
            return now
        end

        Color orange
        orange:SetColor(1.0, 0.55, 0.0, 1.0)
        number cell = overhangs:GetCellSize()
        number ox = overhangs:GetOriginX()
        number oy = overhangs:GetOriginY()
        integer cols = overhangs:GetColumns()

        integer k = overhangs:GetStart(p)
        integer stop = overhangs:GetEnd(p)
        repeat while k < stop
            integer idx = overhangs:GetCell(k)
            integer row = idx / cols
            integer colStart = idx - row * cols
            integer colEnd = colStart

            boolean extending = true
            repeat while extending
                if k + 1 < stop
                    if overhangs:GetCell(k + 1) = row * cols + colEnd + 1
                        colEnd = colEnd + 1
                        k = k + 1
                    else
                        extending = false
                    end
                else
                    extending = false
                end
            end

            integer sx0 = RoundToInt(ToScreenX(ox + cast(number, colStart) * cell))
            integer sx1 = RoundToInt(ToScreenX(ox + cast(number, colEnd + 1) * cell))
            integer sy0 = RoundToInt(ToScreenY(oy + cast(number, row) * cell))
            integer sy1 = RoundToInt(ToScreenY(oy + cast(number, row + 1) * cell))
            integer w = sx1 - sx0
            integer h = sy1 - sy0
            if w < 1
                w = 1
            end
            if h < 1
                h = 1
            end

            Drawable rect
            rect:LoadFilledRectangle(w, h, orange)
            rect:SetPosition(sx0, sy0)
            Add(rect)
            draws:Add(rect)

            k = k + 1
        end
    end
end
