use Libraries.Containers.Array
use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.System.File

class ProfileManager

    Array<Printer> printers

    action Add(Printer printer)
        if printer = undefined
            //printer is undefined
            alert("Cannot add an undefined printer profile.")
        end
            //duplicate printer name
        if FindIn(printers, printer:GetName()) not= undefined
            alert("A printer profile named '" + printer:GetName() + "' already exists.")
        end
        printers:Add(printer)
    end

    action GetSize returns integer
        return printers:GetSize()
    end

    action Get(integer index) returns Printer
        return printers:Get(index)
    end

    action Find(text name) returns Printer
        return FindIn(printers, name)
    end

    //returns the file of the given name or undefined if no profile. 
    action Find(text name) returns Printer
        integer i = 0
        repeat printers:GetSize() times
            Printer current = printers:Get(i)
            if current:GetName() = name
                return current
            end
            i = i + 1
        end
        return undefined
    end

    //writes every profile to the file on the given path.
    action Save(text path)
        JavaScriptObjectNotation root

        integer i = 0
        repeat printers:GetSize() times
            Printer p = printers:Get(i)

            JavaScriptObjectNotation entry
            entry:Add("bedWidth", p:GetBedWidth())
            entry:Add("bedDepth", p:GetBedDepth())
            entry:Add("bedHeight", p:GetBedHeight())
            entry:Add("nozzleDiameter", p:GetNozzleDiameter())
            entry:Add("nozzleTemperature", p:GetNozzleTemperature())
            entry:Add("bedTemperature", p:GetBedTemperature())
            entry:Add("maxNozzleTemperature", p:GetMaxNozzleTemperature())
            entry:Add("maxBedTemperature", p:GetMaxBedTemperature())
            entry:Add("printSpeed", p:GetPrintSpeed())
            entry:Add("travelSpeed", p:GetTravelSpeed())
            entry:Add("filamentType", p:GetFilamentType())

            root:Add(p:GetName(), entry)
            i = i + 1
        end

        root:SetPrettyPrint(true)

        File file
        file:SetPath(path)
        file:Write(root:ToText())
    end

    //read profiles from file on the given path, replace the old profile
    action Load(text path)
        File file
        file:SetPath(path)
        if not file:Exists()
            return now
        end

        JavaScriptObjectNotation root
        root:Read(file)

        Array<text> keys = root:GetKeys()
        Array<Printer> loaded        

        integer i = 0
        repeat keys:GetSize() times
            text key = keys:Get(i)

            if FindIn(loaded, key) not= undefined
                alert("Profile file contains more than one profile names '" + key + "'.")
            end

            // GetValue returns the nested object as JSON text, so parse it into its own object
            JavaScriptObjectNotation entry
            check
                entry:Read(root:GetValue(key))
            detect e
                alert("Profile '" + key + "' is not a valid JSON object.")
            end
            

            Printer p
            p:SetName(key)
            p:SetBedWidth(cast(number, entry:GetValue("bedWidth")))
            p:SetBedDepth(cast(number, entry:GetValue("bedDepth")))
            p:SetBedHeight(cast(number, entry:GetValue("bedHeight")))
            p:SetNozzleDiameter(cast(number, entry:GetValue("nozzleDiameter")))
            p:SetNozzleTemperature(cast(integer, entry:GetValue("nozzleTemperature")))
            p:SetBedTemperature(cast(integer, entry:GetValue("bedTemperature")))
            p:SetMaxNozzleTemperature(cast(integer, entry:GetValue("maxNozzleTemperature")))
            p:SetMaxBedTemperature(cast(integer, entry:GetValue("maxBedTemperature")))
            p:SetPrintSpeed(cast(number, entry:GetValue("printSpeed")))
            p:SetTravelSpeed(cast(number, entry:GetValue("travelSpeed")))
            p:SetFilamentType(entry:GetValue("filamentType"))

            loaded:Add(p)
            i = i + 1
        end
        printers = loaded
    end

    //Boolean helper function that reurns true if JSON object contains the given key. 
    private action HasKey(JavaScriptObjectNotation json, text key) returns boolean
        Array<text> keys = json:GetKeys()
        integer i = 0
        repeat keys:GetSize() times
            if keys:Get(i) = key
                return true
            end
            i = i + 1
        end
        return false
    end

    //reurns the value for the key, error if missing
    private action GetReqValue(JavaScriptObjectNotation entry, text profileName, text key) returns text
        if not HasKey(entry, key)
            alert("Profile '" + profileName + "' is missing the required value '" + key + "'.")
        end
        return entry:GetValue(key)
    end

    //returns the value for the key as a number, error if missing or not numeric
    private action GetReqNumber(JavaScriptObjectNotation entry, text profileName, text key) returns number
        text value = GetReqValue(entry, profileName, key)
        number result = 0 
        check 
            result = cast(number, value)
        detect e
            alert("Profile '" + profileName + "' has an invalid number for '" + key + "': " + value)
        end
        return result
    end

    //returns the value for the key as a integer, error if missing or not an integer
    private action GetReqInteger(JavaScriptObjectNotation entry, text profileName, text key) returns number
        text value = GetReqValue(entry, profileName, key)
        number result = 0 
        check 
            result = cast(integer, value)
        detect e
            alert("Profile '" + profileName + "' has an invalid whole number for '" + key + "': " + value)
        end
        return result
    end

end
