package geometry

use Libraries.Containers.Array
use Libraries.Compute.Math

class PathGenerator
    number lineWidth = 0.4
    integer wallCount = 2
    number infillDensity = 0.2
    number infillOverlap = 0.25
    number minInfillLength = 0.4
    integer topLayers = 4
    integer bottomLayers = 4

    Array<Contour> walls
    Array<Contour> skin
    Array<Contour> infill

    // the outlines being processed, grouped by plane
    Array<Contour> source
    Array<integer> layerStart
    Array<integer> layerOrder

    // area left inside the walls on each plane (inner[innerStart[p] ... inner[innerStart[p + 1]]])
    Array<Contour> inner
    Array<integer> innerStart

    integer planeTotal = 0

    // inset loops thrown away because they didn't fit inside the part
    integer droppedLoops = 0
    // islands whose inset was rebuilt exactly (see ExactInset)
    integer rebuiltIslands = 0
    // plane being worked on (PolygonOps calls take it)
    integer plane = 0

    Math math
    Offsetter offsetter
    PolygonOps ops
    GeometryUtilities util

    action SetLineWidth(number width)
        lineWidth = width
        minInfillLength = width
    end

    action SetWallCount(integer count)
        wallCount = count
    end

    // 0 = no infill, 1 = solid (lines touching side by side)
    action SetInfillDensity(number density)
        infillDensity = density
    end

    // How far fill lines reach into the innermost wall, as a fraction of
    // the line width.
    action SetInfillOverlap(number overlap)
        infillOverlap = overlap
    end

    // Solid layers under top surfaces and over bottom surfaces. Typical is
    // 0.6-1.0 mm worth: 3-5 layers at 0.2 mm. 0 turns that side off.
    action SetTopLayers(integer count)
        topLayers = count
    end

    action SetBottomLayers(integer count)
        bottomLayers = count
    end

    action GetWalls returns Array<Contour>
        return walls
    end

    action GetSkin returns Array<Contour>
        return skin
    end

    action GetInfill returns Array<Contour>
        return infill
    end

    // How many inner-wall / fill loops were dropped for not fitting inside
    // a thin part (see Inset).
    action GetDroppedLoopCount returns integer
        return droppedLoops
    end

    action Generate(Array<Contour> contours, integer planeCount)
        walls:Empty()
        skin:Empty()
        infill:Empty()
        inner:Empty()
        innerStart:Empty()
        droppedLoops = 0
        rebuiltIslands = 0
        source = contours
        planeTotal = planeCount
        util:BucketUsableLoops(contours, planeCount, layerStart, layerOrder)

        // pass 1: walls and inner areas for every plane
        integer p = 0
        repeat while p < planeCount
            plane = p
            innerStart:Add(inner:GetSize())
            Array<Contour> layer = LayerContours(p)
            if layer:GetSize() > 0
                // the center line of wall sits (w + 0.5)
                // line widths inside the outline
                integer w = 0
                repeat while w < wallCount
                    // every wall, the outer one too, must really sit its depth
                    // inside the part; where the offsetter's loop doesn't,
                    // that island is rebuilt exactly (see FitInset)
                    Array<Contour> ring = Inset(layer, lineWidth * (cast(number, w) + 0.5))
                    integer r = 0
                    repeat while r < ring:GetSize()
                        Contour wall = ring:Get(r)
                        wall:wallIndex = w
                        walls:Add(wall)
                        r = r + 1
                    end
                    if w = 0
                        // parts too thin for even the outer wall: one line
                        ThinIslands(layer, ring, p)
                    else
                        // parts too thin for this wall: fill, don't leave hollow
                        GapFill(layer, w, ring, p)
                    end
                    w = w + 1
                end

                Array<Contour> area = Inset(layer, lineWidth * cast(number, wallCount))
                integer a = 0
                repeat while a < area:GetSize()
                    inner:Add(area:Get(a))
                    a = a + 1
                end
            end
            p = p + 1
        end
        innerStart:Add(inner:GetSize())

        // pass 2: skin and infill (needs the inner areas of neighbours)
        number sparseSpacing = lineWidth
        if infillDensity > 0
            sparseSpacing = lineWidth / util:Min2(infillDensity, 1.0)
        end
        p = 0
        repeat while p < planeCount
            plane = p
            Array<Contour> layer2 = LayerContours(p)
            Array<Contour> innerArea = InnerContours(p)
            if layer2:GetSize() > 0 and innerArea:GetSize() > 0
                // fill area = inner area grown back into the last wall by the overlap
                number inset = lineWidth * (cast(number, wallCount) + 0.5 - infillOverlap)
                Array<Contour> fillArea = Inset(layer2, inset)
                if fillArea:GetSize() > 0
                    Array<Contour> skinArea = FindSkin(p, innerArea)
                    if skinArea:GetSize() > 0
                        Array<Contour> solid = ops:Intersect(fillArea, skinArea, p)
                        AddLines(solid, p, lineWidth, skin)
                        if infillDensity > 0
                            Array<Contour> sparse = ops:Difference(fillArea, skinArea, p)
                            AddLines(sparse, p, lineWidth / util:Min2(infillDensity, 1.0), infill)
                        end
                    elseif infillDensity > 0
                        AddLines(fillArea, p, lineWidth / util:Min2(infillDensity, 1.0), infill)
                    end
                end
            end
            p = p + 1
        end
        if droppedLoops > 0 or rebuiltIslands > 0
            output "PathGenerator: " + droppedLoops + " bad inset loops thrown out, " + rebuiltIslands
                + " thin islands rebuilt exactly"
        end
    end

    // ------------------------------------------------------------ insets
    //
    // Offsetter moves each corner in by `depth` and lets PolygonOps keep
    // whatever winds positively. Where the outline has small notches, or
    // the part is about as thin as the inset, the moved edges fold over
    // each other and some of the folds still wind positively. Those leftovers
    // sit closer than `depth` to the edge: spurs on walls, stray walls beside
    // thin ankles, spikes and spear shafts, skin past the outer wall. A real
    // inset loop lies inside the outline and `depth` from it everywhere, so a
    // loop that doesn't is dropped, and its island rebuilt exactly.
    private action Inset(Array<Contour> outline, number depth) returns Array<Contour>
        return FitInset(outline, depth, true)
    end

    private action FitInset(Array<Contour> outline, number depth, boolean count) returns Array<Contour>
        Array<Contour> raw = offsetter:Offset(outline, depth)
        Array<Contour> kept
        Array<Contour> dropped
        integer i = 0
        repeat while i < raw:GetSize()
            Contour loop = raw:Get(i)
            if LoopFits(loop, outline, depth)
                kept:Add(loop)
            else
                dropped:Add(loop)
                if count
                    droppedLoops = droppedLoops + 1
                end
            end
            i = i + 1
        end

        // Islands that got no usable loop, or lost one, are rebuilt with an
        // exact inset (slower, so only for those). If the island really is
        // too thin, that comes back empty too.
        Array<Contour> result
        integer o = 0
        repeat while o < outline:GetSize()
            if not IsHole(o, outline)
                Contour shape = outline:Get(o)
                if HoldsLoop(shape, kept) and not HoldsLoop(shape, dropped)
                    integer k = 0
                    repeat while k < kept:GetSize()
                        Contour good = kept:Get(k)
                        if good:GetSize() > 0
                            if shape:ContainsPoint(good:xs:Get(0), good:ys:Get(0))
                                result:Add(good)
                            end
                        end
                        k = k + 1
                    end
                else
                    Array<Contour> exact = ExactInset(IslandWithHoles(o, outline), depth)
                    if exact:GetSize() > 0 and count
                        rebuiltIslands = rebuiltIslands + 1
                    end
                    integer e = 0
                    repeat while e < exact:GetSize()
                        Contour piece = exact:Get(e)
                        if piece:GetSize() >= 3
                            result:Add(piece)
                        end
                        e = e + 1
                    end
                end
            end
            o = o + 1
        end
        return result
    end

    // outline[index] plus the holes that start inside it.
    private action IslandWithHoles(integer index, Array<Contour> outline) returns Array<Contour>
        Array<Contour> island
        Contour shape = outline:Get(index)
        island:Add(shape)
        integer i = 0
        repeat while i < outline:GetSize()
            if i not= index and IsHole(i, outline)
                Contour hole = outline:Get(i)
                if hole:GetSize() > 0
                    if shape:ContainsPoint(hole:xs:Get(0), hole:ys:Get(0))
                        island:Add(hole)
                    end
                end
            end
            i = i + 1
        end
        return island
    end

    // Exact inset: the island minus a capsule (a band `depth` wide with round
    // ends) around every edge of its outline. Whatever is left is everything
    // at least `depth` from the edge, with no spikes or inside-out loops.
    private action ExactInset(Array<Contour> island, number depth) returns Array<Contour>
        ops:Clear()
        Array<number> qx
        Array<number> qy
        integer added = 0
        integer c = 0
        repeat while c < island:GetSize()
            Contour con = island:Get(c)
            integer n = con:GetSize()
            integer j = n - 1
            integer i = 0
            repeat while i < n
                number startX = con:xs:Get(j)
                number startY = con:ys:Get(j)
                number endX = con:xs:Get(i)
                number endY = con:ys:Get(i)
                number len = math:SquareRoot((endX - startX) * (endX - startX) + (endY - startY) * (endY - startY))
                if len > 0.000001
                    qx:Empty()
                    qy:Empty()
                    Capsule(startX, startY, endX, endY, len, depth, qx, qy)
                    ops:AddPoints(qx, qy, false)
                    added = added + 1
                end
                j = i
                i = i + 1
            end
            c = c + 1
        end
        if added = 0
            return island
        end
        Array<Contour> band = ops:Resolve(1, plane)
        return ops:Difference(island, band, plane)
    end

    // Counter-clockwise outline of a capsule around a?b: along the right
    // side, round b, back along the left side, round a (arcs in 30° steps).
    private action Capsule(number startX, number startY, number endX, number endY, number len, number d,
                           Array<number> qx, Array<number> qy)
        number ux = (endX - startX) / len
        number uy = (endY - startY) / len
        number nx = -uy
        number ny = ux
        // cos / sin of -90, -60, -30, 0, 30, 60, 90 degrees
        Array<number> cs
        Array<number> sn
        cs:Add(0.0)
        cs:Add(0.5)
        cs:Add(0.8660254037844386)
        cs:Add(1.0)
        cs:Add(0.8660254037844386)
        cs:Add(0.5)
        cs:Add(0.0)
        sn:Add(-1.0)
        sn:Add(-0.8660254037844386)
        sn:Add(-0.5)
        sn:Add(0.0)
        sn:Add(0.5)
        sn:Add(0.8660254037844386)
        sn:Add(1.0)
        // round b, from the right side to the left side
        integer k = 0
        repeat while k < 7
            qx:Add(endX + d * (cs:Get(k) * ux + sn:Get(k) * nx))
            qy:Add(endY + d * (cs:Get(k) * uy + sn:Get(k) * ny))
            k = k + 1
        end
        // round a, from the left side back to the right side (mirrored arc)
        k = 0
        repeat while k < 7
            qx:Add(startX + d * (-cs:Get(k) * ux - sn:Get(k) * nx))
            qy:Add(startY + d * (-cs:Get(k) * uy - sn:Get(k) * ny))
            k = k + 1
        end
    end

    // ------------------------------------------------------------ thin parts

    // The area inside wall w - 1 (its inner edge sits w line widths in).
    // Any piece of it that holds no loop of wall w is too thin for that wall
    // (an ankle, a wrist): fill it with solid lines so it isn't hollow.
    private action GapFill(Array<Contour> layer, integer w, Array<Contour> ring, integer p)
        Array<Contour> region = FitInset(layer, lineWidth * cast(number, w), false)
        Array<Contour> gaps
        integer i = 0
        repeat while i < region:GetSize()
            Contour part = region:Get(i)
            if not IsHole(i, region) and not HoldsLoop(part, ring)
                gaps:Add(part)
                // bring its holes along, so the lines go around them
                integer h = 0
                repeat while h < region:GetSize()
                    Contour hole = region:Get(h)
                    if h not= i and hole:GetSize() > 0
                        if part:ContainsPoint(hole:xs:Get(0), hole:ys:Get(0))
                            gaps:Add(hole)
                        end
                    end
                    h = h + 1
                end
            end
            i = i + 1
        end
        if gaps:GetSize() > 0
            AddLines(gaps, p, lineWidth, skin)
        end
    end

    // Outlines too thin for an outer wall (a spike tip, a fin edge, a
    // spear prong) get one line down their middle instead of nothing.
    private action ThinIslands(Array<Contour> layer, Array<Contour> outerRing, integer p)
        integer i = 0
        repeat while i < layer:GetSize()
            Contour con = layer:Get(i)
            if con:GetSize() >= 3 and not IsHole(i, layer)
                // a usable outer wall inside it? (shorter loops get dropped
                // when the paths are ordered)
                boolean walled = false
                integer r = 0
                repeat while r < outerRing:GetSize() and not walled
                    Contour loop = outerRing:Get(r)
                    if loop:GetSize() >= 3
                        if con:ContainsPoint(loop:xs:Get(0), loop:ys:Get(0)) and util:PathLength(loop) >= 1.0
                            walled = true
                        end
                    end
                    r = r + 1
                end
                if not walled
                    CenterLine(con, p)
                end
            end
            i = i + 1
        end
    end

    // One line along the outline's long axis, ending half a line width
    // short of each end and pulled in if the part curves away.
    private action CenterLine(Contour con, integer p)
        integer n = con:GetSize()
        number mx = 0.0
        number my = 0.0
        integer i = 0
        repeat while i < n
            mx = mx + con:xs:Get(i)
            my = my + con:ys:Get(i)
            i = i + 1
        end
        mx = mx / cast(number, n)
        my = my / cast(number, n)
        number sxx = 0.0
        number sxy = 0.0
        number syy = 0.0
        i = 0
        repeat while i < n
            number ex = con:xs:Get(i) - mx
            number ey = con:ys:Get(i) - my
            sxx = sxx + ex * ex
            sxy = sxy + ex * ey
            syy = syy + ey * ey
            i = i + 1
        end
        // long axis: power iteration on the spread of the points
        number ax = 1.0
        number ay = 0.37
        integer it = 0
        repeat while it < 16
            number nx = sxx * ax + sxy * ay
            number ny = sxy * ax + syy * ay
            number nlen = math:SquareRoot(nx * nx + ny * ny)
            if nlen < 0.000000001
                it = 16
            else
                ax = nx / nlen
                ay = ny / nlen
                it = it + 1
            end
        end
        number alen = math:SquareRoot(ax * ax + ay * ay)
        ax = ax / alen
        ay = ay / alen

        number low = 0.0
        number high = 0.0
        i = 0
        repeat while i < n
            number t = (con:xs:Get(i) - mx) * ax + (con:ys:Get(i) - my) * ay
            if i = 0 or t < low
                low = t
            end
            if i = 0 or t > high
                high = t
            end
            i = i + 1
        end
        low = low + lineWidth * 0.5
        high = high - lineWidth * 0.5
        if high - low < lineWidth * 0.5
            return now // a dot, not a line
        end

        // pull each end toward the middle until it's inside the part
        integer tries = 0
        repeat while tries < 8 and not con:ContainsPoint(mx + ax * low, my + ay * low)
            low = low * 0.75
            tries = tries + 1
        end
        tries = 0
        repeat while tries < 8 and not con:ContainsPoint(mx + ax * high, my + ay * high)
            high = high * 0.75
            tries = tries + 1
        end
        if high - low < lineWidth * 0.5
            return now
        end

        Contour line
        line:AddPoint(mx + ax * low, my + ay * low)
        line:AddPoint(mx + ax * high, my + ay * high)
        line:closed = false
        line:planeIndex = p
        skin:Add(line)
    end

    // loops[index] is a hole if it starts inside an odd number of the others.
    private action IsHole(integer index, Array<Contour> loops) returns boolean
        Contour loop = loops:Get(index)
        if loop:GetSize() = 0
            return false
        end
        number x = loop:xs:Get(0)
        number y = loop:ys:Get(0)
        boolean hole = false
        integer i = 0
        repeat while i < loops:GetSize()
            if i not= index
                Contour other = loops:Get(i)
                if other:ContainsPoint(x, y)
                    hole = not hole
                end
            end
            i = i + 1
        end
        return hole
    end

    // Does any loop of `ring` start inside `part`?
    private action HoldsLoop(Contour part, Array<Contour> ring) returns boolean
        integer i = 0
        repeat while i < ring:GetSize()
            Contour loop = ring:Get(i)
            if loop:GetSize() > 0
                if part:ContainsPoint(loop:xs:Get(0), loop:ys:Get(0))
                    return true
                end
            end
            i = i + 1
        end
        return false
    end

    private action LoopFits(Contour loop, Array<Contour> outline, number depth) returns boolean
        integer n = loop:GetSize()
        if n < 3
            return false
        end
        // A true inset point is never closer than `depth` to the outline; 10%
        // slack covers rounding. Even one vertex closer than that is a fold-
        // over the offsetter kept (a spur on the wall), and the island gets
        // rebuilt exactly instead.
        number need = 0.9 * depth
        integer v = 0
        repeat while v < n
            number x = loop:xs:Get(v)
            number y = loop:ys:Get(v)
            if not InsideOutline(outline, x, y)
                return false
            end
            if CloserThan(outline, x, y, need)
                return false
            end
            v = v + 1
        end
        return true
    end

    // Inside the outline (even-odd over all its loops, so holes count).
    private action InsideOutline(Array<Contour> outline, number x, number y) returns boolean
        boolean inside = false
        integer c = 0
        repeat while c < outline:GetSize()
            Contour con = outline:Get(c)
            if con:ContainsPoint(x, y)
                inside = not inside
            end
            c = c + 1
        end
        return inside
    end

    // Is (x, y) closer than `limit` to any edge of the outline? Stops at the
    // first edge that is.
    private action CloserThan(Array<Contour> outline, number x, number y, number limit) returns boolean
        number limit2 = limit * limit
        integer c = 0
        repeat while c < outline:GetSize()
            Contour con = outline:Get(c)
            integer n = con:GetSize()
            integer j = n - 1
            integer i = 0
            repeat while i < n
                number ax = con:xs:Get(j)
                number ay = con:ys:Get(j)
                number vx = con:xs:Get(i) - ax
                number vy = con:ys:Get(i) - ay
                number len2 = vx * vx + vy * vy
                number t = 0.0
                if len2 > 0
                    t = ((x - ax) * vx + (y - ay) * vy) / len2
                    if t < 0
                        t = 0.0
                    elseif t > 1
                        t = 1.0
                    end
                end
                number dx = x - (ax + t * vx)
                number dy = y - (ay + t * vy)
                if dx * dx + dy * dy < limit2
                    return true
                end
                j = i
                i = i + 1
            end
            c = c + 1
        end
        return false
    end

    private action FindSkin(integer p, Array<Contour> innerArea) returns Array<Contour>
        Array<Contour> top = Uncovered(p, innerArea, 1, topLayers)
        Array<Contour> bottom = Uncovered(p, innerArea, -1, bottomLayers)
        if top:GetSize() = 0
            return bottom
        end
        if bottom:GetSize() = 0
            return top
        end
        return ops:Union(top, bottom, p)
    end

    // The part of innerArea not covered by every one of the next `count`
    // layers in `direction` (+1 = up, -1 = down).
    private action Uncovered(integer p, Array<Contour> innerArea, integer direction, integer count) returns Array<Contour>
        Array<Contour> nothing
        if count <= 0
            return nothing
        end

        Array<Contour> covered
        integer j = 1
        repeat while j <= count
            integer q = p + direction * j
            if q < 0 or q >= planeTotal
                return innerArea // runs off the model: all of it is surface
            end
            Array<Contour> neighbour = InnerContours(q)
            if neighbour:GetSize() = 0
                return innerArea
            end
            if j = 1
                covered = neighbour
            else
                covered = ops:Intersect(covered, neighbour, p)
                if covered:GetSize() = 0
                    return innerArea
                end
            end
            j = j + 1
        end
        return ops:Difference(innerArea, covered, p)
    end

    // Scanline fill of a region with parallel lines `spacing` apart.
    private action AddLines(Array<Contour> region, integer planeIndex, number spacing, Array<Contour> target)
        if region:GetSize() = 0
            return now
        end

        // 45 degrees on even layers, 135 on odd ones
        number half = math:SquareRoot(0.5)
        number cs = half
        number sn = half
        if planeIndex mod 2 = 1
            cs = -half
        end

        // rotate the region by -angle so the lines become horizontal
        Array<number> rx
        Array<number> ry
        Array<integer> loopStart
        integer c = 0
        repeat while c < region:GetSize()
            Contour con = region:Get(c)
            loopStart:Add(rx:GetSize())
            integer i = 0
            repeat while i < con:GetSize()
                number x = con:xs:Get(i)
                number y = con:ys:Get(i)
                rx:Add(x * cs + y * sn)
                ry:Add(-x * sn + y * cs)
                i = i + 1
            end
            c = c + 1
        end
        loopStart:Add(rx:GetSize())
        if ry:GetSize() = 0
            return now
        end

        number lowY = ry:Get(0)
        number highY = lowY
        integer v = 0
        repeat while v < ry:GetSize()
            lowY = util:Min2(lowY, ry:Get(v))
            highY = util:Max2(highY, ry:Get(v))
            v = v + 1
        end

        Array<number> hits
        integer lineCount = 0
        integer line = util:CeilingToInt(lowY / spacing)
        repeat while cast(number, line) * spacing <= highY
            number scanY = cast(number, line) * spacing
            hits:Empty()

            integer L = 0
            repeat while L < region:GetSize()
                integer s = loopStart:Get(L)
                integer n = loopStart:Get(L + 1) - s
                integer j = n - 1
                integer k = 0
                repeat while k < n
                    number y0 = ry:Get(s + j)
                    number y1 = ry:Get(s + k)
                    boolean above0 = y0 > scanY
                    boolean above1 = y1 > scanY
                    if above0 not= above1
                        number x0 = rx:Get(s + j)
                        number x1 = rx:Get(s + k)
                        hits:Add(x0 + (scanY - y0) * (x1 - x0) / (y1 - y0))
                    end
                    j = k
                    k = k + 1
                end
                L = L + 1
            end

            util:SortNumbers(hits)

            integer q = 0
            repeat while q + 1 < hits:GetSize()
                number a = hits:Get(q)
                number b = hits:Get(q + 1)
                if b - a >= minInfillLength
                    // every other line runs backwards, so the nozzle zigzags
                    if lineCount mod 2 = 1
                        number swap = a
                        a = b
                        b = swap
                    end
                    // rotate the two ends by +angle
                    Contour seg
                    seg:AddPoint(a * cs - scanY * sn, a * sn + scanY * cs)
                    seg:AddPoint(b * cs - scanY * sn, b * sn + scanY * cs)
                    seg:closed = false
                    seg:planeIndex = planeIndex
                    target:Add(seg)
                end
                q = q + 2
            end
            lineCount = lineCount + 1
            line = line + 1
        end
    end

    private action LayerContours(integer p) returns Array<Contour>
        Array<Contour> layer
        integer k = layerStart:Get(p)
        repeat while k < layerStart:Get(p + 1)
            layer:Add(source:Get(layerOrder:Get(k)))
            k = k + 1
        end
        return layer
    end

    private action InnerContours(integer p) returns Array<Contour>
        Array<Contour> area
        integer k = innerStart:Get(p)
        repeat while k < innerStart:Get(p + 1)
            area:Add(inner:Get(k))
            k = k + 1
        end
        return area
    end
end
