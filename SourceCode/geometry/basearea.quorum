package geometry

use Libraries.Containers.Number64BitArray
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Containers.HashTable
use Libraries.Containers.Array

class BaseArea
    Number64BitArray Xcoords_sorted
    Number64BitArray Ycoords_sorted

    Number64BitArray Xcoords_convex
    Number64BitArray Ycoords_convex

    // using Andrew's Monotone Chain Algorithm to find convex hull
    action ConvexHull (Number64BitArray Xcoords, Number64BitArray Ycoords) 

        // REMOVING DUPLICATE POINTS BEFORE USING!!!---------------------------
        HashTable <text, boolean> uniqueCoords
        Array<integer> uniqIndices

        Number64BitArray Xcoords_unique
        Number64BitArray Ycoords_unique

        // find indices of unique coordinates
        integer index = 0
        integer uniq_index = 0
        repeat while index < Xcoords:GetSize()
            text coordinate = Xcoords:Get(uniq_index) + "," + Ycoords:Get(uniq_index)

            if not uniqueCoords:HasKey(coordinate)
                uniqueCoords:Add(coordinate, true)
                uniqIndices:Add(uniq_index)
            end

            index = index + 1
            uniq_index = uniq_index + 1
        end

        // new array for unique coordinates using gathered indices
        Xcoords_unique:SetSize(uniqIndices:GetSize())
        Ycoords_unique:SetSize(uniqIndices:GetSize())
        integer size = Xcoords_unique:GetSize()
        output "hull input: " + Xcoords:GetSize() + " points, " + size + " unique"
        integer i = 0
        repeat while i < size
            index = uniqIndices:Get(i)
            Xcoords_unique:Set(i, Xcoords:Get(index))
            Ycoords_unique:Set(i, Ycoords:Get(index))

            i = i + 1
        end

        // rearrange coordinates according to sorted indices
        Xcoords_sorted:SetSize(size)
        Ycoords_sorted:SetSize(size)
        Integer32BitArray sorted_indices = SortCoords(Xcoords_unique, Ycoords_unique)

        i = 0
        repeat while i < size
            index = sorted_indices:Get(i)
            Xcoords_sorted:Set(i, Xcoords_unique:Get(index))
            Ycoords_sorted:Set(i, Ycoords_unique:Get(index))
            i = i + 1
        end

        integer distinct = 1
integer outOfOrder = 0
integer k = 1
repeat while k < size
    if Xcoords_sorted:Get(k) < Xcoords_sorted:Get(k - 1)
        outOfOrder = outOfOrder + 1
    end
    if Xcoords_sorted:Get(k) not= Xcoords_sorted:Get(k - 1) or Ycoords_sorted:Get(k) not= Ycoords_sorted:Get(k - 1)
        distinct = distinct + 1
    end
    k = k + 1
end
output "sorted: " + distinct + " distinct points, " + outOfOrder + " out of order"

        // actual convex hull algo --------------------------------------------
        Array<integer> upperhull
        Array<integer> lowerhull
        boolean break = false
        integer first = 0
        integer second = 0

        // lowerhull
        i = 0
        repeat while i < size
            break = false
            repeat while lowerhull:GetSize() >= 2 and break = false
                first = lowerhull:Get(lowerhull:GetSize() - 1)
                lowerhull:RemoveAt(lowerhull:GetSize() - 1)
                second = lowerhull:Get(lowerhull:GetSize() - 1)
                if clockwise(second, first, i)
                    lowerhull:Add(first)
                    break = true
                end
            end
            lowerhull:Add(i)
            i = i + 1
        end

        // upperhull
        i = size - 1
        repeat while i >= 0
            break = false
            repeat while upperhull:GetSize() >= 2 and break = false
                first = upperhull:Get(upperhull:GetSize() - 1)
                upperhull:RemoveAt(upperhull:GetSize() - 1)
                second = upperhull:Get(upperhull:GetSize() - 1)
                if clockwise(second, first, i)
                    upperhull:Add(first)
                    break = true
                end
            end
            upperhull:Add(i)
            i = i - 1
        end

        // store lowerhull stack values
        integer hull_size = lowerhull:GetSize() + upperhull:GetSize() - 2
        Xcoords_convex:SetSize(hull_size)
        Ycoords_convex:SetSize(hull_size)

        // store upperhull stack values
        i = 0
        index = 0
        repeat while i < lowerhull:GetSize() - 1
            number x_val = Xcoords_sorted:Get(lowerhull:Get(i))
            Xcoords_convex:Set(index, x_val)

            number y_val = Ycoords_sorted:Get(lowerhull:Get(i))
            Ycoords_convex:Set(index, y_val)
            
            index = index + 1
            i = i + 1
        end

        // store lowerhull stack values
        i = 0
        repeat while i < upperhull:GetSize() - 1
            number x_val = Xcoords_sorted:Get(upperhull:Get(i))
            Xcoords_convex:Set(index, x_val)

            number y_val = Ycoords_sorted:Get(upperhull:Get(i))
            Ycoords_convex:Set(index, y_val)
            
            index = index + 1
            i = i + 1
        end
    end

    // lexicographically sorting the (x,y) coordinates; mergesort
    action SortCoords(Number64BitArray Xcoords, Number64BitArray Ycoords)  returns Integer32BitArray
        integer size = Xcoords:GetSize()
        Integer32BitArray indices
        Integer32BitArray temp

        indices:SetSize(size)
        temp:SetSize(size)

        integer i = 0
        repeat while i < size
            indices:Set(i, i)
            temp:Set(i, 0)
            i = i + 1
        end

        split(Xcoords, Ycoords, indices, temp, 0, size-1)
        return indices
    end

    // resursively split left and right halves of array
    action split (Number64BitArray Xcoords, Number64BitArray Ycoords, Integer32BitArray indices, Integer32BitArray temp, integer l_index, integer r_index)
        // base case: subarray is minimal
        if l_index >= r_index
            return now
        end
        
        integer middle = (l_index + r_index) / 2
        split(Xcoords, Ycoords, indices, temp, l_index, middle)
        split(Xcoords, Ycoords, indices, temp, middle + 1, r_index)

        join(Xcoords, Ycoords, indices, temp, l_index, r_index, middle)
    end

    // merges sorted array halves
    action join (Number64BitArray Xcoords, Number64BitArray Ycoords, Integer32BitArray indices, Integer32BitArray temp, integer l_index, integer r_index, integer middle)
        integer left1 = l_index
        integer left2 = middle + 1
        integer current = l_index

        // compares subarrays, stores smaller coordinate in temp array
        repeat while left1 <= middle and left2 <= r_index        
            integer sub1_index = indices:Get(left1)
            integer sub2_index = indices:Get(left2)

            boolean smaller = compare(Xcoords, Ycoords, sub1_index, sub2_index)

            if smaller
                temp:Set(current, sub1_index)
                left1 = left1 + 1
            else
                temp:Set(current, sub2_index)
                left2 = left2 + 1
            end

            current = current + 1
        end

        // right subarray finished, move remaining left subarray content into temp
        repeat while left1 <= middle
            temp:Set(current, indices:Get(left1))
            left1 = left1 + 1
            current = current + 1
        end

        // left subarray finished, move remaining right subarray content into temp
        repeat while left2 <= r_index
            temp:Set(current, indices:Get(left2))
            left2 = left2 + 1
            current = current + 1
        end
        
        // copy over temp into main indices
        current = l_index
        repeat while current <= r_index
            indices:Set(current, temp:Get(current))
            current = current + 1
        end
    end

    // true if coordinates in left subarray are smaller than right subarray's coordinates
    action compare (Number64BitArray Xcoords, Number64BitArray Ycoords, integer index1, integer index2) returns boolean
        number x1 = Xcoords:Get(index1)
        number x2 = Xcoords:Get(index2)

        // compare y coords for tiebreaker
        if x1 = x2
            number y1 = Ycoords:Get(index1)
            number y2 = Ycoords:Get(index2)
            return y1 < y2
        end

        return x1 < x2
    end

    // calculate cross product to determine if 3 points create a clockwise rotation
    action clockwise (integer index1, integer index2, integer index3) returns boolean
        number x1 = Xcoords_sorted:Get(index1)
        number x2 = Xcoords_sorted:Get(index2)
        number x3 = Xcoords_sorted:Get(index3)

        number y1 = Ycoords_sorted:Get(index1)
        number y2 = Ycoords_sorted:Get(index2)
        number y3 = Ycoords_sorted:Get(index3)

        // positive cross_product is counter-clockwise
        number cross_product = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1)
        return cross_product > 0
    end

    action GetSortedX returns Number64BitArray
        return Xcoords_sorted
    end

    action GetSortedY returns Number64BitArray
        return Ycoords_sorted
    end

    action GetConvexX returns Number64BitArray
        return Xcoords_convex
    end

    action GetConvexY returns Number64BitArray
        return Ycoords_convex
    end
end