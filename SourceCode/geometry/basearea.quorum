package geometry

use Libraries.Containers.Number64BitArray
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Containers.Stack

class BaseArea

    Number64BitArray Xcoords_default
    Number64BitArray Ycoords_default

    Number64BitArray Xcoords_sorted
    Number64BitArray Ycoords_sorted

    Number32BitArray Xcoords_convex
    Number32BitArray Ycoords_convex

    // using Andrew's Monotone Chain Algorithm to find convex hull
    action ConvexHull (Number64BitArray Xcoords, Number64BitArray Ycoords) 

        // error check
        integer size = Xcoords:GetSize()

        if size != Ycoords:GetSize()
            output "ERROR: mismatched coordinates for convhull algo"
            return
        elseif size < 3
            output "ERROR: not enough points for convhull algo"
            return
        end
       
        // store default coordinates
        Xcoords_default = Xcoords
        Ycoords_default = Ycoords

        // rearrange coordinates according to sorted indices
        Xcoords_sorted:SetSize(size)
        Ycoords_sorted:SetSize(size)
        Integer32BitArray sorted_indices = SortCoords(Xcoords, Ycoords)

        integer i = 0
        repeat while i < size
            index = sorted_indices:Get(i)
            Xcoords_sorted:Set(i, Xcoords:Get(index))
            Ycoords_sorted:Set(i, Ycoords:Get(index))
            i = i + 1
        end
    
        // actual convex hull algo ----------------------------
        Stack<integer> possible_indices

        // lowerhull
        integer i = 0
        repeat while i < size
            curr_index = sorted_indices:Get(i)

            repeat while possible_indices:GetSize() >= 2
                // get 2 points indices from stack
                first = possible_indices:Peek()
                possible_indices:Pop()
                second = possible_indices:Peek()

                // stop popping if 3 points make cw rotation + add popped value back
                if clockwise(stack2nd, stack1st, curr_index)
                    possible_indices:Push(first)
                    break
                end
            end

            possible_indices:Push(curr_index)
            i = i + 1
        end

        // store stack values
        repeat while possible_indices:GetSize() > 0
            index = possible_indices:Pop()
            x_val = Xcoords_sorted:Get(index)
            y_val = Ycoords_sorted:Get(index)

            Xcoords_convex:Add(x_val)
            Ycoords_convex:Add(y_val)
        end

        // upperhull
        i = size - 1
        repeat while i >= 0
            curr_index = sorted_indices:Get(i)

            repeat while possible_indices:GetSize() >= 2
                // get 2 points indices from stack
                first = possible_indices:Peek()
                possible_indices:Pop()
                second = possible_indices:Peek()

                // stop popping if 3 points make cw rotation + add popped value back
                if clockwise(stack2nd, stack1st, curr_index)
                    possible_indices:Push(first)
                    break
                end
            end

            possible_indices:Push(curr_index)
            i = i - 1
        end

        // store stack values (except first)
        repeat while possible_indices:GetSize() > 1
            index = possible_indices:Pop()
            x_val = Xcoords_sorted:Get(index)
            y_val = Ycoords_sorted:Get(index)

            Xcoords_convex:Set(current, x_val)
            Ycoords_convex:Set(current, y_val)
        end

        // may need to add stack values in reverse order...

        // calculate padding for stability?

    end

    // lexicographically sorting the (x,y) coordinates; mergesort
    action SortCoords(Number64BitArray Xcoords, Number64BitArray Ycoords)  returns Integer32BitArray

        integer size = Xcoords:GetSize()
        Integer32BitArray indices
        Integer32BitArray temp

        indices:SetSize(size)
        temp:SetSize(size)

        integer i = 0
        repeat while i < Xcoords:GetSize()
            indices:Set(i, i)
            temp:Set(i, 0)
            i = i + 1
        end

        split(Xcoords, Ycoords, indices, temp, 0, size-1)
        return indices
    end

    // resursively split left and right halves of array
    action split (Number64BitArray Xcoords, Number64BitArray Ycoords, Integer32BitArray indices, Integer32BitArray temp, integer l_index, integer r_index)
        // base case: subarray is minimal
        if l_index >= r_index
            return
        end
        
        integer middle = (l_index + r_index) / 2
        split(Xcoords, Ycoords, indices, temp, l_index, middle)
        split(Xcoords, Ycoords, indices, temp, middle + 1, r_index)

        join(Xcoords, Ycoords, indicesm temp, l_index, r_index, middle)
    end

    // merges sorted array halves
    action join (Number64BitArray Xcoords, Number64BitArray Ycoords, Integer32BitArray indices, Integer32BitArray temp, integer l_index, integer r_index, integer middle)
        integer left1 = l_index
        integer left2 = middle + 1
        integer current = l_index
        
        // compares subarrays, stores smaller coordinate in temp array
        repeat while left1 <= middle and left2 <= r_index
            integer sub1_index = indices:Get(left1)
            integer sub2_index = indices:Get(left2)

            boolean smaller = compare(Xcoords, Ycoords, sub1_index, sub2_index)

            if smaller
                temp:Set(current, sub1_index)
                left1 = left1 + 1
            else
                temp:Set(current, sub2_index)
                left2 = left2 + 1
            end

            current = current + 1
        end

        // right subarray finished, move remaining left subarray content into temp
        repeat while left1 <= middle
            temp:Set(current, indices:Get(left1))
            left1 = left1 + 1
            current = current + 1
        end

        // left subarray finished, move remaining right subarray content into temp
        repeat while left2 <= r_index
            temp:Set(current, indices:Get(left2))
            left2 = left2 + 1
            current = current + 1
        end
        
        // copy over temp into main indices
        current = l_index
        repeat while current <= r_index
            indices:Set(current, temp:Get(current))
            current = current + 1
        end
    end

    // true if coordinates in left subarray are smaller than right subarray's coordinates
    action compare (Number64BitArray Xcoords, Number64BitArray Ycoords, integer index1, integer index2) returns boolean
        number x1 = Xcoords:Get(index1)
        number x2 = Xcoords:Get(index2)

        // compare y coords for tiebreaker
        if x1 = x2
            number y1 = Ycoords:Get(index1)
            number y2 = Ycoords:Get(index2)
            return y1 <= y2
        end

        return x1 < x2
    end

    // calculate cross product to determine if 3 points create a clockwise rotation
    action clockwise (integer index1, integer index2, integer index3) return boolean
        number x1 = Xcoords_sorted:Get(index1)
        number x2 = Xcoords_sorted:Get(index2)
        number x3 = Xcoords_sorted:Get(index3)

        number y1 = Ycoords_sorted:Get(index1)
        number y2 = Ycoords_sorted:Get(index2)
        number y3 = Ycoords_sorted:Get(index3)

        // positive cross_product is counter-clockwise
        number cross_product = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1)
        return cross_product > 0
    end
end