package geometry

use Libraries.Containers.Array
use Libraries.Compute.Math
use Libraries.System.File
use Libraries.System.FileWriter

// Writes ordered toolpaths (from PathOrderer) as Marlin-flavoured G-code.
//
// - Absolute XYZ (G90), relative extrusion (M83): every G1 carries the
//   filament length for that move alone, which keeps retraction simple.
// - Extrusion per move = length * lineWidth * layerHeight / filament area.
// - Layer p is printed at Z = (p + 1) * layerHeight (the slice plane sits
//   in the middle of the layer, the nozzle at its top).
// - The model is centred on the bed.
// - Retracts before any travel longer than minTravelForRetract and before
//   each layer change.
// - ;LAYER: and ;TYPE: comments use Cura's names, so G-code previewers can
//   colour moves by feature.
//
// Printer-specific start and end G-code live in two text files next to the
// program, start.gcode and end.gcode (paths changeable). If a file doesn't
// exist, it's created from a generic Marlin template (Ender-3 style, 220 x
// 220 bed) with instructions at the top saying what to paste and where.
// Placeholders like {BED_TEMP} are filled in when the G-code is written.
class Gcode
    Math math
    GeometryUtilities utils

    number layerHeight = 0.2
    number lineWidth = 0.4
    number filamentDiameter = 1.75
    number nozzleDiameter = 0.4
    number flow = 1.0

    integer nozzleTemp = 210
    integer bedTemp = 60

    number bedCenterX = 110.0
    number bedCenterY = 110.0
    number bedSizeX = 220.0
    number bedSizeY = 220.0
    number bedSizeZ = 250.0       // tallest print the printer can make
    number topZ = 0.0             // nozzle height on the last layer (set by Write)
    // first layer's footprint on the bed, for printers that level only
    // where the print goes (set by Write)
    number firstMinX = 0.0
    number firstMinY = 0.0
    number firstSizeX = 0.0
    number firstSizeY = 0.0

    // speeds in mm/s
    number travelSpeed = 150.0
    number outerWallSpeed = 30.0
    number innerWallSpeed = 50.0
    number skinSpeed = 40.0
    number infillSpeed = 60.0
    number supportSpeed = 50.0
    number firstLayerSpeed = 20.0

    // Most plastic the hotend can melt, in mm^3/s (0 = no limit). Every
    // speed is capped at maxFlow / (lineWidth * layerHeight * flow).
    number maxFlow = 0.0
    number firstLayerFlow = 1.15

    number retractLength = 1.0       // ~1 mm direct drive, 4-6 mm Bowden
    number retractSpeed = 35.0
    number minTravelForRetract = 1.5
    number infillTravelLimit = 5.0

    // Z hop: on travels that retract, lift the nozzle this many mm, move,
    // then lower it, so it can't drag across the bed or the print (0 = off).
    number zHop = 0.0
    number zHopMinTravel = 1.5    // travels longer than this hop (mm)
    // true: only hop while the filament is retracted (a lift without a
    // retract just lets the nozzle ooze in the air). false: hop on every
    // travel longer than zHopMinTravel, retracted or not (the old behaviour).
    boolean zHopNeedsRetract = true

    // Retraction limit: at most maxRetracts retracts while less than
    // retractWindow mm of filament has been pushed through. Stops the
    // extruder gear from grinding one spot of filament (a common clog).
    integer maxRetracts = 10
    number retractWindow = 1.0

    // Minimum layer time: small layers (ear tips) are slowed so each layer
    // gets at least this long to cool, but never below minPrintSpeed.
    // Travel, retracts and Z hops count toward the layer's time.
    number minLayerTime = 10.0
    number minPrintSpeed = 10.0

    // Cooling pause: a layer that is still shorter than minLayerTime at
    // minPrintSpeed ends with the nozzle lifted coolLift mm, parked
    // coolClear mm beside the model, waiting out the rest (G4).
    // coolLift 0 = off (the layer just prints short, as before).
    number coolLift = 3.0
    number coolClear = 10.0
    number minDwell = 0.5         // shorter waits aren't worth the trip
    Array<number> layerDwell      // seconds to wait after each layer
    integer dwellLayers = 0
    number modelMinX = 0.0        // model footprint on the bed (set by CenterOnBed)
    number modelMaxX = 0.0

    // part cooling fan: off for the first fanOffLayers layers, then ramps
    // up to fanMax (0-255), reaching it on layer fanFullLayer
    integer fanMax = 255
    integer fanOffLayers = 1
    integer fanFullLayer = 3
    integer lastFan = 0

    text startFile = "start.gcode"
    text endFile = "end.gcode"

    // Dry run: no heating, no filament, every move lifted dryRunLift mm.
    boolean dryRun = false
    number dryRunLift = 20.0

    // state while writing
    FileWriter writer
    number posX = 0.0
    number posY = 0.0
    number posZ = 0.0             // nozzle height right now
    number layerZ = 0.0           // height of the layer being printed
    boolean zKnown = false        // false until the first move after the start code
    boolean zPending = false      // layer changed, nozzle not yet at layerZ
    boolean retracted = false
    number offsetX = 0.0
    number offsetY = 0.0
    number filamentArea = 1.0
    number totalFilament = 0.0
    number totalSeconds = 0.0
    integer lastRole = -1
    integer lastSpeed = -1
    Array<number> retractHistory
    integer skippedRetracts = 0
    Array<number> layerFactor
    Array<number> layerTime       // estimated seconds per layer, after slow-down
    number estimatedSeconds = 0.0

    // Bambu Lab extras: header block, layer / progress reports (M73, M991)
    boolean bambu = false

    // accelerations in mm/s^2 (0 = leave the printer's setting alone)
    number accelOuterWall = 0.0
    number accelInnerWall = 0.0
    number accelSkin = 0.0
    number accelInfill = 0.0
    number accelSupport = 0.0
    number accelFirstLayer = 0.0
    number accelTravel = 0.0
    integer lastAccel = -1
    integer slowedLayers = 0

    action SetLayerHeight(number height)
        layerHeight = height
    end

    action SetLineWidth(number width)
        lineWidth = width
    end

    // Nozzle size in mm, for {NOZZLE_DIAMETER} in start / end G-code.
    action SetNozzleDiameter(number diameter)
        nozzleDiameter = diameter
    end

    action SetFilamentDiameter(number diameter)
        filamentDiameter = diameter
    end

    action SetTemperatures(integer nozzle, integer bed)
        nozzleTemp = nozzle
        bedTemp = bed
    end

    action SetBed(number sizeX, number sizeY)
        bedSizeX = sizeX
        bedSizeY = sizeY
        bedCenterX = sizeX / 2.0
        bedCenterY = sizeY / 2.0
    end

    // Build height in mm (Ender-3: 250, Bambu P2S: 256). Caps {PARK_Z}.
    action SetBedHeight(number sizeZ)
        bedSizeZ = sizeZ
    end

    action SetInfillTravel(number distance)
        infillTravelLimit = distance
    end

    action SetFan(integer maxSpeed, integer offLayers, integer fullLayers)
        fanMax = maxSpeed
        fanOffLayers = offLayers
        fanFullLayer = fullLayers
    end

    action SetRetraction(number length, number speed)
        retractLength = length
        retractSpeed = speed
        retractWindow = length
    end

    // At most `count` retracts within `window` mm of extruded filament.
    // Lift the nozzle `height` mm on every travel that retracts (0 = off).
    // 0.2 - 0.4 mm stops it scraping the bed or the top of the print.
    action SetZHop(number height)
        zHop = height
    end

    // Travels longer than `distance` mm hop (default 1.5, the same as
    // retraction). Lower it (e.g. 0.8) to also lift on the short hops
    // across already-printed lines; neighbouring skin lines (0.57 mm apart
    // on the diagonal) stay unlifted so solid layers don't slow down.
    // While SetZHopNeedsRetract is on (the default) a travel also has to
    // retract to hop.
    action SetZHopMinTravel(number distance)
        zHopMinTravel = distance
    end

    // true (default): hop only on travels that retract. false: hop on every
    // travel longer than zHopMinTravel, even without a retract.
    action SetZHopNeedsRetract(boolean toggle)
        zHopNeedsRetract = toggle
    end

    // After a layer that is still under the minimum layer time at the
    // slowest speed, lift `lift` mm, park `clearance` mm beside the model
    // and wait out the rest. lift 0 turns the pause off.
    action SetCoolingPause(number lift, number clearance)
        coolLift = lift
        coolClear = clearance
    end

    // At most `count` retracts within `window` mm of extruded filament.
    action SetRetractionLimit(integer count, number window)
        maxRetracts = count
        retractWindow = window
    end

    // Slow down layers that would print in less than `seconds`.
    action SetMinLayerTime(number seconds, number slowestSpeed)
        minLayerTime = seconds
        minPrintSpeed = slowestSpeed
    end

    // Printing speed for tree supports (mm/s).
    action SetSupportSpeed(number mmPerSecond)
        supportSpeed = mmPerSecond
    end

    // Printing speeds in mm/s. The first layer uses firstLayer for
    // everything (skirt and brim always do).
    action SetSpeeds(number outerWall, number innerWall, number skin, number infill,
                     number support, number firstLayer)
        outerWallSpeed = outerWall
        innerWallSpeed = innerWall
        skinSpeed = skin
        infillSpeed = infill
        supportSpeed = support
        firstLayerSpeed = firstLayer
    end

    // Bambu Lab printers: write the header block and the layer / progress
    // reports their screen, time estimate and timelapse use:
    //   M73 P<percent> R<minutes left>, M73 L<layer>, M991 S0 P<layer>.
    action SetBambuExtras(boolean toggle)
        bambu = toggle
    end

    // Accelerations in mm/s^2, sent with M204 when they change (0 = never
    // sent, the printer keeps whatever the start G-code set).
    action SetAccelerations(number outerWall, number innerWall, number skin, number infill,
                            number support, number firstLayer, number travel)
        accelOuterWall = outerWall
        accelInnerWall = innerWall
        accelSkin = skin
        accelInfill = infill
        accelSupport = support
        accelFirstLayer = firstLayer
        accelTravel = travel
    end

    // Speed of moves that don't print (mm/s).
    action SetTravelSpeed(number mmPerSecond)
        travelSpeed = mmPerSecond
    end

    // Hotend melt limit in mm^3/s (0 = none). Faster moves than the hotend
    // can feed come out thin and weak, so every speed is capped to fit.
    action SetMaxFlow(number mm3PerSecond)
        maxFlow = mm3PerSecond
    end

    action SetFlow(number ratio)
        flow = ratio
    end

    // Extra extrusion multiplier on the first layer (default 1.15), on top
    // of SetFlow, so the first layer squishes into the bed.
    action SetFirstLayerFlow(number ratio)
        firstLayerFlow = ratio
    end

    // Only travels longer than `distance` mm retract (default 1.5).
    action SetMinTravelForRetract(number distance)
        minTravelForRetract = distance
    end

    // Where the printer's own start / end G-code is kept.
    action SetStartGCodeFile(text path)
        startFile = path
    end

    action SetEndGCodeFile(text path)
        endFile = path
    end

    // A safe test file: the printer homes, then traces every move of the
    // print `lift` mm above the bed with the heaters off and no extrusion.
    // Watch it to check the print stays on the bed and nothing collides.
    // The custom start/end G-code is NOT used in a dry run.
    action SetDryRun(boolean toggle, number lift)
        dryRun = toggle
        dryRunLift = lift
    end

    action Write(Array<Contour> paths, text filePath)
        filamentArea = 3.141592653589793 * (filamentDiameter / 2.0) * (filamentDiameter / 2.0)
        totalFilament = 0.0
        totalSeconds = 0.0
        retracted = false
        lastSpeed = -1
        retractHistory:Empty()
        skippedRetracts = 0
        lastAccel = -1
        CenterOnBed(paths)
        PlanLayerSpeeds(paths)
        FindTopZ(paths)
        FindFirstLayerBox(paths)
        if not dryRun
            EnsureTemplate(startFile, true)
            EnsureTemplate(endFile, false)
        end

        File file
        file:SetPath(filePath)
        File folder = file:GetParentDirectory()
        if not folder:Exists()
            folder:CreateDirectories()
        end
        writer:OpenForWrite(file)

        WriteStart()

        integer layer = -1
        integer i = 0
        repeat while i < paths:GetSize()
            Contour path = paths:Get(i)
            if path:planeIndex not= layer
                if layer >= 0
                    CoolDown(layer)
                end
                layer = path:planeIndex
                ChangeLayer(layer)
            end
            WritePath(path, layer)
            i = i + 1
        end

        WriteEnd()
        if bambu and not dryRun
            Line("; EXECUTABLE_BLOCK_END")
        end
        writer:Close()

        integer minutes = cast(integer, totalSeconds / 60.0)
        output "Wrote " + filePath + ": " + Fixed(totalFilament / 1000.0, 2) + " m of filament, about "
            + minutes + " min of moves (real prints run slower: acceleration isn't counted)"
        if slowedLayers > 0
            output "  " + slowedLayers + " small layers slowed down to get at least " + Fixed(minLayerTime, 0) + " s to cool"
        end
        if dwellLayers > 0
            output "  " + dwellLayers + " layers still too quick at " + Fixed(minPrintSpeed, 0)
                + " mm/s: the nozzle parks beside the model and waits after them"
        end
        if skippedRetracts > 0
            output "  " + skippedRetracts + " retracts skipped to avoid grinding the filament"
        end
    end

    // ------------------------------------------------------------ sections

    private action WriteStart
        if dryRun
            Line(";DRY RUN generated by the Lamprey slicer")
            Line(";No heating, no extrusion. Every move is lifted " + Fixed(dryRunLift, 1) + " mm above the bed.")
            Line("M104 S0")
            Line("M140 S0")
            Line("M107")
            Line("G28 ;home all axes")
            Line("G90 ;absolute XYZ")
            Line("M83 ;relative extrusion")
            Line("G1 Z" + Fixed(dryRunLift + 5.0, 3) + " F600")
            retracted = false
            posX = -1000.0
            posY = -1000.0
            zKnown = false
            zPending = false
            lastRole = -1
            lastSpeed = -1
            return now
        end
        if bambu
            integer layerCount = layerTime:GetSize()
            Line("; HEADER_BLOCK_START")
            Line("; generated by the Lamprey slicer")
            Line("; total estimated time: " + MinutesLeft(estimatedSeconds) + "m")
            Line("; total layer number: " + layerCount)
            Line("; filament_diameter: " + Fixed(filamentDiameter, 2))
            Line("; max_z_height: " + Fixed(topZ, 2))
            Line("; filament: 1")
            Line("; HEADER_BLOCK_END")
            Line("")
            Line("; EXECUTABLE_BLOCK_START")
            Line("M73 P0 R" + MinutesLeft(estimatedSeconds))
        end
        Line(";Generated by the Lamprey slicer")
        Line(";Layer height: " + Fixed(layerHeight, 3) + " mm, line width: " + Fixed(lineWidth, 3) + " mm")
        Line(";========== START G-CODE (from " + startFile + ") ==========")
        CopyCustom(startFile)
        Line(";========== END OF START G-CODE ==========")
        // whatever the custom code did, the moves below need these modes
        Line("G90 ;absolute XYZ")
        Line("M83 ;relative extrusion")
        Line("G92 E0")
        Line("M107 ;fan off for the first layer")
        lastFan = 0
        // Line("M960 L0 M0 B255 ;filament spool on") need to check if this is actually for spool
        retracted = false
        // unknown position: forces a real travel (and retract) before the first path
        posX = -1000.0
        posY = -1000.0
        zKnown = false
        zPending = false
        lastRole = -1
        lastSpeed = -1
    end

    private action WriteEnd
        // Line("M960 L0 M0 B0 ;filament spool off") need to check if this is actually for spool
        if dryRun
            Line(";END OF DRY RUN")
            Line("G91")
            Line("G1 Z10 F600 ;lift away")
            Line("G90")
            Line("M84 ;motors off")
            return now
        end
        Retract()
        Line(";========== END G-CODE (from " + endFile + ") ==========")
        CopyCustom(endFile)
    end

    // Copies a custom G-code file into the output, filling in placeholders.
    private action CopyCustom(text path)
        File file
        file:SetPath(path)
        text contents = file:Read()
        text lineFeed = ""
        lineFeed = lineFeed:GetLineFeed()
        text carriageReturn = ""
        carriageReturn = carriageReturn:GetCarriageReturn()
        Array<text> lines = contents:Split(lineFeed)
        integer i = 0
        repeat while i < lines:GetSize()
            text raw = lines:Get(i)
            text value = Substitute(raw:Replace(carriageReturn, ""))
            if not value:StartsWith(";")
                if value:Contains("{") or value:Contains("[")
                    output "Warning: " + path + " line " + (i + 1) + " still has a placeholder the slicer doesn't know: "
                        + value + "   (the printer can't read it; replace it with a number or one of the {...} names listed at the top of the file)"
                end
            end
            Line(value)
            i = i + 1
        end
    end

    // Fills in our placeholders, plus the most common Cura {...} and
    // PrusaSlicer [...] ones, so pasted profiles mostly work as-is.
    // Bounding box of everything printed on layer 0 (skirt, brim, supports
    // included), in bed coordinates.
    private action FindFirstLayerBox(Array<Contour> paths)
        boolean any = false
        number lowX = 0.0
        number lowY = 0.0
        number highX = 0.0
        number highY = 0.0
        integer i = 0
        repeat while i < paths:GetSize()
            Contour path = paths:Get(i)
            if path:planeIndex = 0
                integer j = 0
                repeat while j < path:GetSize()
                    number x = path:xs:Get(j) + offsetX
                    number y = path:ys:Get(j) + offsetY
                    if not any
                        lowX = x
                        highX = x
                        lowY = y
                        highY = y
                        any = true
                    end
                    lowX = utils:Min2(lowX, x)
                    highX = utils:Max2(highX, x)
                    lowY = utils:Min2(lowY, y)
                    highY = utils:Max2(highY, y)
                    j = j + 1
                end
            end
            i = i + 1
        end
        firstMinX = lowX
        firstMinY = lowY
        firstSizeX = highX - lowX
        firstSizeY = highY - lowY
    end

    // Hotend melt limit used by the flow macros; 12 mm^3/s (generic PLA)
    // when SetMaxFlow wasn't called.
    private action MacroFlow returns number
        if maxFlow > 0
            return maxFlow
        end
        return 12.0
    end

    // Height of the nozzle on the last layer.
    private action FindTopZ(Array<Contour> paths)
        integer top = -1
        integer i = 0
        repeat while i < paths:GetSize()
            Contour path = paths:Get(i)
            if path:planeIndex > top
                top = path:planeIndex
            end
            i = i + 1
        end
        topZ = cast(number, top + 1) * layerHeight
    end

    // Where the end G-code drops the bed to, the way Bambu's end code does
    // it: 80 - Z/2 mm below the print while that's positive, otherwise
    // 4 mm, never past the bottom of the build volume.
    private action ParkZ returns number
        number lift = 4.0
        if 80.0 - topZ / 2.0 > 0
            lift = 80.0 - topZ / 2.0
        end
        return utils:Min2(topZ + lift, bedSizeZ)
    end

    // The second, settling move goes back up 2 mm, unless the first one
    // hit the bottom of the build volume.
    private action ParkBack returns number
        if ParkZ() >= bedSizeZ
            return 0.0
        end
        return 2.0
    end

    private action Substitute(text value) returns text
        text nozzle = "" + nozzleTemp
        text bed = "" + bedTemp
        text result = value
        result = result:Replace("{NOZZLE_TEMP}", nozzle)
        result = result:Replace("{BED_TEMP}", bed)
        result = result:Replace("{BED_X}", Fixed(bedSizeX, 1))
        result = result:Replace("{BED_Y}", Fixed(bedSizeY, 1))
        result = result:Replace("{PARK_Y}", Fixed(bedSizeY - 10.0, 1))
        result = result:Replace("{LAYER_HEIGHT}", Fixed(layerHeight, 3))
        result = result:Replace("{RETRACT}", Fixed(retractLength, 3))
        result = result:Replace("{MAX_Z}", Fixed(topZ, 2))
        result = result:Replace("{LIFT_Z}", Fixed(utils:Min2(topZ + 0.4, bedSizeZ), 2))
        result = result:Replace("{CLEAR_Z}", Fixed(utils:Min2(topZ + 10.0, bedSizeZ), 2))
        result = result:Replace("{NOZZLE_DIAMETER}", Fixed(nozzleDiameter, 2))
        result = result:Replace("{FIRST_MIN_X}", Fixed(firstMinX, 3))
        result = result:Replace("{FIRST_MIN_Y}", Fixed(firstMinY, 3))
        result = result:Replace("{FIRST_SIZE_X}", Fixed(firstSizeX, 3))
        result = result:Replace("{FIRST_SIZE_Y}", Fixed(firstSizeY, 3))
        // max flow as filament feed (mm/min), Bambu's calibration value
        // (flow / 2.4) and its purge-line feed (flow / 2 / filament area)
        result = result:Replace("{FLOW_FEED}", Fixed(MacroFlow() / filamentArea * 60.0, 2))
        result = result:Replace("{CALI_FLOW}", Fixed(MacroFlow() / 2.4, 2))
        result = result:Replace("{PURGE_FEED}", Fixed(MacroFlow() / 2.0 / filamentArea, 2))
        result = result:Replace("{PARK_Z_BACK}", Fixed(ParkZ() - ParkBack(), 2))
        result = result:Replace("{PARK_Z}", Fixed(ParkZ(), 2))
        // Cura
        result = result:Replace("{material_print_temperature_layer_0}", nozzle)
        result = result:Replace("{material_print_temperature}", nozzle)
        result = result:Replace("{material_bed_temperature_layer_0}", bed)
        result = result:Replace("{material_bed_temperature}", bed)
        result = result:Replace("{machine_width}", Fixed(bedSizeX, 1))
        result = result:Replace("{machine_depth}", Fixed(bedSizeY, 1))
        // PrusaSlicer
        result = result:Replace("[first_layer_temperature]", nozzle)
        result = result:Replace("[temperature]", nozzle)
        result = result:Replace("[first_layer_bed_temperature]", bed)
        result = result:Replace("[bed_temperature]", bed)
        return result
    end

    // Creates the start or end template if the file doesn't exist yet.
    private action EnsureTemplate(text path, boolean isStart)
        File file
        file:SetPath(path)
        if file:Exists()
            return now
        end

        FileWriter template
        template:OpenForWrite(file)
        text which = "END"
        text when = "AFTER the last layer"
        text cura = "Machine Settings > End G-code"
        text prusa = "Custom G-code > End G-code"
        if isStart
            which = "START"
            when = "BEFORE the first layer"
            cura = "Machine Settings > Start G-code"
            prusa = "Custom G-code > Start G-code"
        end
        template:WriteLine("; ================================================================")
        template:WriteLine("; " + which + " G-CODE for the Lamprey slicer")
        template:WriteLine("; Runs once, " + when + ".")
        template:WriteLine(";")
        template:WriteLine("; The code below is a GENERIC Marlin template (Ender-3 style, 220 x 220")
        template:WriteLine("; bed). Replace it with your printer's own " + which + " G-code:")
        template:WriteLine(";   1. Open your printer's profile in another slicer:")
        template:WriteLine(";        Cura:        Preferences > Printers > " + cura)
        template:WriteLine(";        PrusaSlicer: Printer Settings > " + prusa)
        template:WriteLine(";   2. Copy everything in that box.")
        template:WriteLine(";   3. Delete everything BELOW the 'PASTE BELOW' line in this file,")
        template:WriteLine(";      paste your printer's code there, and save.")
        template:WriteLine(";")
        template:WriteLine("; Placeholders filled in when the G-code is written:")
        template:WriteLine(";   {NOZZLE_TEMP} {BED_TEMP} {BED_X} {BED_Y} {PARK_Y} {LAYER_HEIGHT} {RETRACT}")
        template:WriteLine("; The common Cura and PrusaSlicer temperature and bed-size placeholders")
        template:WriteLine("; ({material_print_temperature}, [first_layer_bed_temperature], ...) work")
        template:WriteLine("; too. The slicer warns about any placeholder it doesn't recognise.")
        if isStart
            template:WriteLine(";")
            template:WriteLine("; After this block the slicer itself sets G90 (absolute XYZ) and M83")
            template:WriteLine("; (relative extrusion), so pasted code may use either extrusion mode.")
        end
        template:WriteLine("; Lines starting with ; are comments; the printer ignores them.")
        template:WriteLine("; ================================================================")
        template:WriteLine("; ---------- PASTE BELOW THIS LINE ----------")
        if isStart
            template:WriteLine("M140 S{BED_TEMP} ;start heating the bed")
            template:WriteLine("M104 S{NOZZLE_TEMP} ;start heating the nozzle")
            template:WriteLine("G28 ;home all axes")
            template:WriteLine("M190 S{BED_TEMP} ;wait for the bed")
            template:WriteLine("M109 S{NOZZLE_TEMP} ;wait for the nozzle")
            template:WriteLine("G90")
            template:WriteLine("M83")
            template:WriteLine("G1 Z2.0 F3000")
            template:WriteLine("G1 X5 Y20 Z0.3 F5000")
            template:WriteLine("G1 X5 Y120 E12 F1500 ;prime line")
            template:WriteLine("G1 X5.4 Y120 F5000")
            template:WriteLine("G1 X5.4 Y20 E12 F1500 ;prime line")
            template:WriteLine("G1 Z2.0 F3000")
        else
            template:WriteLine("G91 ;relative positioning")
            template:WriteLine("G1 Z10 F600 ;lift away from the print")
            template:WriteLine("G90")
            template:WriteLine("G1 X0 Y{PARK_Y} F6000 ;present the print")
            template:WriteLine("M104 S0 ;nozzle heater off")
            template:WriteLine("M140 S0 ;bed heater off")
            template:WriteLine("M107 ;fan off")
            template:WriteLine("M84 ;motors off")
        end
        template:Close()
        output "Created " + path + " with a generic template. Open it and paste your printer's own "
            + which + " G-code below the 'PASTE BELOW' line before printing."
    end

    private action ChangeLayer(integer layer)
        Retract()
        number z = cast(number, layer + 1) * layerHeight
        if dryRun
            z = z + dryRunLift
        end
        Line(";LAYER:" + layer)
        if bambu and not dryRun
            // what Bambu's own layer-change code reports
            Line("; CHANGE_LAYER")
            Line("; Z_HEIGHT: " + Fixed(z, 2))
            Line("; LAYER_HEIGHT: " + Fixed(layerHeight, 2))
            Line("M73 L" + (layer + 1))
            Line("M991 S0 P" + layer + " ;notify layer change")
            number done = TimeBefore(layer)
            integer percent = cast(integer, 100.0 * done / utils:Max2(estimatedSeconds, 1.0))
            Line("M73 P" + percent + " R" + MinutesLeft(estimatedSeconds - done))
        end
        if not dryRun
            integer fan = FanFor(layer)
            if fan not= lastFan
                if fan = 0
                    Line("M107 ;fan off")
                else
                    Line("M106 S" + fan + " ;fan " + (fan * 100 / 255) + "%")
                end
            end
            lastFan = fan
        end
        // the next travel takes the nozzle to this height (up before
        // moving sideways, down only after it has arrived)
        layerZ = z
        zPending = true
    end

    // Fan speed for a layer: 0 for the first fanOffLayers layers, then an
    // even ramp that reaches fanMax on layer fanFullLayer.
    private action FanFor(integer layer) returns integer
        if layer < fanOffLayers
            return 0
        end
        if layer >= fanFullLayer
            return fanMax
        end
        number fraction = cast(number, layer - fanOffLayers + 1) / cast(number, fanFullLayer - fanOffLayers + 1)
        return cast(integer, fraction * cast(number, fanMax) + 0.5)
    end

    private action WritePath(Contour path, integer layer)
        integer n = path:GetSize()
        if n < 2
            return now
        end

        number speed = utils:Max2(SpeedFor(path, layer) * LayerFactor(layer), minPrintSpeed)
        text feature = "FILL"
        if path:role = 0
            feature = "WALL-OUTER"
        elseif path:role = 1
            feature = "WALL-INNER"
        elseif path:role = 2
            feature = "SKIN"
        elseif path:role = 4
            feature = "SKIRT"
        elseif path:role = 5 or path:role = 6
            feature = "SUPPORT"
        end
        Line(";TYPE:" + feature)


        // a new tine, or a switch between model and support, means crossing
        // an air gap: always retract for it, however short the move
        boolean infillToInfill = path:role = 3 and lastRole = 3
        boolean supportNow = path:role = 5 or path:role = 6
        boolean supportBefore = lastRole = 5 or lastRole = 6
        boolean newPart = path:role = 5 or (lastRole >= 0 and supportNow not= supportBefore)
        lastRole = path:role
        TravelTo(path:HeadX() + offsetX, path:HeadY() + offsetY, newPart, infillToInfill)
        Unretract()
        SetAccel(AccelFor(path, layer))

        number e = lineWidth * layerHeight / filamentArea * flow
        if layer = 0
            e = e * firstLayerFlow
        end
        integer segments = n - 1
        if path:closed
            segments = n
        end
        integer i = 0
        repeat while i < segments
            integer k = i + 1
            if k = n
                k = 0
            end
            number x = path:xs:Get(k) + offsetX
            number y = path:ys:Get(k) + offsetY
            number dx = x - posX
            number dy = y - posY
            number len = math:SquareRoot(dx * dx + dy * dy)
            if len > 0.0001
                number amount = len * e
                text move = "G1 X" + Fixed(x, 3) + " Y" + Fixed(y, 3)
                if not dryRun
                    move = move + " E" + Fixed(amount, 5)
                end
                integer feed = Feed(speed)
                if feed not= lastSpeed
                    move = move + " F" + feed
                    lastSpeed = feed
                end
                Line(move)
                totalFilament = totalFilament + amount
                totalSeconds = totalSeconds + len / speed
                posX = x
                posY = y
            end
            i = i + 1
        end
    end

    // The speed for a path, capped by the hotend's melt limit.
    private action SpeedFor(Contour path, integer layer) returns number
        number speed = BaseSpeed(path, layer)
        if maxFlow > 0
            speed = utils:Min2(speed, maxFlow / (lineWidth * layerHeight * flow))
        end
        return speed
    end

    private action BaseSpeed(Contour path, integer layer) returns number
        if layer = 0
            return firstLayerSpeed
        end
        if path:role = 0
            return outerWallSpeed
        elseif path:role = 1
            return innerWallSpeed
        elseif path:role = 2
            return skinSpeed
        elseif path:role = 4
            return firstLayerSpeed
        elseif path:role = 5 or path:role = 6
            return supportSpeed
        end
        return infillSpeed
    end

    private action LayerFactor(integer layer) returns number
        if layer < 0 or layer >= layerFactor:GetSize()
            return 1.0
        end
        return layerFactor:Get(layer)
    end

    // Works out each layer's time: printing at normal speed plus everything
    // else (travel, retracts, Z hops, the layer change). Layers under
    // minLayerTime have their printing slowed (factor < 1) so the whole
    // layer reaches it. Whatever the minPrintSpeed floor still leaves short
    // becomes a cooling pause after the layer (see CoolDown).
    private action PlanLayerSpeeds(Array<Contour> paths)
        layerFactor:Empty()
        layerDwell:Empty()
        slowedLayers = 0
        dwellLayers = 0
        integer top = -1
        integer i = 0
        repeat while i < paths:GetSize()
            Contour path = paths:Get(i)
            if path:planeIndex > top
                top = path:planeIndex
            end
            i = i + 1
        end
        // seconds spent extruding, and seconds spent on everything else
        Array<number> seconds
        Array<number> overhead
        i = 0
        repeat while i <= top
            seconds:Add(0.0)
            overhead:Add(0.0)
            i = i + 1
        end

        // a retract and its unretract
        number retractTime = 0.0
        if retractLength > 0 and retractSpeed > 0
            retractTime = 2.0 * retractLength / retractSpeed
        end
        number lastX = 0.0
        number lastY = 0.0
        boolean haveLast = false
        integer lastPlane = -1
        i = 0
        repeat while i < paths:GetSize()
            Contour path2 = paths:Get(i)
            integer pl = path2:planeIndex
            if pl >= 0 and path2:GetSize() >= 2
                number t = seconds:Get(pl) + utils:PathLength(path2) / SpeedFor(path2, pl)
                seconds:Set(pl, t)

                number extra = 0.0
                if pl not= lastPlane
                    // layer change: always retracts, Z moves at 10 mm/s (F600)
                    extra = extra + retractTime + layerHeight / 10.0
                    lastPlane = pl
                end
                if haveLast
                    number tdx = path2:HeadX() - lastX
                    number tdy = path2:HeadY() - lastY
                    number hop = math:SquareRoot(tdx * tdx + tdy * tdy)
                    extra = extra + hop / travelSpeed
                    if hop > minTravelForRetract
                        extra = extra + retractTime
                        if zHop > 0 and hop > zHopMinTravel
                            extra = extra + 2.0 * zHop / 10.0
                        end
                    end
                end
                overhead:Set(pl, overhead:Get(pl) + extra)

                // closed loops end where they started
                if path2:closed
                    lastX = path2:HeadX()
                    lastY = path2:HeadY()
                else
                    lastX = path2:TailX()
                    lastY = path2:TailY()
                end
                haveLast = true
            end
            i = i + 1
        end

        // slow-down factor: printing time stretched to fill what the
        // overhead leaves of minLayerTime
        i = 0
        repeat while i <= top
            number printing = seconds:Get(i)
            number other = overhead:Get(i)
            number factor = 1.0
            if minLayerTime > 0 and printing > 0 and printing + other < minLayerTime
                factor = printing / (minLayerTime - other)
                slowedLayers = slowedLayers + 1
            end
            layerFactor:Add(factor)
            i = i + 1
        end

        // what the layer really takes once the minPrintSpeed floor is applied
        // (the same formula WritePath uses)
        Array<number> actual
        i = 0
        repeat while i <= top
            actual:Add(overhead:Get(i))
            i = i + 1
        end
        i = 0
        repeat while i < paths:GetSize()
            Contour path3 = paths:Get(i)
            integer pl3 = path3:planeIndex
            if pl3 >= 0 and path3:GetSize() >= 2
                number slowed = utils:Max2(SpeedFor(path3, pl3) * layerFactor:Get(pl3), minPrintSpeed)
                actual:Set(pl3, actual:Get(pl3) + utils:PathLength(path3) / slowed)
            end
            i = i + 1
        end

        layerTime:Empty()
        estimatedSeconds = 0.0
        i = 0
        repeat while i <= top
            number layerSeconds = actual:Get(i)
            number dwell = 0.0
            // the last layer has nothing above it, so it never waits
            if coolLift > 0 and minLayerTime > 0 and seconds:Get(i) > 0 and i < top
                if minLayerTime - layerSeconds >= minDwell
                    dwell = minLayerTime - layerSeconds
                    dwellLayers = dwellLayers + 1
                end
            end
            layerDwell:Add(dwell)
            layerTime:Add(layerSeconds + dwell)
            estimatedSeconds = estimatedSeconds + layerSeconds + dwell
            i = i + 1
        end
    end

    private action LayerDwell(integer layer) returns number
        if layer < 0 or layer >= layerDwell:GetSize()
            return 0.0
        end
        return layerDwell:Get(layer)
    end

    // Cooling pause after `layer` (planned in PlanLayerSpeeds): retract,
    // lift, park beside the model so the hot nozzle isn't sitting over the
    // tiny layer, and wait. The next layer's first travel brings the nozzle
    // back and down (TravelTo already handles starting high).
    private action CoolDown(integer layer)
        if dryRun
            return now
        end
        number dwell = LayerDwell(layer)
        if dwell <= 0
            return now
        end
        Retract()
        number upZ = utils:Min2(posZ + coolLift, bedSizeZ)
        if upZ > posZ
            MoveZ(upZ)
        end

        // beside the model, never over it, and always on the bed
        number parkX = modelMaxX + coolClear
        if parkX > bedSizeX - 1.0
            parkX = modelMinX - coolClear
        end
        parkX = utils:Max2(1.0, utils:Min2(parkX, bedSizeX - 1.0))
        number away = utils:AbsNum(parkX - posX)
        SetAccel(accelTravel)
        integer feed = Feed(travelSpeed)
        Line("G0 X" + Fixed(parkX, 3) + " Y" + Fixed(posY, 3) + " F" + feed)
        lastSpeed = feed
        totalSeconds = totalSeconds + away / travelSpeed
        posX = parkX

        // the trip out, the trip back and the lift all count as cooling time
        number left = dwell - 2.0 * away / travelSpeed - 2.0 * coolLift / 10.0
        if left > 0
            Line("G4 P" + cast(integer, left * 1000.0 + 0.5) + " ;let layer " + layer + " cool")
            totalSeconds = totalSeconds + left
        end
    end

    // Estimated printing time of all layers below `layer`.
    private action TimeBefore(integer layer) returns number
        number total = 0.0
        integer i = 0
        repeat while i < layer
            if i < layerTime:GetSize()
                total = total + layerTime:Get(i)
            end
            i = i + 1
        end
        return total
    end

    // Whole minutes, rounded up, never negative.
    private action MinutesLeft(number seconds) returns integer
        if seconds <= 0
            return 0
        end
        integer minutes = cast(integer, seconds / 60.0)
        if cast(number, minutes) * 60.0 < seconds
            minutes = minutes + 1
        end
        return minutes
    end

    // ------------------------------------------------------------ moves

    // Moves to (x, y) without printing, ending at the layer height.
    //   - long travels retract; travels longer than zHopMinTravel lift
    //     by zHop if it's set;
    //   - on a new layer the nozzle goes up BEFORE moving sideways, and
    //     comes down only AFTER it has arrived, so it never travels low;
    //   - the first move after the start code goes sideways at whatever
    //     height the start code left the nozzle, then down.
    private action TravelTo(number x, number y, boolean forceRetract, boolean insideInfill)
        number dx = x - posX
        number dy = y - posY
        number len = math:SquareRoot(dx * dx + dy * dy)
        boolean staysInside = insideInfill and len < infillTravelLimit
        if len < 0.0001
            if zPending
                MoveZ(layerZ)
            end
            zPending = false
            return now
        end
        boolean longTravel = len > minTravelForRetract or (forceRetract and len > lineWidth)
        if staysInside
            longTravel = false
        end
        if longTravel
            Retract()
        end

        // height to travel at
        number travelZ = layerZ
        if zKnown
            travelZ = utils:Max2(posZ, layerZ)
            // hop only while retracted (unless SetZHopNeedsRetract(false)).
            // A dry run never retracts, so there a long travel is enough.
            boolean hopAllowed = retracted or not zHopNeedsRetract or (dryRun and longTravel)
            if zHop > 0 and len > zHopMinTravel and not staysInside and hopAllowed
                // the hop is measured from the layer, so a nozzle already
                // parked higher (cooling pause) doesn't go up again
                travelZ = utils:Max2(travelZ, layerZ + zHop)
            end
            if travelZ > posZ
                MoveZ(travelZ)
            end
        end

        SetAccel(accelTravel)
        integer feed = Feed(travelSpeed)
        Line("G0 X" + Fixed(x, 3) + " Y" + Fixed(y, 3) + " F" + feed)
        lastSpeed = feed
        totalSeconds = totalSeconds + len / travelSpeed
        posX = x
        posY = y

        // arrived: down to the layer
        if not zKnown or posZ not= layerZ
            MoveZ(layerZ)
        end
        zPending = false
    end

    // Acceleration for a path (0 = don't change it).
    private action AccelFor(Contour path, integer layer) returns number
        if layer = 0
            return accelFirstLayer
        end
        if path:role = 0
            return accelOuterWall
        elseif path:role = 1
            return accelInnerWall
        elseif path:role = 2
            return accelSkin
        elseif path:role = 4
            return accelFirstLayer
        elseif path:role = 5 or path:role = 6
            return accelSupport
        end
        return accelInfill
    end

    // Sends M204 only when the acceleration actually changes.
    private action SetAccel(number accel)
        if accel <= 0 or dryRun
            return now
        end
        integer a = cast(integer, accel + 0.5)
        if a not= lastAccel
            Line("M204 S" + a)
            lastAccel = a
        end
    end

    private action MoveZ(number z)
        Line("G1 Z" + Fixed(z, 3) + " F600")
        lastSpeed = -1
        posZ = z
        zKnown = true
    end

    private action Retract
        if dryRun
            return now
        end
        if not retracted
            // how many retracts happened within the last retractWindow mm of filament?
            // (the history only grows, so count backwards until out of the window)
            integer recent = 0
            integer h = retractHistory:GetSize() - 1
            boolean inWindow = true
            repeat while h >= 0 and inWindow
                if totalFilament - retractHistory:Get(h) < retractWindow
                    recent = recent + 1
                    h = h - 1
                else
                    inWindow = false
                end
            end
            if recent >= maxRetracts
                skippedRetracts = skippedRetracts + 1
                return now
            end
            retractHistory:Add(totalFilament)
            Line("G1 E-" + Fixed(retractLength, 3) + " F" + Feed(retractSpeed))
            retracted = true
            lastSpeed = -1
        end
    end

    private action Unretract
        if dryRun
            return now
        end
        if retracted
            Line("G1 E" + Fixed(retractLength, 3) + " F" + Feed(retractSpeed))
            retracted = false
            lastSpeed = -1
        end
    end

    // ------------------------------------------------------------ setup

    // Shifts everything so the model's footprint is centred on the bed.
    private action CenterOnBed(Array<Contour> paths)
        boolean any = false
        number lowX = 0.0
        number highX = 0.0
        number lowY = 0.0
        number highY = 0.0
        integer i = 0
        repeat while i < paths:GetSize()
            Contour path = paths:Get(i)
            integer j = 0
            repeat while j < path:GetSize()
                number x = path:xs:Get(j)
                number y = path:ys:Get(j)
                if not any
                    lowX = x
                    highX = x
                    lowY = y
                    highY = y
                    any = true
                end
                lowX = utils:Min2(lowX, x)
                highX = utils:Max2(highX, x)
                lowY = utils:Min2(lowY, y)
                highY = utils:Max2(highY, y)
                j = j + 1
            end
            i = i + 1
        end
        offsetX = bedCenterX - (lowX + highX) / 2.0
        offsetY = bedCenterY - (lowY + highY) / 2.0
        modelMinX = lowX + offsetX
        modelMaxX = highX + offsetX
        if highX - lowX > bedSizeX - 10.0 or highY - lowY > bedSizeY - 10.0
            output "Warning: the model (" + Fixed(highX - lowX, 1) + " x " + Fixed(highY - lowY, 1)
                + " mm) doesn't fit on the bed with a margin"
        end
    end

    // ------------------------------------------------------------ text

    private action Line(text value)
        writer:WriteLine(value)
    end

    // mm/s -> mm/min, the unit G-code F values use
    private action Feed(number mmPerSecond) returns integer
        return cast(integer, mmPerSecond * 60.0 + 0.5)
    end

    // Fixed-point text: no scientific notation, which firmware can't parse.
    private action Fixed(number value, integer decimals) returns text
        integer scale = 1
        integer d = 0
        repeat while d < decimals
            scale = scale * 10
            d = d + 1
        end
        boolean negative = value < 0
        number magnitude = utils:AbsNum(value)
        integer scaled = cast(integer, magnitude * cast(number, scale) + 0.5)
        integer whole = scaled / scale
        integer fraction = scaled - whole * scale
        text digits = "" + fraction
        repeat while digits:GetSize() < decimals
            digits = "0" + digits
        end
        text result = "" + whole
        if decimals > 0
            result = result + "." + digits
        end
        if negative and scaled not= 0
            result = "-" + result
        end
        return result
    end
end
