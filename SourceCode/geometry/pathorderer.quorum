package geometry

use Libraries.Containers.Array

class PathOrderer
    number seamX = 0.0
    number seamY = 1000000.0
    
    number minLoopLength = 1.0
    number minLineLength = 0.4
    number minSegmentLength = 0.05
    integer droppedPaths = 0
    Array<Contour> skirt
    Array<Contour> support

    number nozzleX = 0.0
    number nozzleY = 0.0
    Array<Contour> ordered

    GeometryUtilities util

    action SetSeamPoint(number x, number y)
        seamX = x
        seamY = y
    end

    action SetCleanup(number loop, number line, number segment)
        minLoopLength = loop
        minLineLength = line
        minSegmentLength = segment
    end
    
    action SetSkirt(Array<Contour> loops)
        skirt = loops
    end

    action SetSupport(Array<Contour> paths)
        support = paths
    end

    action GetDroppedCount returns integer
        return droppedPaths
    end
    
    action Order(Array<Contour> contours, Array<Contour> walls, Array<Contour> skin,
                 Array<Contour> infill, integer planeCount) returns Array<Contour>
        ordered:Empty()
        droppedPaths = 0
        nozzleX = 0.0
        nozzleY = 0.0

        Array<integer> contourStart
        Array<integer> contourOrder
        util:BucketContours(contours, planeCount, contourStart, contourOrder)
        Array<integer> wallStart
        Array<integer> wallOrder
        util:BucketContours(walls, planeCount, wallStart, wallOrder)
        Array<integer> skinStart
        Array<integer> skinOrder
        util:BucketContours(skin, planeCount, skinStart, skinOrder)
        Array<integer> infillStart
        Array<integer> infillOrder
        util:BucketContours(infill, planeCount, infillStart, infillOrder)
        Array<integer> supportStart
        Array<integer> supportOrder
        util:BucketContours(support, planeCount, supportStart, supportOrder)
        

        integer p = 0
        repeat while p < planeCount
            PrintSkirt(p)
            PrintSupport(p, supportStart, supportOrder)
        
            Array<Contour> islands
            integer i = contourStart:Get(p) 
            repeat while i < contourStart:Get(p + 1)
                Contour con = contours:Get(contourOrder:Get(i))
                if con:closed and not con:isHole and con:GetSize() >= 3
                    islands:Add(con) 
                end
                i = i + 1
            end

            Array<Contour> layerWalls
            Array<integer> wallIsland
            CollectLayer(walls, wallStart, wallOrder, p, islands, layerWalls, wallIsland)
            Array<Contour> layerSkin
            Array<integer> skinIsland
            CollectLayer(skin, skinStart, skinOrder, p, islands, layerSkin, skinIsland)
            Array<Contour> layerInfill
            Array<integer> infillIsland
            CollectLayer(infill, infillStart, infillOrder, p, islands, layerInfill, infillIsland)
        
            Array<boolean> done
            i = 0
            repeat while i < islands:GetSize()
                done:Add(false) 
                i = i + 1
            end
            integer visited = 0
            repeat while visited < islands:GetSize()
                integer best = -1
                number bestD2 = 0.0
                i = 0
                repeat while i < islands:GetSize()
                    if not done:Get(i) 
                        Contour island = islands:Get(i) 
                        number d2 = island:NearestVertexDistance2(nozzleX, nozzleY)
                        if best = -1 or d2 < bestD2
                            best = i
                            bestD2 = d2
                        end
                    end
                    i = i + 1
                end
                done:Set(best, true)
                PrintIsland(best, layerWalls, wallIsland, layerSkin, skinIsland, layerInfill, infillIsland)
                visited = visited + 1
            end

            PrintIsland(-1, layerWalls, wallIsland, layerSkin, skinIsland, layerInfill, infillIsland)
            p = p + 1
        end
        return ordered
    end

    private action PrintIsland(integer island, Array<Contour> layerWalls, Array<integer> wallIsland,
                               Array<Contour> layerSkin, Array<integer> skinIsland,
                               Array<Contour> layerInfill, Array<integer> infillIsland)
        integer maxWall = -1
        integer i = 0
        repeat while i < layerWalls:GetSize()
            Contour wall = layerWalls:Get(i) 
            if wallIsland:Get(i) = island and wall:wallIndex > maxWall
                maxWall = wall:wallIndex
            end
            i = i + 1
        end

        integer w = maxWall
        repeat while w >= 0
            Array<Contour> loops
            i = 0
            repeat while i < layerWalls:GetSize()
                Contour wall2 = layerWalls:Get(i) 
                if wallIsland:Get(i) = island and wall2:wallIndex = w
                    loops:Add(wall2)
                end
                i = i + 1
            end
            integer role = 1
            if w = 0
                role = 0
            end
            OrderLoops(loops, role)
            w = w - 1
        end
        OrderLines(OfIsland(layerSkin, skinIsland, island), 2)
        OrderLines(OfIsland(layerInfill, infillIsland, island), 3)
    end

    private action OfIsland(Array<Contour> paths, Array<integer> islandOf, integer island) returns Array<Contour>
        Array<Contour> picked
        integer i = 0
        repeat while i < paths:GetSize()
            if islandOf:Get(i) = island
                picked:Add(paths:Get(i))
            end
            i = i + 1
        end
        return picked
    end

    private action OrderLoops(Array<Contour> loops, integer role)
        Array<integer> seams
        Array<boolean> used
        integer i = 0
        repeat while i < loops:GetSize()
            Contour loop = loops:Get(i)
            seams:Add(loop:NearestVertexIndex(seamX, seamY))
            used:Add(false)
            i = i + 1
        end

        integer count = 0
        repeat while count < loops:GetSize()
            integer best = -1
            number bestD2 = 0.0
            i = 0
            repeat while i < loops:GetSize()
                if not used:Get(i) 
                    Contour cand = loops:Get(i) 
                    number dx = cand:xs:Get(seams:Get(i)) - nozzleX
                    number dy = cand:ys:Get(seams:Get(i)) - nozzleY
                    number d2 = dx * dx + dy * dy
                    if best = -1 or d2 < bestD2
                        best = i
                        bestD2 = d2
                    end
                end
                i = i + 1
            end
            used:Set(best, true)
            
            Contour src = loops:Get(best) 
            Contour path = RotatedLoop(src, seams:Get(best))
            if path:GetSize() > 3
                number cx = path:TailX() - path:HeadX()
                number cy = path:TailY() - path:HeadY()
                if cx * cx + cy * cy < minSegmentLength * minSegmentLength
                    path:xs:RemoveAt(path:xs:GetSize() - 1)
                    path:ys:RemoveAt(path:ys:GetSize() - 1)
                end
            end 
            
            path:planeIndex = src:planeIndex
            path:wallIndex = src:wallIndex
            path:role = role
            if path:GetSize() >= 3
                ordered:Add(path) 
            else
                droppedPaths = droppedPaths + 1
            end
            nozzleX = path:HeadX()
            nozzleY = path:HeadY()
            count = count + 1
        end
    end

    private action RotatedLoop(Contour src, integer start) returns Contour
        Contour path
        integer n = src:GetSize()
        integer i = 0
        repeat while i < n
            integer v = (start + i) mod n
            AddSpaced(path, src:xs:Get(v), src:ys:Get(v), false)
            i = i + 1
        end
        path:closed = true
        return path
    end

    private action OrderLines(Array<Contour> lines, integer role)
        Array<boolean> used
        integer i = 0
        repeat while i < lines:GetSize()
            used:Add(false)
            i = i + 1
        end

        integer count = 0
        repeat while count < lines:GetSize()
            integer best = -1
            boolean flip = false
            number bestD2 = 0.0
            i = 0
            repeat while i < lines:GetSize()
                if not used:Get(i) 
                    Contour line = lines:Get(i) 
                    number hx = line:HeadX() - nozzleX
                    number hy = line:HeadY() - nozzleY
                    number tx = line:TailX() - nozzleX
                    number ty = line:TailY() - nozzleY
                    number dHead = hx * hx + hy * hy
                    number dTail = tx * tx + ty * ty
                    if best = -1 or dHead < bestD2
                        best = i
                        bestD2 = dHead
                        flip = false
                    end
                    if dTail < bestD2
                        best = i
                        bestD2 = dTail
                        flip = true
                    end
                end
                i = i + 1 
            end
            used:Set(best, true)
            
            Contour src = lines:Get(best) 
            Contour path
            integer n = src:GetSize()
            i = 0
            repeat while i < n
                integer v = i
                if flip
                    v = n - 1 - i
                end
                boolean isLast = false
                if i = n - 1
                    isLast = true
                end
                AddSpaced(path, src:xs:Get(v), src:ys:Get(v), isLast) 
                i = i + 1
            end
            path:closed = false
            path:planeIndex = src:planeIndex
            path:role = role
            ordered:Add(path)
            nozzleX = path:TailX() 
            nozzleY = path:TailY() 
            count = count + 1
        end
    end

    private action PrintSkirt(integer p)
        Array<Contour> loops
        Array<number> areas
        integer i = 0
        repeat while i < skirt:GetSize()
            Contour loop = skirt:Get(i) 
            if loop:planeIndex = p and loop:GetSize() >= 3
                number a = loop:Area()
                integer at = 0
                repeat while at < areas:GetSize() and areas:Get(at) >= a
                    at = at + 1
                end
                loops:Add(at, loop)
                areas:Add(at, a)
            end
            i = i + 1
        end
        
        i = 0
        repeat while i < loops:GetSize() 
            Contour src = loops:Get(i)
            Contour path = RotatedLoop(src, src:NearestVertexIndex(nozzleX, nozzleY))
            path:planeIndex = p
            path:role = 4
            if path:GetSize() >= 3
                ordered:Add(path) 
                nozzleX = path:HeadX() 
                nozzleY = path:HeadY() 
            end
            i = i + 1
        end
    end
    
    // adds the wall loops first then the inside lines for tree supports
    private action PrintSupport(integer p, Array<integer> supportStart, Array<integer> supportOrder)
        Array<Contour> noIslands
        Array<Contour> layerSupport
        Array<integer> supportIsland
        CollectLayer(support, supportStart, supportOrder, p, noIslands, layerSupport, supportIsland)
        Array<Contour> loops
        Array<Contour> lines
        integer i = 0
        repeat while i < layerSupport:GetSize()
            Contour path = layerSupport:Get(i) 
            if path:closed 
                loops:Add(path)
            else
                lines:Add(path)
            end
            i = i + 1
        end
        OrderLoops(loops, 5)
        OrderLines(lines, 6)
    end

    private action AddSpaced(Contour path, number x, number y, boolean isLast)
        integer n = path:GetSize()
        if n = 0
            path:AddPoint(x, y)
            return now
        end
        number dx = x - path:TailX()
        number dy = y - path:TailY()
        if dx * dx + dy * dy >= minSegmentLength * minSegmentLength
            path:AddPoint(x, y)
        elseif isLast and n > 1
            path:xs:Set(n - 1, x)
            path:ys:Set(n - 1, y)
        elseif isLast   
            path:AddPoint(x, y)
        end 
    end

    private action CollectLayer(Array<Contour> all, Array<integer> starts, Array<integer> order,
                                integer p, Array<Contour> islands,
                                Array<Contour> layerPaths, Array<integer> islandOf)
        integer i = starts:Get(p) 
        repeat while i < starts:Get(p + 1)
            Contour path = all:Get(order:Get(i))
            if path:GetSize() >= 2
                number shortest = minLineLength
                if path:closed
                    shortest = minLoopLength
                end
                if util:PathLength(path) >= shortest
                    layerPaths:Add(path) 
                    islandOf:Add(IslandOf(path, islands))
                else
                    droppedPaths = droppedPaths + 1
                end
            end
            i = i + 1
        end
    end

    private action IslandOf(Contour path, Array<Contour> islands) returns integer
        number x = path:HeadX() 
        number y = path:HeadY() 
        if not path:closed
            x = (path:HeadX() + path:TailX()) / 2.0
            y = (path:HeadY() + path:TailY()) / 2.0
        end

        integer best = -1
        number bestArea = 0.0
        integer i = 0
        repeat while i < islands:GetSize()
            Contour island = islands:Get(i)
            if island:ContainsPoint(x, y)
                number area = island:SignedArea2()
                if area < 0
                    area = -area
                end
                if best = -1 or area < bestArea
                    best = i
                    bestArea = area
                end
            end 
            i = i + 1
        end

        return best
    end
end