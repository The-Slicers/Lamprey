package geometry

use Libraries.Containers.Array

class OverhangGrid
    number cellSize = 0.1
    number originX = 0.0
    number originY = 0.0
    integer cols = 0
    integer rows = 0
        
    Array<integer> cells
    Array<integer> planeStart

    GeometryUtilities util

    action SetCellSize(number size)
        if size > 0
            cellSize = size
        end
    end

    action GetCellSize returns number
        return cellSize
    end
    
    action GetOriginX returns number
        return originX
    end
    
    action GetOriginY returns number
        return originY
    end
    
    action GetColumns returns integer
        return cols
    end
    
    action GetRows returns integer
        return rows
    end

    action GetStart(integer plane) returns integer
        return planeStart:Get(plane)
    end
    
    action GetEnd(integer plane) returns integer
        return planeStart:Get(plane + 1)
    end

    action GetCell(integer i) returns integer
        return cells:Get(i)
    end

    action GetOverhangArea(integer plane) returns number
        return cast(number, GetEnd(plane) - GetStart(plane)) * cellSize * cellSize
    end

    action Build(Array<Contour> contours, integer planeCount, number allowance)
        cells:Empty()
        planeStart:Empty()
        planeStart:Add(0)
        
        // bounding box of every usable loop
        boolean any = false
        number minX = 0.0
        number minY = 0.0
        number maxX = 0.0
        number maxY = 0.0
        integer c = 0
        repeat while c < contours:GetSize()
            Contour con = contours:Get(c)
            if util:IsUsableLoop(con, planeCount)
                integer i = 0
                repeat while i < con:GetSize()
                    number x = con:xs:Get(i)
                    number y = con:ys:Get(i)
                    if not any
                        minX = x
                        minY = y
                        maxX = x
                        maxY = y
                        any = true
                    else
                        minX = util:Min2(minX, x)
                        maxX = util:Max2(maxX, x)
                        minY = util:Min2(minY, y)
                        maxY = util:Max2(maxY, y)
                    end
                    i = i + 1
                end
            end
            c = c + 1
        end
        
        if not any
            integer e = 0
            repeat while e < planeCount
                planeStart:Add(0)
                e = e + 1
            end
            return now
        end
        
        // keep grid under 4 million cells
        SizeGrid(minX, minY, maxX, maxY, allowance)
        repeat while cols * rows > 4000000
            cellSize = cellSize * 2.0
            SizeGrid(minX, minY, maxX, maxY, allowance)
            output "Overhang grid too large, cell size raised to "
                + cellSize + " mm"
        end
        if allowance < 2.0 * cellSize
            output "Warning: overhang allowance " + allowance + " mm is under two cells("
                + cellSize + " mm each). Expect false overhangs on vertical walls"
        end
        
        Array<integer> starts
        Array<integer> order
        util:BucketUsableLoops(contours, planeCount, starts, order)

        // two stamp grids, swapped every layer
        integer total = cols * rows
        Array<integer> stampA
        Array<integer> stampB
        integer t = 0
        repeat while t < total
            stampA:Add(0)
            stampB:Add(0)
            t = t + 1
        end
    
        // every cell offset within the allowance circle
        Array<integer> offX
        Array<integer> offY
        integer rc = util:FloorToInt(allowance / cellSize)
        number allow2 = allowance * allowance
        integer dy = -rc
        repeat while dy <= rc
            integer dx = -rc
            repeat while dx <= rc
                if dx not= 0 or dy not= 0
                    number d2 = cast(number, dx * dx + dy * dy) * cellSize * cellSize
                    if d2 <= allow2
                        offX:Add(dx)
                        offY:Add(dy)
                    end
                end
                dx = dx + 1
            end
            dy = dy + 1
        end

        Array<integer> spanRow
        Array<integer> spanA
        Array<integer> spanB
        p = 0
        repeat while p < planeCount
            Array<integer> curr = stampA
            Array<integer> prev = stampB
            if p mod 2 = 1
                curr = stampB
                prev = stampA
            end
            
            // stamps start at 1 so fresh = empty
            Rasterize(contours, order, starts:Get(p), starts:Get(p + 1),
                     curr, p + 1, spanRow, spanA, spanB)

            if p > 0
                integer prevStamp = p
                integer s = 0
                repeat while s < spanRow:GetSize()
                    integer row = spanRow:Get(s)
                    integer col = spanA:Get(s)
                    repeat while col <= spanB:Get(s)
                        integer index = row * cols + col
                        if prev:Get(index) not= prevStamp
                            if not Supported(prev, prevStamp, row, col, offX, offY)
                                cells:Add(index)
                            end
                        end
                        col = col + 1
                    end
                    s = s + 1
                end
            end

            planeStart:Add(cells:GetSize())
            p = p + 1
        end
    end

    // fills the cells whose centres lie inside the layer's loops
    // with stamp. every filled run of a row is also recorded in
    // spanRow / spanA / spanB (row, first col, last col)
    private action Rasterize(Array<Contour> contours, Array<integer> order, integer from, integer to,
                             Array<integer> grid, integer stamp,
                             Array<integer> spanRow, Array<integer> spanA, Array<integer> spanB)
        spanRow:Empty()
        spanA:Empty()
        spanB:Empty()
        if to <= from
            return now
        end
            
        Contour first = contours:Get(order:Get(from))
        number lowY = first:ys:Get(0)
        number highY = lowY
        integer i = from
        repeat while i < to
            Contour con = contours:Get(order:Get(i))
            integer j = 0
            repeat while j < con:GetSize()  
                number y = con:ys:Get(j)
                lowY = util:Min2(lowY, con:ys:Get(j))
                highY = util:Max2(highY, con:ys:Get(j))
                j = j + 1
            end
            i = i + 1
        end
        
        // rows whose center line falls inside the layer's Y range
        integer rStart = util:CeilingToInt((lowY - originY) / cellSize - 0.5)
        integer rEnd = util:FloorToInt((highY - originY) / cellSize - 0.5) 
        if rStart < 0
            rStart = 0
        end
        if rEnd > rows - 1
            rEnd = rows - 1
        end
        
        Array<number> hits
        integer r = rStart
        repeat while r <= rEnd
            number yc = originY + (cast(number, r) + 0.5) * cellSize
            hits:Empty()
            
            // where the row's center line crosses each loop edge
            i = from
            repeat while i < to
                Contour con2 = contours:Get(order:Get(i))
                integer n = con2:GetSize()
                integer j = n - 1
                integer k = 0
                repeat while k < n
                    number y0 = con2:ys:Get(j)
                    number y1 = con2:ys:Get(k)
                    boolean above0 = y0 > yc
                    boolean above1 = y1 > yc
                    if above0 not= above1
                        number x0 = con2:xs:Get(j)
                        number x1 = con2:xs:Get(k)
                        hits:Add(x0 + (yc - y0) * (x1 - x0) / (y1 - y0))
                    end
                    j = k
                    k = k + 1
                end
                i = i + 1
            end
            
            util:SortNumbers(hits)
            
            // crossings come in pairs
            integer q = 0
            repeat while q + 1 < hits:GetSize()
                integer cA = util:CeilingToInt((hits:Get(q) - originX) / cellSize - 0.5)
                integer cB = util:FloorToInt((hits:Get(q + 1) - originX) / cellSize - 0.5)
                if cA < 0
                    cA = 0
                end
                if cB > cols - 1
                    cB = cols - 1
                end
                if cA <= cB
                    integer col = cA
                    repeat while col <= cB
                        grid:Set(r * cols + col, stamp)
                        col = col + 1
                    end
                    spanRow:Add(r)
                    spanA:Add(cA)   
                    spanB:Add(cB)
                end
                q = q + 2
            end
            r = r + 1
        end
    end

    // true if any cell within the allowance of (row, col) was filled
    // on the previous layer
    private action Supported(Array<integer> prev, integer prevStamp, integer row, integer col,
                             Array<integer> offX, Array<integer> offY) returns boolean
        integer i = 0
        repeat while i < offX:GetSize()
            integer r = row + offY:Get(i)
            integer c = col + offX:Get(i)
            if r >= 0 and r < rows
                if c >= 0 and c < cols
                    if prev:Get(r * cols + c) = prevStamp
                        return true
                    end
                end
            end
            i = i + 1
        end
        return false
    end

    // places the grid over the bounding box with a margin
    // of allowance plus two cells on every side
    private action SizeGrid(number minX, number minY, number maxX, number maxY,
                            number allowance)
        number margin = allowance + 2.0 * cellSize
        originX = minX - margin
        originY = minY - margin
        cols = util:CeilingToInt((maxX - minX + 2.0 * margin) / cellSize) + 1
        rows = util:CeilingToInt((maxY - minY + 2.0 * margin) / cellSize) + 1
    end
end