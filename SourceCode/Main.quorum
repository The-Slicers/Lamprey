use Libraries.Game.Graphics.Models.Data.ModelLoader
use Libraries.Game.Graphics.Models.Data.ModelData
use Libraries.Game.Graphics.Models.Data.MeshData
use Libraries.Containers.Array
use Libraries.Containers.Number32BitArray
use Libraries.Containers.Number64BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Compute.Vector4
use Libraries.System.File

use geometry.TestSlicer
use geometry.Segment
use geometry.PlaneMesh
use geometry.Contour
use geometry.ContourGenerator
use geometry.OverhangGrid
use geometry.PathGenerator
use geometry.PathOrderer
use geometry.Gcode
use geometry.SkirtGenerator

use tool.LineRender

class Main
    action Main
        // Load in model from assets folder
        File file
        file:SetPath("assets/cube.obj")

        // packages model data into a ModelData class
        ModelLoader loader
        ModelData data = loader:Load(file)

        output "File: " + file:GetPath()

        // simple program to check data in the model
        PrintMeshStats(data)

        SampleRun(data)
    end

    action SampleRun(ModelData data)
        PlaneMesh meshData
        meshData:splitCoords(data)
    
        number nozzle = 0.4
        number layerHeight = 0.2
        number maxGap = 0.5 * nozzle
        number cutAmount = 0.0 // 1.6

        TestSlicer slicer
        slicer:SetUnitScale(20.0) // 25.4
        slicer:SetTriangles(meshData)
        Array<number> planeRange = slicer:GetSliceRange()         
        output "Plane Low: " + planeRange:Get(0) + " Plane High: " + planeRange:Get(1)
        Array<number> planes = slicer:BuildPlanes(planeRange:Get(0) + cutAmount, planeRange:Get(1), layerHeight)
        output "planes: " + planes:GetSize()

        Array<Segment> segments = slicer:Slice(planes)

        output "segments: " + segments:GetSize()
        output "max crossings: " + slicer:GetMaxCrossingsPerFace()
        output "odd faces: " + slicer:GetOddCrossingCount()

        ContourGenerator conGen
        conGen:SetSimplifyTolerance(0.02)
        conGen:SetMinArea(0.05) 
        Array<Contour> contours = conGen:Build(segments, planes:GetSize(), maxGap)
           
        output "flipped count: " + conGen:GetFlippedCount()
        output "specks dropped: " + conGen:GetDroppedCount()
        output "points: " + conGen:GetPointsBefore() + " -> " + conGen:GetPointsAfter()
        
        OverhangGrid overhangs
        overhangs:SetCellSize(0.1) 
        overhangs:Build(contours, planes:GetSize(), layerHeight * 1.43)
        
        PathGenerator paths
        paths:SetLineWidth(0.4) // nozzle diameter
        paths:SetWallCount(3)
        paths:SetInfillDensity(0.15) // 70%
        paths:SetTopLayers(12) 
        paths:SetBottomLayers(12) 
        paths:Generate(contours, planes:GetSize()) 
        
        Contour c = contours:Get(50)
output "contour, plane 50: " + c:GetSize() + " points, area " + (c:SignedArea2() / 2.0)
Array<Contour> walls = paths:GetWalls()
Contour outer = walls:Get(99)       // plane 50, wall 0
Contour inner = walls:Get(101)       // plane 50, wall 1
output "outer wall: " + outer:GetSize() + " points, area " + (outer:SignedArea2() / 2.0)
output "inner wall: " + inner:GetSize() + " points, area " + (inner:SignedArea2() / 2.0)
        SkirtGenerator skirtGen
        skirtGen:SetLineWidth(0.4)
        skirtGen:SetSkirt(2, 3.0, 1)
        Array<Contour> skirt = skirtGen:Generate(contours)
    

//        LineRender lr
//        lr:SetData(planes, contours)
//        lr:SetPaths(paths:GetWalls(), paths:GetInfill())
//        lr:SetSkin(paths:GetSkin())
//        lr:SetOverhangs(overhangs)
//        lr:LineRender()
        
        PathOrderer orderer
        orderer:SetSkirt(skirt)
        Array<Contour> ordered = orderer:Order(contours, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes:GetSize())
        
        Gcode gcode
        gcode:SetLayerHeight(layerHeight)
        gcode:SetLineWidth(0.4)
        gcode:SetFilamentDiameter(1.75)
        gcode:SetFlow(1.0)
        gcode:SetTemperature(200, 55)
        gcode:SetBed(160.0, 160.0)
        gcode:SetRetraction(6.0, 40.0)
        gcode:SetRetractionLimit(25, 6.0)
        gcode:SetMinLayerTime(15.0, 10.0)
        //gcode:SetDryRun(true, 20.0)
        gcode:Write(ordered, "Outputs/dry_cube.gcode")
    end

    // helper function to check if a resource exists for a model
    action HasData(Number32BitArray array) returns text
        if array = undefined or array:GetSize() = 0
            return "no :("
        end
        return "yes :)"
    end

    // Outputs mesh data ignoring materials and animations
    action PrintMeshStats(ModelData data)
        Array<MeshData> meshes = data:GetMeshes()
        integer totalVertices = 0
        integer totalTriangles = 0
        integer totalIndices = 0

        output "Meshes: " + meshes:GetSize()

        // loops through all meshes
        integer i = 0
        repeat while i < meshes:GetSize()
            MeshData mesh = meshes:Get(i)

            integer vertices = 0
            Number32BitArray positions = mesh:GetVertices()
            // we divide by 3 since positions are given as 3 values, xyz, for a single position
            if positions not= undefined
                vertices = positions:GetSize() / 3
            end

            integer indices = 0
            Integer32BitArray indexArray = mesh:GetIndices()
            // luckily just the size of the array
            if indexArray not= undefined
                indices = indexArray:GetSize()
            end
            // since triangles have 3 points, every point contains a single position and indice
            // so for every 3 indices there exists 1 triangle
            integer triangles = indices / 3

            totalVertices = totalVertices + vertices
            totalTriangles = totalTriangles + triangles
            totalIndices = totalIndices + indices

            output "Mesh " + i + ":"
            output "Vertices: " + vertices
            output "Indices: " + indices
            output "Triangles: " + triangles
            output "Normals: " + HasData(mesh:GetNormals())
            output "UVs: " + HasData(mesh:GetTextureCoordinates())
            output "Tangents: " + HasData(mesh:GetTangents())

            i = i + 1
        end
    end
end
