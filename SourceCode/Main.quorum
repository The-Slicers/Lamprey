use tool.LineRender

class Main
    action Main
        // Load in model from assets folder
        File file
        file:SetPath("assets\3dbenchy.stl")

        // packages model data into a ModelData class
        ModelLoader loader
        ModelData data = loader:Load(file)

        output "File: " + file:GetPath()

        // simple program to check data in the model
        PrintMeshStats(data)

        boolean bambu = true
        if bambu
            BambuRun(data)
        else
            EnderRun(data)
        end
    end

    action BambuRun(ModelData data)
        PlaneMesh meshData
        meshData:splitCoords(data)

        number nozzle = 0.4
        number layerHeight = 0.2
        number lineWidth = 0.40 // could be 0.40 for non bambu
        number maxGap = 0.5 * nozzle
        number cutAmount = 0.0 // 1.6

        TestSlicer slicer
        slicer:SetUnitScale(1.0) // 25.4
        slicer:SetTriangles(meshData)
        Array<number> planeRange = slicer:GetSliceRange()
        output "Plane Low: " + planeRange:Get(0) + " Plane High: " + planeRange:Get(1)
        Array<number> planes = slicer:BuildPlanes(planeRange:Get(0) + cutAmount, planeRange:Get(1), layerHeight)

        Array<Segment> segments = slicer:Slice(planes)

        output "segments: " + segments:GetSize()
        output "max crossings: " + slicer:GetMaxCrossingsPerFace()
        output "odd faces: " + slicer:GetOddCrossingCount()

        ContourGenerator conGen
        conGen:SetSimplifyTolerance(0.02)
        conGen:SetMinArea(0.05)
        Array<Contour> contours = conGen:Build(segments, planes:GetSize(), maxGap)

        output "flipped count: " + conGen:GetFlippedCount()
        output "specks dropped: " + conGen:GetDroppedCount()
        output "points: " + conGen:GetPointsBefore() + " -> " + conGen:GetPointsAfter()

//        OverhangGrid overhangs
//        overhangs:SetCellSize(0.1)
//        overhangs:Build(contours, planes:GetSize(), layerHeight * 1.43)

        PathGenerator paths
        paths:SetLineWidth(lineWidth) // nozzle diameter
        paths:SetWallCount(3)
        paths:SetInfillDensity(0.15) // 70%
        paths:SetTopLayers(3)
        paths:SetBottomLayers(3)
        paths:Generate(contours, planes:GetSize())
        
//        TreeSupport trees
//        trees:SetLayerHeight(layerHeight)
//        trees:SetLineWidth(lineWidth)
//        trees:SetTip(0.8, 1.0)
//        trees:SetGaps(0.8, 0.35, 1)
//        trees:SetRestRules(3.0, 3.0)
//        trees:Generate(contours, planes:GetSize())

        Array<Contour> base
        integer i = 0
        repeat while i < contours:GetSize()
            base:Add(contours:Get(i))
            i = i + 1
        end

//        Array<Contour> supportAreas = trees:GetAreas()
//        i = 0
//        repeat while i < supportAreas:GetSize()
//            base:Add(supportAreas:Get(i))
//            i = i + 1
//        end

//        SkirtGenerator skirtGen
//        skirtGen:SetLineWidth(lineWidth)
//        skirtGen:SetBrim(8, 0.0)
//        Array<Contour> skirt = skirtGen:Generate(base)
//
//        LineRender lr
//        lr:SetData(planes, contours)
//        lr:SetPaths(paths:GetWalls(), paths:GetInfill())
//        lr:SetSkin(paths:GetSkin())
//        lr:SetOverhangs(overhangs)
//        lr:LineRender()

        PathOrderer orderer
        //orderer:SetSkirt(skirt)
        //orderer:SetSupport(trees:GetPaths())
        Array<Contour> ordered = orderer:Order(contours, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes:GetSize())

        Gcode gcode
        gcode:SetLayerHeight(layerHeight)
        gcode:SetLineWidth(lineWidth)
        gcode:SetNozzleDiameter(nozzle)
        gcode:SetFilamentDiameter(1.75)
        gcode:SetFlow(1.0)
        gcode:SetTemperatures(210, 60)
        gcode:SetBed(220.0, 220.0)
        gcode:SetBedHeight(220.0)
        gcode:SetRetraction(0.8, 30.0)
        gcode:SetZHop(0.4)
        gcode:SetZHopMinTravel(1.5)
        gcode:SetSpeeds(200, 300, 200, 270, 150, 50)
        gcode:SetTravelSpeed(600)
        gcode:SetMaxFlow(21)
        gcode:SetAccelerations(6000, 10000, 2000, 10000, 10000, 500, 10000)
        gcode:SetRetractionLimit(90, 0.9)
        gcode:SetMinLayerTime(4.0, 20.0)
        gcode:SetBambuExtras(true)
        gcode:SetStartGCodeFile("Templates\bambu-p2s\start.gcode")
        gcode:SetEndGCodeFile("Templates\bambu-p2s\end.gcode")
        //gcode:SetDryRun(true, 20.0)
        gcode:Write(ordered, "Outputs/dry_cube.gcode")
    end

    action EnderRun(ModelData data)
        PlaneMesh meshData
        meshData:splitCoords(data)

        number nozzle = 0.4
        number layerHeight = 0.2
        number lineWidth = 0.40 // could be 0.40 for non bambu
        number maxGap = 0.5 * nozzle
        number cutAmount = 0.0 // 1.6

        TestSlicer slicer
        slicer:SetUnitScale(1.0) // 25.4
        slicer:SetTriangles(meshData)
        Array<number> planeRange = slicer:GetSliceRange()
        output "Plane Low: " + planeRange:Get(0) + " Plane High: " + planeRange:Get(1)
        Array<number> planes = slicer:BuildPlanes(planeRange:Get(0) + cutAmount, planeRange:Get(1), layerHeight)
        output "planes: " + planes:GetSize()

        Array<Segment> segments = slicer:Slice(planes)

        output "segments: " + segments:GetSize()
        output "max crossings: " + slicer:GetMaxCrossingsPerFace()
        output "odd faces: " + slicer:GetOddCrossingCount()

        ContourGenerator conGen
        conGen:SetSimplifyTolerance(0.02)
        conGen:SetMinArea(0.05)
        Array<Contour> contours = conGen:Build(segments, planes:GetSize(), maxGap)

        output "flipped count: " + conGen:GetFlippedCount()
        output "specks dropped: " + conGen:GetDroppedCount()
        output "points: " + conGen:GetPointsBefore() + " -> " + conGen:GetPointsAfter()

//        OverhangGrid overhangs
//        overhangs:SetCellSize(0.1)
//        overhangs:Build(contours, planes:GetSize(), layerHeight * 1.43)

        PathGenerator paths
        paths:SetLineWidth(lineWidth) // nozzle diameter
        paths:SetWallCount(3)
        paths:SetInfillDensity(0.15) // 70%
        paths:SetTopLayers(4)
        paths:SetBottomLayers(3)
        paths:Generate(contours, planes:GetSize())

        TreeSupport trees
        trees:SetLayerHeight(layerHeight)
        trees:SetLineWidth(lineWidth)
        trees:SetTip(0.8, 1.0)
        trees:SetGaps(0.8, 0.35, 1)
        trees:SetRestRules(3.0, 3.0)
        trees:Generate(contours, planes:GetSize())

        Array<Contour> base
        integer i = 0
        repeat while i < contours:GetSize()
            base:Add(contours:Get(i))
            i = i + 1
        end

        Array<Contour> supportAreas = trees:GetAreas()
        i = 0
        repeat while i < supportAreas:GetSize()
            base:Add(supportAreas:Get(i))
            i = i + 1
        end

//        SkirtGenerator skirtGen
//        skirtGen:SetLineWidth(lineWidth)
//        skirtGen:SetBrim(8, 0.0)
//        Array<Contour> skirt = skirtGen:Generate(base)

//        LineRender lr
//        lr:SetData(planes, contours)
//        lr:SetPaths(paths:GetWalls(), paths:GetInfill())
//        lr:SetSkin(paths:GetSkin())
//        lr:SetOverhangs(overhangs)
//        lr:LineRender()

        PathOrderer orderer
//        orderer:SetSkirt(skirt)
        orderer:SetSupport(trees:GetPaths())
        Array<Contour> ordered = orderer:Order(contours, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes:GetSize())

        Gcode gcode
        gcode:SetLayerHeight(layerHeight)
        gcode:SetLineWidth(lineWidth)
        gcode:SetNozzleDiameter(0.4)
        gcode:SetFilamentDiameter(1.75)
        gcode:SetFlow(1.0)
        gcode:SetTemperatures(210, 60)
        gcode:SetBed(200.0, 200.0)
        gcode:SetBedHeight(200.0)
        gcode:SetRetraction(6.0, 40.0)
        gcode:SetZHop(0.4)
        gcode:SetZHopMinTravel(0.8)
        gcode:SetSpeeds(25, 45, 40, 60, 40, 15)
        gcode:SetTravelSpeed(150)
        gcode:SetMaxFlow(10)
        gcode:SetRetractionLimit(90, 6.0)
        gcode:SetMinLayerTime(8.0, 10.0)
        gcode:SetFan(255, 1, 3) // for 0.12 layer height change to 255 1 5
        gcode:SetBambuExtras(false)
        gcode:SetStartGCodeFile("Templates\ender3-v2\start.gcode")
        gcode:SetEndGCodeFile("Templates\ender3-v2\end.gcode")
        //gcode:SetDryRun(true, 20.0)
        gcode:Write(ordered, "Outputs/dry_cube.gcode")
    end

    // helper function to check if a resource exists for a model
    action HasData(Number32BitArray array) returns text
        if array = undefined or array:GetSize() = 0
            return "no :("
        end
        return "yes :)"
    end

    action DescribeContour(Contour c) returns text
    integer n = c:xs:GetSize()
    number area = 0
    integer k = 0
    repeat while k < n
        integer k2 = k + 1
        if k2 = n
            k2 = 0
        end
        area = area + c:xs:Get(k) * c:ys:Get(k2) - c:xs:Get(k2) * c:ys:Get(k)
        k = k + 1
    end
    area = area / 2
    return "pts=" + n + " area=" + area + " start=(" + c:xs:Get(0) + ", " + c:ys:Get(0) + ")"
end

action SameLoop(Contour a, Contour b) returns boolean
    if a:xs:GetSize() not= b:xs:GetSize()
        return false
    end
    integer k = 0
    repeat while k < a:xs:GetSize()
        number dx = a:xs:Get(k) - b:xs:Get(k)
        number dy = a:ys:Get(k) - b:ys:Get(k)
        if dx > 0.01 or dx < -0.01 or dy > 0.01 or dy < -0.01
            return false
        end
        k = k + 1
    end
    return true
end

action DumpLayer(text label, Array<Contour> list, integer layer)
    output "---- " + label + ", layer " + layer + " ----"
    integer count = 0
    integer i = 0
    repeat while i < list:GetSize()
        Contour c = list:Get(i)
        if c:planeIndex = layer
            output "  [" + i + "] " + DescribeContour(c)
            count = count + 1
        end
        i = i + 1
    end
    output "  total: " + count
end

action FindDuplicates(text label, Array<Contour> list)
    integer found = 0
    integer i = 0
    repeat while i < list:GetSize()
        Contour a = list:Get(i)
        integer j = i + 1
        repeat while j < list:GetSize()
            Contour b = list:Get(j)
            if a:planeIndex = b:planeIndex
                if SameLoop(a, b)
                    output label + " DUPLICATE layer " + a:planeIndex + ": [" + i + "] = [" + j + "] " + DescribeContour(a)
                    found = found + 1
                end
            end
            j = j + 1
        end
        i = i + 1
    end
    output label + ": " + found + " duplicate pairs"
end

    // Outputs mesh data ignoring materials and animations
    action PrintMeshStats(ModelData data)
        Array<MeshData> meshes = data:GetMeshes()
        integer totalVertices = 0
        integer totalTriangles = 0
        integer totalIndices = 0

        output "Meshes: " + meshes:GetSize()

        // loops through all meshes
        integer i = 0
        repeat while i < meshes:GetSize()
            MeshData mesh = meshes:Get(i)

            integer vertices = 0
            Number32BitArray positions = mesh:GetVertices()
            // we divide by 3 since positions are given as 3 values, xyz, for a single position
            if positions not= undefined
                vertices = positions:GetSize() / 3
            end

            integer indices = 0
            Integer32BitArray indexArray = mesh:GetIndices()
            // luckily just the size of the array
            if indexArray not= undefined
                indices = indexArray:GetSize()
            end
            // since triangles have 3 points, every point contains a single position and indice
            // so for every 3 indices there exists 1 triangle
            integer triangles = indices / 3

            totalVertices = totalVertices + vertices
            totalTriangles = totalTriangles + triangles
            totalIndices = totalIndices + indices

            output "Mesh " + i + ":"
            output "Vertices: " + vertices
            output "Indices: " + indices
            output "Triangles: " + triangles
            output "Normals: " + HasData(mesh:GetNormals())
            output "UVs: " + HasData(mesh:GetTextureCoordinates())
            output "Tangents: " + HasData(mesh:GetTangents())

            i = i + 1
        end
    end
end
