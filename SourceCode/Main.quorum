use Libraries.Containers.Array
use Libraries.System.File
use Libraries.Game.Graphics.Models.Data.ModelLoader
use Libraries.Game.Graphics.Models.Data.ModelData

use Libraries.Fabrication.ArgumentChecker
use Libraries.Fabrication.SliceJob
use Libraries.Fabrication.Profiles.ProfileManager
use Libraries.Fabrication.Profiles.Profile
use Libraries.Fabrication.Printing.Bambu.BambuSettingsMap
use Tests.LampreyTests

/*
    Lamprey: slices one model with one printer profile.

    Set runTests to true to run the test suite (SourceCode/Tests) instead.

    Change the four settings below to slice something else. Every printer,
    filament and print setting lives in Profiles/profiles.json; a profile can
    also be changed for this run only, for example:
        profile:SetNumber("layerHeight", 0.16)
*/
class Main
    boolean runTests = false
    text modelPath = "assets/xyzCalibration_cube.stl"
    text profilesPath = "Profiles/profiles.json"
    text profileName = "bambu-a1"          // or "bambu-a1", "bambu-p2s", "ender3-v2", "ender3-v2-fine", "bambu-p2s-petg"
    text outputFolder = "Outputs"

    action Main
        if runTests
            LampreyTests tests
            integer failed = tests:Run()
            return now
        end

        ArgumentChecker checker
        checker:RequireFile("Model", modelPath)
        File file
        file:SetPath(modelPath)
        ModelLoader loader
        ModelData data = loader:Load(file)
        if data = undefined
            alert("Could not load the model " + modelPath + ". Lamprey reads the formats ModelLoader does, such as .stl and .obj.")
        end

        ProfileManager profiles
        profiles:Load(profilesPath)
        PrintWarnings(profiles:GetWarnings())
        Profile profile = profiles:Require(profileName)

        text gcodePath = outputFolder + "/" + BaseName(modelPath) + ".gcode"
        SliceJob job
        job:Run(data, profile, gcodePath)

        // a standalone copy of the Bambu settings that went into the 3MF, to inspect or diff
        if profile:GetBoolean("write3mf")
            BambuSettingsMap map
            map:SetReportMissing(false)
            text settingsPath = map:WriteTemplate(profile, profile:GetText("bambuSettingsTemplate"), outputFolder + "/project_settings.json")
            output "Wrote " + settingsPath + ": the " + map:GetFilledCount() + " Bambu settings the 3MF was made with"
        end
    end

    private action PrintWarnings(Array<text> warnings)
        integer i = 0
        repeat while i < warnings:GetSize()
            output "warning: " + warnings:Get(i)
            i = i + 1
        end
    end

    /* The file name without its folder or extension: "assets/3dbenchy.stl" -> "3dbenchy". */
    private action BaseName(text path) returns text
        text name = path
        integer i = name:GetSize() - 1
        boolean searching = true
        repeat while i >= 0 and searching
            text c = name:GetCharacter(i)
            if c = "/" or c = "\"
                name = name:GetSubtext(i + 1)
                searching = false
            end
            i = i - 1
        end
        integer dot = name:GetSize() - 1
        repeat while dot > 0
            if name:GetCharacter(dot) = "."
                return name:GetSubtext(0, dot)
            end
            dot = dot - 1
        end
        return name
    end
end
