package Tests

use Libraries.Containers.Array
use Libraries.Compute.Math
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Geometry.OutlineEdges
use Libraries.Fabrication.Geometry.VoronoiDiagram
use Libraries.Fabrication.Geometry.SkeletalTrapezoidation
use Libraries.Fabrication.Geometry.CenterMarking
use Libraries.Fabrication.Geometry.GeometryUtilities

class CenterMarkingTests
    GeometryUtilities util
    Math math
    integer passed = 0
    integer failed = 0

    action Run returns integer
        TestArraySizesMatchTheSkeleton()
        TestBeadCountIsDiameterInWidths()
        TestEveryNodeHasABeadCount()
        TestFeetAreNeverCentral()
        TestCentreOfSquareIsCentral()
        TestCentralEdgesHaveCentralInteriorEnds()
        TestShortGapsBetweenCentralNodesAreFilled()
        TestWedgeSpineIsCentral()
        TestSignificanceRuleDirection()
        TestEqualRadiusEdgesAreMarked()
        TestMarkingIsSymmetric()

        output "CenterMarking tests: passed " + passed + ", failed " + failed
        return failed
    end

    action Check(boolean condition, text name)
        if condition
            passed = passed + 1
        else
            failed = failed + 1
            output "FAIL: " + name
        end
    end

    // ------------------------------------------------------------ fixtures

    // Counter-clockwise square from (x0, y0) to (x1, y1), in millimetres.
    private action Square(number x0, number y0, number x1, number y1) returns Contour
        Contour c
        c:AddPoint(x0, y0)
        c:AddPoint(x1, y0)
        c:AddPoint(x1, y1)
        c:AddPoint(x0, y1)
        c:closed = true
        return c
    end

    // Clockwise square, as ContourGenerator orients a hole.
    private action HoleSquare(number x0, number y0, number x1, number y1) returns Contour
        Contour c
        c:AddPoint(x0, y0)
        c:AddPoint(x0, y1)
        c:AddPoint(x1, y1)
        c:AddPoint(x1, y0)
        c:closed = true
        return c
    end

    // The reference shape: outer 0..1 mm, hole 0.4..0.6 mm.
    private action ReferenceContours returns Array<Contour>
        Array<Contour> contours
        contours:Add(Square(0, 0, 1, 1))
        contours:Add(HoleSquare(0.4, 0.4, 0.6, 0.6))
        return contours
    end

    // A plain 20 mm square with no hole. Its centre is a Voronoi vertex where the diagonals meet.
    private action BigSquareContours returns Array<Contour>
        Array<Contour> contours
        contours:Add(Square(0, 0, 20, 20))
        return contours
    end

    // An L-shape: its reflex corner at (1, 1) gives parabolic edges.
    private action LShapeContours returns Array<Contour>
        Array<Contour> contours
        Contour c
        c:AddPoint(0, 0)
        c:AddPoint(2, 0)
        c:AddPoint(2, 1)
        c:AddPoint(1, 1)
        c:AddPoint(1, 2)
        c:AddPoint(0, 2)
        c:closed = true
        contours:Add(c)
        return contours
    end

    // Builds the skeletal trapezoidation of a set of contours into st.
    private action BuildFor(SkeletalTrapezoidation st, Array<Contour> contours)
        OutlineEdges edges
        edges:BuildEdges(contours)

        VoronoiDiagram diagram
        diagram:Generate(edges)

        st:Build(contours, edges, diagram)
    end

    // ------------------------------------------------------------ helpers

    private action Near(number a, number b) returns boolean
        return a - b < 0.000001 and b - a < 0.000001
    end

    private action NearTo(number a, number b, number tolerance) returns boolean
        return a - b <= tolerance and b - a <= tolerance
    end

    // The node with the biggest radius (-1 if there are none). The outline is sampled, so a square's centre is
    // found this way rather than by its exact coordinates.
    private action WidestNode(SkeletalTrapezoidation st) returns integer
        integer best = -1
        integer v = 0
        repeat while v < st:xs:GetSize()
            if best < 0 or st:rad:Get(v) > st:rad:Get(best)
                best = v
            end
            v = v + 1
        end
        return best
    end

    // Length of kept edge e, in mm.
    private action SegmentLength(SkeletalTrapezoidation st, integer e) returns number
        integer a = st:cleanStart:Get(e)
        integer b = st:cleanEnd:Get(e)
        number dx = st:xs:Get(b) - st:xs:Get(a)
        number dy = st:ys:Get(b) - st:ys:Get(a)
        return math:SquareRoot(dx * dx + dy * dy)
    end

    // ------------------------------------------------------------ tests

    // One bead count per node, one central flag per node, one per edge.
    action TestArraySizesMatchTheSkeleton()
        SkeletalTrapezoidation st
        BuildFor(st, ReferenceContours())
        CenterMarking cm
        cm:Build(st)

        Check(cm:beadCount:GetSize() = st:xs:GetSize(), "one bead count per node")
        Check(cm:nodeCentral:GetSize() = st:xs:GetSize(), "one central flag per node")
        Check(cm:edgeCentral:GetSize() = st:cleanStart:GetSize(), "one central flag per edge")
    end

    // Bead count is 2 * R / w*, with w* = 0.4 mm, at every node that has a radius.
    action TestBeadCountIsDiameterInWidths()
        SkeletalTrapezoidation st
        BuildFor(st, ReferenceContours())
        CenterMarking cm
        cm:Build(st)

        boolean ok = true
        integer v = 0
        repeat while v < st:xs:GetSize()
            if st:rad:Get(v) >= 0.0 and not Near(cm:beadCount:Get(v), 2.0 * st:rad:Get(v) / 0.4)
                ok = false
            end
            v = v + 1
        end
        Check(ok, "every node's bead count is 2 * radius / 0.4")
    end

    // A sampled diagram keeps only the vertices its edges use, so every node has a radius and a bead count
    // (0 for an outline foot).
    action TestEveryNodeHasABeadCount()
        SkeletalTrapezoidation st
        BuildFor(st, ReferenceContours())
        CenterMarking cm
        cm:Build(st)

        boolean ok = true
        integer v = 0
        repeat while v < st:xs:GetSize()
            if cm:beadCount:Get(v) < 0.0
                ok = false
            end
            v = v + 1
        end
        Check(ok, "every node has a bead count")
    end

    // No outline foot is ever marked central. Feet have radius 0, and an unset node has -1.
    action TestFeetAreNeverCentral()
        SkeletalTrapezoidation st
        BuildFor(st, ReferenceContours())
        CenterMarking cm
        cm:Build(st)

        boolean ok = true
        integer v = 0
        repeat while v < st:xs:GetSize()
            if cm:nodeCentral:Get(v) = 1 and st:rad:Get(v) <= 0.0
                ok = false
            end
            v = v + 1
        end
        Check(ok, "no outline foot or unset node is marked central")
    end

    // The centre of a square is a local maximum of the radius, so it must be central.
    action TestCentreOfSquareIsCentral()
        SkeletalTrapezoidation st
        BuildFor(st, BigSquareContours())
        CenterMarking cm
        cm:Build(st)

        integer v = WidestNode(st)
        Check(v >= 0 and NearTo(st:xs:Get(v), 10.0, 0.01) and NearTo(st:ys:Get(v), 10.0, 0.01), "the square's widest node is at its centre")

        boolean central = false
        if v >= 0
            central = cm:nodeCentral:Get(v) = 1
        end
        Check(central, "the centre of the square is central")
    end

    // Marking an edge marks its interior ends, so a central edge never has an unmarked interior end.
    action TestCentralEdgesHaveCentralInteriorEnds()
        SkeletalTrapezoidation st
        BuildFor(st, ReferenceContours())
        CenterMarking cm
        cm:Build(st)

        boolean ok = true
        integer e = 0
        repeat while e < st:cleanStart:GetSize()
            if cm:edgeCentral:Get(e) = 1
                integer a = st:cleanStart:Get(e)
                integer b = st:cleanEnd:Get(e)
                if st:rad:Get(a) > 0.0 and cm:nodeCentral:Get(a) = 0
                    ok = false
                end
                if st:rad:Get(b) > 0.0 and cm:nodeCentral:Get(b) = 0
                    ok = false
                end
            end
            e = e + 1
        end
        Check(ok, "every central edge has its interior ends central")
    end

    // After filtering, an unmarked edge that joins two central nodes must be at least
    // filterDistance long. Edges between nodes of equal radius are skipped, since the
    // uphill walk cannot start across them.
    action TestShortGapsBetweenCentralNodesAreFilled()
        SkeletalTrapezoidation st
        BuildFor(st, LShapeContours())
        CenterMarking cm
        cm:Build(st)

        boolean ok = true
        integer e = 0
        repeat while e < st:cleanStart:GetSize()
            integer a = st:cleanStart:Get(e)
            integer b = st:cleanEnd:Get(e)
            if cm:edgeCentral:Get(e) = 0
                if cm:nodeCentral:Get(a) = 1 and cm:nodeCentral:Get(b) = 1
                    if st:rad:Get(a) not= st:rad:Get(b)
                        if SegmentLength(st, e) < cm:filterDistance
                            ok = false
                        end
                    end
                end
            end
            e = e + 1
        end
        Check(ok, "no short unmarked edge joins two central nodes")
    end

    // The spine of a thin wedge (the skeleton between its two long sides, segments 0 and 2) is significant: its
    // radius slope is sin 15 degrees, about 0.259, below the threshold. Every spine edge reaching past r = 0.2 (the
    // sampled spine is one long edge from near the apex), and its ends inside the part, must be central. (Where the spine meets the wide end's branches, x = 10 / (1 + sin 15) = 7.94,
    // the sampled skeleton has a few short branch edges; those are not spine and are not checked.)
    action TestWedgeSpineIsCentral()
        SkeletalTrapezoidation st
        BuildFor(st, WedgeContours())
        CenterMarking cm
        cm:Build(st)

        integer spineEdges = 0
        boolean allCentral = true
        integer e = 0
        repeat while e < st:cleanStart:GetSize()
            integer c0 = st:cleanCell0:Get(e)
            integer c1 = st:cleanCell1:Get(e)
            integer a = st:cleanStart:Get(e)
            integer b = st:cleanEnd:Get(e)
            boolean spine = (c0 = 0 and c1 = 2) or (c0 = 2 and c1 = 0)
            if spine and (st:rad:Get(a) > 0.2 or st:rad:Get(b) > 0.2)
                spineEdges = spineEdges + 1
                if cm:edgeCentral:Get(e) not= 1
                    allCentral = false
                end
                if (st:rad:Get(a) > 0.0 and cm:nodeCentral:Get(a) not= 1) or (st:rad:Get(b) > 0.0 and cm:nodeCentral:Get(b) not= 1)
                    allCentral = false
                end
            end
            e = e + 1
        end
        Check(spineEdges > 0, "the wedge has spine edges reaching past r = 0.2")
        Check(allCentral, "every spine edge of the wedge, and its ends, is central")
    end

    private action WedgeContours returns Array<Contour>
        Array<Contour> contours
        Contour c
        c:AddPoint(0, 0)
        c:AddPoint(10, -2.67949)
        c:AddPoint(10, 2.67949)
        c:closed = true
        contours:Add(c)
        return contours
    end

    // Under the significance rule, an edge whose ends have equal radius has slope 0 and is always
    // marked. So the gap filter never meets a flat stretch it would have to cross.
    action TestEqualRadiusEdgesAreMarked()
        SkeletalTrapezoidation st
        BuildFor(st, ReferenceContours())
        CenterMarking cm
        cm:Build(st)

        boolean ok = true
        integer e = 0
        repeat while e < st:cleanStart:GetSize()
            integer a = st:cleanStart:Get(e)
            integer b = st:cleanEnd:Get(e)
            if st:rad:Get(a) > 0.0 and st:rad:Get(a) = st:rad:Get(b)
                if cm:edgeCentral:Get(e) = 0
                    ok = false
                end
            end
            e = e + 1
        end
        Check(ok, "every interior edge with equal end radii is marked")
    end

    // The significance rule by itself: a flat spine and a sharp wedge spine are significant,
    // a steep ridge is not. This does not depend on the local-maximum or gap-filter rules.
    action TestSignificanceRuleDirection()
        CenterMarking cm

        Check(cm:IsSignificant(0.0), "a flat spine (slope 0) is significant")
        Check(cm:IsSignificant(0.259), "a sharp wedge spine (slope 0.259) is significant")
        Check(not cm:IsSignificant(0.5), "a steep ridge (slope 0.5) is not significant")
    end

    private action MarkingIsSymmetric(Array<Contour> contours) returns boolean
        SkeletalTrapezoidation st
        BuildFor(st, contours)
        CenterMarking cm
        cm:Build(st)
        integer e = 0
        repeat while e < st:cleanStart:GetSize()
            integer t = st:cleanOpposite:Get(e)
            if t >= 0 and cm:edgeCentral:Get(e) not= cm:edgeCentral:Get(t)
                return false
            end
            e = e + 1
        end
        return true
    end

    action TestMarkingIsSymmetric()
        Check(MarkingIsSymmetric(WedgeContours()), "the wedge's edges and their twins are marked alike")
        Check(MarkingIsSymmetric(LShapeContours()), "the L's edges and their twins are marked alike")
        Check(MarkingIsSymmetric(ReferenceContours()), "the holed square's edges and their twins are marked alike")
    end
end