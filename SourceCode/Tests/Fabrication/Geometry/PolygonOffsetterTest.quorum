package Tests.Fabrication.Geometry

use Libraries.Containers.Array
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Geometry.PolygonOffsetter
use Tests.LampreyTest
use Tests.TestModels
use Libraries.Fabrication.Geometry.GeometryUtilities

/*
Tests Libraries.Fabrication.Geometry.PolygonOffsetter. Convex corners are
mitred (stay sharp); corners turning away from the material are rounded in
16 degree steps, which is why the hole below grows by a little less than a
quarter circle at each corner (0.776 mm^2 instead of 0.785 for d = 1).
OffsetRounded rounds the convex corners of an outset too. Where moved edges
fold over a small step in the outline, the fold must not survive as a spur.
*/
class PolygonOffsetterTest is LampreyTest
    PolygonOffsetter offsetter
    TestModels models
    GeometryUtilities util

    on create
        SetName("PolygonOffsetter")
    end

    action Run
        InsetSquare()
        OutsetSquare()
        InsetRing()
        TooFarAndZero()
        RoundedOutset()
        NoSpurAtAStep()
    end

    action RoundedOutset
        Case("rounded outset of a square")
        Array<Contour> grown = offsetter:OffsetRounded(models:ListOf(models:Square(0, 0, 20, 0)), -2)
        ExpectInteger(grown:GetSize(), 1, "one loop")
        // 400 + 4 sides of 20 x 2, + four quarter circles of radius 2 drawn in 16 degree steps
        ExpectNumber(models:NetArea(grown), 572.4147, 0.001, "24 x 24 mm with 2 mm round corners")
        Array<Contour> shrunk = offsetter:OffsetRounded(models:ListOf(models:Square(0, 0, 20, 0)), 2)
        ExpectNumber(models:NetArea(shrunk), 256, 0.0001, "an inset's convex corners stay sharp either way")
    end

    action NoSpurAtAStep
        Case("an inset across a small step has no spur")
        // a 20 mm square whose top steps down by 0.3 mm halfway along: moved by 2 mm,
        // the edges beside the step fold over it
        Contour stepped
        stepped:AddPoint(0, 0)
        stepped:AddPoint(20, 0)
        stepped:AddPoint(20, 20)
        stepped:AddPoint(10.3, 20)
        stepped:AddPoint(10.3, 19.7)
        stepped:AddPoint(0, 19.7)
        stepped:closed = true
        Array<Contour> inset = offsetter:Offset(models:ListOf(stepped), 2)
        ExpectInteger(inset:GetSize(), 1, "one loop")
        // the exact inset is 253.34 mm^2 (the step's corner rounded); with a spur it was 253.81
        ExpectNumber(models:NetArea(inset), 253.3068, 0.01, "the area of an inset without the fold")
        if inset:GetSize() = 1
            Contour loop = inset:Get(0)
            number nearest = 100.0
            integer i = 0
            repeat while i < loop:GetSize()
                integer j = 0
                repeat while j < stepped:GetSize()
                    integer k = j + 1
                    if k = stepped:GetSize()
                        k = 0
                    end
                    number gap = util:SegmentDistance2(loop:xs:Get(i), loop:ys:Get(i), stepped:xs:Get(j), stepped:ys:Get(j), stepped:xs:Get(k), stepped:ys:Get(k))
                    if gap < nearest
                        nearest = gap
                    end
                    j = j + 1
                end
                i = i + 1
            end
            // 2 mm, less up to 0.02 where a 16 degree arc step cuts inside the true circle;
            // the spur came within 1.8 mm
            ExpectTrue(nearest >= 1.95 * 1.95, "every point of the inset is about 2 mm from the outline")
        end
    end

    action InsetSquare
        Case("inset of a square")
        Array<Contour> inset = offsetter:Offset(models:ListOf(models:Square(0, 0, 20, 3)), 2)
        ExpectInteger(inset:GetSize(), 1, "one loop")
        ExpectNumber(models:NetArea(inset), 256, 0.0001, "16 x 16 mm")
        Contour loop = inset:Get(0)
        ExpectInteger(loop:planeIndex, 3, "on the input's plane")
        ExpectTrue(loop:ContainsPoint(10, 10) and not loop:ContainsPoint(1, 1), "inside the original, 2 mm in")
    end

    action OutsetSquare
        Case("outset of a square")
        Array<Contour> outset = offsetter:Offset(models:ListOf(models:Square(0, 0, 20, 0)), -2)
        ExpectInteger(outset:GetSize(), 1, "one loop")
        ExpectNumber(models:NetArea(outset), 576, 0.0001, "24 x 24 mm with mitred corners")
    end

    action InsetRing
        Case("inset of a square ring")
        Array<Contour> ring
        ring:Add(models:Square(0, 0, 20, 0))
        ring:Add(models:HoleSquare(5, 5, 10, 0))
        Array<Contour> inset = offsetter:Offset(ring, 1)
        ExpectInteger(inset:GetSize(), 2, "an outline and a hole")
        // 18 x 18 outside, minus a 10 mm hole grown by 1 mm with rounded corners
        ExpectNumber(models:NetArea(inset), 324 - 143.10368, 0.01, "net area")
    end

    action TooFarAndZero
        Case("insets that close up, and distance 0")
        // past the middle the mitred corners fold over into a small inverted
        // square; PathGenerator throws such loops away (see PathGeneratorTest)
        Array<Contour> gone = offsetter:Offset(models:ListOf(models:Square(0, 0, 20, 0)), 10)
        ExpectNumber(models:NetArea(gone), 0, 0.0001, "an inset to the middle leaves nothing")
        Array<Contour> same = offsetter:Offset(models:ListOf(models:Square(0, 0, 20, 0)), 0)
        ExpectNumber(models:NetArea(same), 400, 0.0001, "distance 0 copies the loop")
        Array<Contour> nothing
        Array<Contour> empty = offsetter:Offset(nothing, 1)
        ExpectInteger(empty:GetSize(), 0, "no loops in, no loops out")
    end
end
