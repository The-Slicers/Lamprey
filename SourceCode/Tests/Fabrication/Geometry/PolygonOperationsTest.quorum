package Tests.Fabrication.Geometry

use Libraries.Containers.Array
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Geometry.PolygonOperations
use Tests.LampreyTest
use Tests.TestModels
use Libraries.Data.Containers.IntegerBuffer

/*
Tests Libraries.Fabrication.Geometry.PolygonOperations with shapes whose
answers are known exactly: two 10 mm squares overlapping by 5 x 5 mm.
*/
class PolygonOperationsTest is LampreyTest
    PolygonOperations ops
    TestModels models

    on create
        SetName("PolygonOperations")
    end

    action Run
        Overlapping()
        Disjoint()
        Holes()
        Contained()
        Crossings()
        FaceWindings()
        ClipToBox()
    end

    /*
    ClipToBox keeps what lies inside the box, the right way round, and
    subtracting the clipped loops from a shape inside the box gives what
    subtracting all of them does (how TreeSupport cuts branches out of the
    model's clearance).
    */
    action ClipToBox
        Case("clipping loops to a box")
        Array<Contour> square = models:ListOf(models:Square(0, 0, 20, 0))
        Array<Contour> corner = ops:ClipToBox(square, 15, 15, 30, 30)
        ExpectInteger(corner:GetSize(), 1, "a corner of the square")
        ExpectNumber(models:NetArea(corner), 25, 0.000001, "its 5 x 5 corner")
        ExpectNumber(models:NetArea(ops:ClipToBox(square, 5, 5, 8, 9)), 12, 0.000001, "a box inside the square comes back whole")
        ExpectInteger(ops:ClipToBox(square, 25, 25, 30, 30):GetSize(), 0, "a box beside the square: nothing")

        Array<Contour> ring
        ring:Add(models:Square(0, 0, 30, 0))
        ring:Add(models:HoleSquare(10, 10, 10, 0))
        Array<Contour> clipped = ops:ClipToBox(ring, 5, 5, 15, 15)
        ExpectInteger(clipped:GetSize(), 2, "the ring's outline and its hole")
        ExpectNumber(models:NetArea(clipped), 75, 0.000001, "the hole stays a hole: 100 - 25")

        // a square over the hole's corner, minus the ring: the part over the hole
        Array<Contour> patch = models:ListOf(models:Square(8, 8, 4, 0))
        Array<Contour> byAll = ops:Difference(patch, ring, 0)
        Array<Contour> byClipped = ops:Difference(patch, ops:ClipToBox(ring, 7.99, 7.99, 12.01, 12.01), 0)
        ExpectNumber(models:NetArea(byAll), 4, 0.000001, "subtracting the whole ring")
        ExpectNumber(models:NetArea(byClipped), 4, 0.000001, "subtracting the ring clipped to the square's box")
    end

    /*
    Windings come from the faces the pieces cut the plane into, started once
    per connected group of pieces. These shapes check the cases that needs
    to get right: overlaps, a shared edge, a hole, an island inside a hole
    (a separate group, with its own starting winding), a square across a
    hole's edge, and a loop that crosses itself.
    */
    action FaceWindings
        Case("face windings give the exact shapes")
        Array<Contour> square = models:ListOf(models:Square(0, 0, 10, 0))
        Array<Contour> moved = models:ListOf(models:Square(5, 5, 10, 0))
        Array<Contour> beside = models:ListOf(models:Square(10, 0, 10, 0))
        Expect("overlapping union", ops:Union(square, moved, 0), 1, 175)
        Expect("overlapping intersection", ops:Intersect(square, moved, 0), 1, 25)
        Expect("overlapping difference", ops:Difference(square, moved, 0), 1, 75)
        Expect("union along a shared edge", ops:Union(square, beside, 0), 1, 200)

        Array<Contour> ring
        ring:Add(models:Square(0, 0, 30, 0))
        ring:Add(models:HoleSquare(10, 10, 10, 0))
        Array<Contour> island = models:ListOf(models:Square(13, 13, 4, 0))
        Expect("an island inside a hole", ops:Union(ring, island, 0), 3, 900 - 100 + 16)
        Expect("a square across the hole's edge", ops:Union(ring, models:ListOf(models:Square(15, 15, 10, 0)), 0), 2, 825)

        // (0,0) (10,10) (10,0) (0,10): a left lobe wound +1 and a right lobe wound -1
        Contour bowtie
        bowtie:AddPoint(0, 0)
        bowtie:AddPoint(10, 10)
        bowtie:AddPoint(10, 0)
        bowtie:AddPoint(0, 10)
        bowtie:closed = true
        Array<Contour> nothing
        Expect("a loop that crosses itself keeps its positive lobe", ops:Union(models:ListOf(bowtie), nothing, 0), 1, 25)
    end

    action Expect(text what, Array<Contour> loops, integer count, number area)
        ExpectInteger(loops:GetSize(), count, what + ": " + count + " loops")
        ExpectNumber(models:NetArea(loops), area, 0.000001, what + ": " + area + " mm2")
    end

    action Crossings
        Case("finding loops that cross")
        IntegerBuffer first
        IntegerBuffer second
        Array<Contour> overlapping
        overlapping:Add(models:Square(0, 0, 10, 0))
        overlapping:Add(models:Square(5, 5, 10, 0))
        ops:FindCrossings(overlapping, first, second)
        ExpectInteger(first:GetSize(), 2, "overlapping squares' outlines cross twice")
        if first:GetSize() > 0
            ExpectTrue(first:Get(0) not= second:Get(0), "the crossing is between the two squares")
        end

        Array<Contour> sharingEdge
        sharingEdge:Add(models:Square(0, 0, 10, 0))
        sharingEdge:Add(models:Square(10, 0, 10, 0))
        ops:FindCrossings(sharingEdge, first, second)
        ExpectInteger(first:GetSize(), 0, "squares that share an edge only touch")

        Array<Contour> sharingCorner
        sharingCorner:Add(models:Square(0, 0, 10, 0))
        sharingCorner:Add(models:Square(10, 10, 10, 0))
        ops:FindCrossings(sharingCorner, first, second)
        ExpectInteger(first:GetSize(), 0, "squares that share a corner only touch")

        Array<Contour> ring
        ring:Add(models:Square(0, 0, 20, 0))
        ring:Add(models:HoleSquare(5, 5, 5, 0))
        ops:FindCrossings(ring, first, second)
        ExpectInteger(first:GetSize(), 0, "a hole inside an outline doesn't cross it")

        Contour bowTie
        bowTie:AddPoint(0, 0)
        bowTie:AddPoint(10, 10)
        bowTie:AddPoint(10, 0)
        bowTie:AddPoint(0, 10)
        bowTie:closed = true
        ops:FindCrossings(models:ListOf(bowTie), first, second)
        ExpectInteger(first:GetSize(), 1, "a bow tie crosses itself once")
        if first:GetSize() > 0
            ExpectTrue(first:Get(0) = 0 and second:Get(0) = 0, "the crossing is reported as loop 0 with itself")
        end

        // FindCrossings leaves nothing behind for the next operation
        Array<Contour> union = ops:Union(models:ListOf(models:Square(0, 0, 10, 0)), models:ListOf(models:Square(5, 5, 10, 0)), 0)
        ExpectNumber(models:NetArea(union), 175, 0.0001, "a union afterwards is unaffected")
    end

    action Overlapping
        Case("overlapping squares")
        Array<Contour> a = models:ListOf(models:Square(0, 0, 10, 2))
        Array<Contour> b = models:ListOf(models:Square(5, 5, 10, 2))
        Array<Contour> union = ops:Union(a, b, 2)
        ExpectInteger(union:GetSize(), 1, "the union is one loop")
        ExpectNumber(models:NetArea(union), 175, 0.0001, "union area 100 + 100 - 25")
        Array<Contour> both = ops:Intersect(a, b, 2)
        ExpectNumber(models:NetArea(both), 25, 0.0001, "intersection area")
        Array<Contour> onlyA = ops:Difference(a, b, 2)
        ExpectNumber(models:NetArea(onlyA), 75, 0.0001, "difference area")
        Contour loop = union:Get(0)
        ExpectInteger(loop:planeIndex, 2, "results are on the requested plane")
        ExpectTrue(loop:closed and not loop:isHole, "an outer loop")
        ExpectTrue(loop:SignedArea2() > 0, "outer loops run counter-clockwise")
        ExpectInteger(ops:GetBrokenChains(), 0, "no broken chains")
    end

    action Disjoint
        Case("squares that don't touch")
        Array<Contour> a = models:ListOf(models:Square(0, 0, 10, 0))
        Array<Contour> b = models:ListOf(models:Square(20, 0, 10, 0))
        Array<Contour> union = ops:Union(a, b, 0)
        ExpectInteger(union:GetSize(), 2, "two loops")
        ExpectNumber(models:NetArea(union), 200, 0.0001, "both areas")
        Array<Contour> both = ops:Intersect(a, b, 0)
        ExpectInteger(both:GetSize(), 0, "nothing in common")
        Array<Contour> onlyA = ops:Difference(a, b, 0)
        ExpectNumber(models:NetArea(onlyA), 100, 0.0001, "subtracting something far away changes nothing")
    end

    action Holes
        Case("cutting a hole")
        Array<Contour> outer = models:ListOf(models:Square(0, 0, 20, 0))
        Array<Contour> inner = models:ListOf(models:Square(5, 5, 10, 0))
        Array<Contour> ring = ops:Difference(outer, inner, 0)
        ExpectInteger(ring:GetSize(), 2, "an outline and a hole")
        ExpectNumber(models:NetArea(ring), 300, 0.0001, "400 - 100")
        integer holes = 0
        integer i = 0
        repeat while i < ring:GetSize()
            Contour loop = ring:Get(i)
            if loop:isHole
                holes = holes + 1
                ExpectTrue(loop:SignedArea2() < 0, "holes run clockwise")
            end
            i = i + 1
        end
        ExpectInteger(holes, 1, "one loop is marked as a hole")

        // filling the hole back in gives the whole square
        Array<Contour> whole = ops:Union(ring, inner, 0)
        ExpectNumber(models:NetArea(whole), 400, 0.0001, "ring + plug")
    end

    action Contained
        Case("one square inside another")
        Array<Contour> outer = models:ListOf(models:Square(0, 0, 20, 0))
        Array<Contour> inner = models:ListOf(models:Square(5, 5, 10, 0))
        ExpectNumber(models:NetArea(ops:Union(outer, inner, 0)), 400, 0.0001, "the union is the big square")
        ExpectNumber(models:NetArea(ops:Intersect(outer, inner, 0)), 100, 0.0001, "the intersection is the small one")
        Array<Contour> smallMinusBig = ops:Difference(inner, outer, 0)
        ExpectInteger(smallMinusBig:GetSize(), 0, "small minus big is empty")
        Array<Contour> nothing
        Array<Contour> unionOfNothing = ops:Union(nothing, nothing, 0)
        ExpectInteger(unionOfNothing:GetSize(), 0, "the union of nothing")
    end
end
