package Tests.Fabrication.Printing

use Libraries.Containers.Array
use Libraries.Language.Errors.InvalidArgumentError
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Slicing.PathGenerator
use Libraries.Fabrication.Slicing.PathOrderer
use Libraries.Fabrication.Printing.GcodeWriter
use Tests.LampreyTest
use Tests.TestModels
use Tests.TestFiles
use Tests.GcodeReader

/*
Tests Libraries.Fabrication.Printing.GcodeWriter by writing a 20 mm cube
and reading the file back the way a printer would.
*/
class GcodeWriterTest is LampreyTest
    TestModels models
    TestFiles files
    Array<Contour> ordered
    text startPath = ""
    text endPath = ""
    text lf = ""

    on create
        SetName("GcodeWriter")
        lf = lf:GetLineFeed()
    end

    action Run
        Array<Contour> outlines = models:Outlines(models:Cube(), 0.2)
        integer planes = models:GetLastPlaneCount()
        PathGenerator paths
        paths:Generate(outlines, planes)
        PathOrderer orderer
        ordered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)
        startPath = files:Write("gcode/start.gcode", "; test start" + lf + "M190 S{BED_TEMP}" + lf + "M109 S{NOZZLE_TEMP}" + lf + "; bed {BED_X} x {BED_Y}")
        endPath = files:Write("gcode/end.gcode", "; test end" + lf + "M104 S0")

        WritesAPrintableFile()
        ExtrudesTheRightAmount()
        DryRun()
        BambuExtras()
        TemplatesAndPlaceholders()
        BambuA1Placeholders()
        TopSurfaceAndIroning()
        OverhangSlowdown()
        SeamGapAndWipe()
        RejectsBadSettings()
    end

    action Writer returns GcodeWriter
        GcodeWriter gcode
        gcode:SetLayerHeight(0.2)
        gcode:SetLineWidth(0.4)
        gcode:SetFilamentDiameter(1.75)
        gcode:SetTemperatures(210, 60)
        gcode:SetBed(220, 220)
        gcode:SetStartGCodeFile(startPath)
        gcode:SetEndGCodeFile(endPath)
        return gcode
    end

    action WritesAPrintableFile
        Case("a printable file")
        GcodeWriter gcode = Writer()
        text path = files:Path("gcode/cube.gcode")
        gcode:Write(ordered, path)
        Array<text> warnings = gcode:GetWarnings()
        ExpectInteger(warnings:GetSize(), 0, "no warnings")
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectTrue(gcodeText:StartsWith(";Generated by the Lamprey slicer"), "the header comes first")
        ExpectContains(gcodeText, "M190 S60" + lf + "M109 S210", "the start G-code with its placeholders filled in")
        ExpectContains(gcodeText, "; bed 220.0 x 220.0", "the bed size placeholders")
        ExpectContains(gcodeText, "; test end" + lf + "M104 S0", "the end G-code")
        ExpectContains(gcodeText, "M83", "relative extrusion")
        ExpectInteger(reader:GetLayerCount(), 100, ";LAYER: comments")
        ExpectNumber(reader:GetLayerZ(0), 0.2, 0.0001, "layer 0 is printed at Z 0.2")
        ExpectNumber(reader:GetLayerZ(1), 0.4, 0.0001, "layer 1 at Z 0.4")
        ExpectNumber(reader:GetLayerZ(99), 20.0, 0.0001, "the last layer at Z 20")
        ExpectInteger(reader:GetBadNumberCount(), 0, "every number is plain decimal text (first bad line: " + reader:GetFirstBadLine() + ")")
        ExpectTrue(reader:GetRetractCount() > 0, "travels retract")
        ExpectContains(gcodeText, "M106 S", "the fan comes on")
        ExpectContains(gcodeText, ";TYPE:WALL-OUTER", "feature comments")
        // a 20 mm cube centred on a 220 mm bed: 100 to 120 mm on both axes
        ExpectNumber(reader:GetMinX(), 100, 0.5, "left edge of the print")
        ExpectNumber(reader:GetMaxX(), 120, 0.5, "right edge of the print")
        ExpectNumber(reader:GetMinY(), 100, 0.5, "front edge of the print")
        ExpectNumber(reader:GetMaxY(), 120, 0.5, "back edge of the print")
        ExpectNumber(gcode:GetFilamentLength(), reader:GetExtruded(), gcode:GetFilamentLength() * 0.001, "GetFilamentLength matches the file")
        ExpectTrue(gcode:GetMoveSeconds() > 60, "the time estimate is filled in")
    end

    action ExtrudesTheRightAmount
        Case("extrusion per millimetre")
        GcodeWriter gcode = Writer()
        text path = files:Path("gcode/cube-ratio.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        // lineWidth * layerHeight / filament area = 0.4 * 0.2 / (pi * 0.875^2)
        number expected = 0.08 / (3.141592653589793 * 0.875 * 0.875)
        ExpectNumber(reader:GetMinRatio(), expected, expected * 0.02, "least filament per mm")
        ExpectNumber(reader:GetMaxRatio(), expected, expected * 0.02, "most filament per mm")
        // a 20 mm cube is 8000 mm^3; walls, skin and 20% infill use well under all of it
        number volume = gcode:GetFilamentLength() * 3.141592653589793 * 0.875 * 0.875
        ExpectTrue(volume > 1500 and volume < 8000, "the plastic used is plausible for a 20 mm cube (" + volume + " mm^3)")
    end

    action DryRun
        Case("dry run")
        GcodeWriter gcode = Writer()
        gcode:SetDryRun(true, 20)
        text path = files:Path("gcode/cube-dry.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectInteger(reader:GetPrintMoveCount(), 0, "no move extrudes")
        ExpectInteger(reader:GetRetractCount(), 0, "nothing retracts")
        ExpectNumber(reader:GetLayerZ(0), 20.2, 0.0001, "the first layer is traced 20 mm up")
        ExpectContains(gcodeText, "M104 S0", "the nozzle heater is off")
        ExpectNotContains(gcodeText, "M109", "it never waits for heat")
    end

    action BambuExtras
        Case("Bambu extras")
        GcodeWriter gcode = Writer()
        gcode:SetBambuExtras(true)
        text path = files:Path("gcode/cube-bambu.gcode")
        gcode:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectTrue(gcodeText:StartsWith("; HEADER_BLOCK_START"), "the header block comes first")
        ExpectContains(gcodeText, "; total layer number: 100", "the layer count")
        ExpectContains(gcodeText, "M73 P0 R", "progress starts at 0%")
        ExpectContains(gcodeText, "M991 S0 P99", "the last layer change is reported")
        ExpectContains(gcodeText, "; EXECUTABLE_BLOCK_END", "the block is closed")
        // Bambu Studio's feature names, for its G-code preview
        ExpectContains(gcodeText, "; FEATURE: Outer wall", "outer walls named for Bambu Studio")
        ExpectContains(gcodeText, "; FEATURE: Inner wall", "inner walls")
        ExpectContains(gcodeText, "; FEATURE: Sparse infill", "sparse infill")
        ExpectContains(gcodeText, "; FEATURE: Internal solid infill", "solid infill")
        ExpectContains(gcodeText, "; FEATURE: Bottom surface", "the first layer's solid fill is the bottom surface")
        ExpectNotContains(gcodeText, "; FEATURE: Outer wall" + lf + "; FEATURE: ", "no empty features")

        GcodeWriter plainWriter = Writer()
        text plainPath = files:Path("gcode/cube-not-bambu.gcode")
        plainWriter:Write(ordered, plainPath)
        GcodeReader plainReader
        plainReader:Read(plainPath)
        text plainText = plainReader:GetText()
        ExpectNotContains(plainText, "; FEATURE: ", "only Bambu output gets Bambu Studio's names")
    end

    action TemplatesAndPlaceholders
        Case("missing templates and unknown placeholders")
        files:Delete("gcode/created-start.gcode")
        GcodeWriter created = Writer()
        created:SetStartGCodeFile(files:Path("gcode/created-start.gcode"))
        created:Write(ordered, files:Path("gcode/cube-created.gcode"))
        ExpectTrue(files:Exists("gcode/created-start.gcode"), "a missing start file is created from the template")
        Array<text> createdWarnings = created:GetWarnings()
        ExpectInteger(createdWarnings:GetSize(), 1, "and the user is told")

        text oddStart = files:Write("gcode/odd-start.gcode", "M109 S{NOT_A_PLACEHOLDER}")
        GcodeWriter odd = Writer()
        odd:SetStartGCodeFile(oddStart)
        odd:Write(ordered, files:Path("gcode/cube-odd.gcode"))
        Array<text> oddWarnings = odd:GetWarnings()
        ExpectInteger(oddWarnings:GetSize(), 1, "an unknown placeholder is warned about")
        if oddWarnings:GetSize() = 1
            ExpectContains(oddWarnings:Get(0), "NOT_A_PLACEHOLDER", "the warning quotes the line")
        end

        Array<Contour> nothing
        GcodeWriter empty = Writer()
        empty:Write(nothing, files:Path("gcode/empty.gcode"))
        Array<text> emptyWarnings = empty:GetWarnings()
        ExpectInteger(emptyWarnings:GetSize(), 1, "writing no paths is warned about")
    end

    action BambuA1Placeholders
        Case("the Bambu A1 placeholders")
        text a1Start = files:Write("gcode/a1-start.gcode", "M1002 set_filament_type:{FILAMENT_TYPE}" + lf
            + "M109 S{NOZZLE_TEMP_LESS_50}" + lf
            + "G0 X128 E8 F{LINE_FEED}" + lf
            + "G0 X133 E.3742 F{PRIME_FEED_SLOW}" + lf
            + "G0 X138 E.3742 F{PRIME_FEED}" + lf
            + "G1 E10 F{CALI_FEED}" + lf
            + "M983 F{CALI_FLOW} A0.3 H{NOZZLE_DIAMETER}")
        text a1End = files:Write("gcode/a1-end.gcode", "G1 X0 Y{FIRST_CENTER_Y} F18000" + lf
            + "; first layer centre x {FIRST_CENTER_X} mm" + lf
            + "G1 Z{PARK_Z_UP} F600" + lf
            + "G1 Z{PARK_Z_UP_BACK}")

        GcodeWriter gcode = Writer()
        gcode:SetFilamentType("petg")
        gcode:SetStartGCodeFile(a1Start)
        gcode:SetEndGCodeFile(a1End)
        text path = files:Path("gcode/cube-a1.gcode")
        gcode:Write(ordered, path)
        Array<text> warnings = gcode:GetWarnings()
        ExpectInteger(warnings:GetSize(), 0, "every A1 placeholder is known")
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectContains(gcodeText, "M1002 set_filament_type:PETG", "{FILAMENT_TYPE}, upper case")
        ExpectContains(gcodeText, "M109 S160", "{NOZZLE_TEMP_LESS_50}: 210 - 50")
        // no SetMaxFlow, so the feeds use the default 12 mm^3/s
        ExpectContains(gcodeText, "G0 X128 E8 F600.00", "{LINE_FEED}: 12 / 1.2 * 60")
        ExpectContains(gcodeText, "G0 X133 E.3742 F1200.00", "{PRIME_FEED_SLOW}: 12 / 0.15 / 4 * 60")
        ExpectContains(gcodeText, "G0 X138 E.3742 F4800.00", "{PRIME_FEED}: 12 / 0.15 * 60")
        ExpectContains(gcodeText, "G1 E10 F300.00", "{CALI_FEED}: 12 / 2.4 * 60")
        ExpectContains(gcodeText, "M983 F5.00 A0.3 H0.40", "{CALI_FLOW} and {NOZZLE_DIAMETER}")
        // the cube sits in the middle of the 220 mm bed
        ExpectNumber(NumberAfter(gcodeText, "G1 X0 Y", " F18000"), 110, 0.5, "{FIRST_CENTER_Y}")
        ExpectNumber(NumberAfter(gcodeText, "; first layer centre x ", " mm"), 110, 0.5, "{FIRST_CENTER_X}")
        // the 20 mm cube's top is at 20 mm: the gantry goes 100 mm above it, then down 2
        ExpectContains(gcodeText, "G1 Z120.00 F600" + lf + "G1 Z118.00", "{PARK_Z_UP} and {PARK_Z_UP_BACK}")

        GcodeWriter capped = Writer()
        capped:SetStartGCodeFile(a1Start)
        capped:SetEndGCodeFile(a1End)
        capped:SetBedHeight(110)
        text cappedPath = files:Path("gcode/cube-a1-capped.gcode")
        capped:Write(ordered, cappedPath)
        GcodeReader cappedReader
        cappedReader:Read(cappedPath)
        text cappedText = cappedReader:GetText()
        ExpectContains(cappedText, "G1 Z110.00 F600" + lf + "G1 Z110.00", "the park stops at the top of the build volume and stays there")
    end

    /* The number between the first 'before' and the next 'after', or -1. */
    action NumberAfter(text haystack, text before, text after) returns number
        integer start = haystack:IndexOf(before)
        if start < 0
            return -1.0
        end
        start = start + before:GetSize()
        integer stop = haystack:IndexOf(after, start)
        if stop < 0
            return -1.0
        end
        text value = haystack:GetSubtext(start, stop)
        return value:ParseNumber()
    end

    action TopSurfaceAndIroning
        Case("top surface and ironing speeds and flow")
        Array<Contour> outlines = models:Outlines(models:Cube(), 0.2)
        integer planes = models:GetLastPlaneCount()
        PathGenerator paths
        paths:SetTopSurfaceLayers(1)
        paths:SetIroning(true, 0.1, 0.2)
        paths:Generate(outlines, planes)
        PathOrderer orderer
        orderer:SetTopSurface(paths:GetTopSurface())
        orderer:SetIroning(paths:GetIroning())
        Array<Contour> topOrdered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)

        GcodeWriter gcode = Writer()
        gcode:SetTopSurface(25, 1.05, 0)
        gcode:SetIroning(12, 0.15, 0.1)
        gcode:SetBambuExtras(true)
        text path = files:Path("gcode/cube-top.gcode")
        gcode:Write(topOrdered, path)
        GcodeReader reader
        reader:Read(path)
        text gcodeText = reader:GetText()
        ExpectContains(gcodeText, " F1500", "the top surface at 25 mm/s")
        ExpectContains(gcodeText, " F720", "ironing at 12 mm/s")
        ExpectContains(gcodeText, "; FEATURE: Top surface", "Bambu Studio sees the top surface")
        ExpectContains(gcodeText, "; FEATURE: Ironing", "and the ironing")
        // a full line: lineWidth * layerHeight / filament area
        number full = 0.08 / (3.141592653589793 * 0.875 * 0.875)
        ExpectNumber(reader:GetMaxRatio(), full * 1.05, full * 0.02, "the top surface gets 5% more plastic")
        // ironing: 15% of a layer spread over lines 0.1 mm apart instead of 0.4
        ExpectNumber(reader:GetMinRatio(), full * 0.15 * 0.1 / 0.4, full * 0.15 * 0.1 / 0.4 * 0.05, "ironing lays a trickle")
    end

    /*
    Two layers of a 10 mm square, the second moved 0.4 mm along x: its
    right side hangs a full line width past the first layer, its left side
    sits a line width inside it.
    */
    action OverhangSlowdown
        Case("overhanging walls slow down")
        Array<Contour> outlines
        outlines:Add(models:Square(0, 0, 10, 0))
        outlines:Add(models:Square(0.4, 0, 10, 1))
        PathGenerator paths
        paths:SetWallCount(2)
        paths:Generate(outlines, 2)
        PathOrderer orderer
        Array<Contour> shifted = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), 2)

        // no minimum layer time: it would stretch both of these tiny layers
        // to the same 10 seconds, slowed or not
        GcodeWriter plain = Writer()
        plain:SetMinLayerTime(0, 10)
        text plainPath = files:Path("gcode/overhang-plain.gcode")
        plain:Write(shifted, plainPath)
        GcodeReader plainReader
        plainReader:Read(plainPath)
        text plainText = plainReader:GetText()
        ExpectNotContains(plainText, " F420", "no slowdown unless asked for")

        GcodeWriter slowed = Writer()
        slowed:SetMinLayerTime(0, 10)
        slowed:SetModelOutlines(outlines, 2)
        slowed:SetOverhangSpeeds(9, 8, 7)
        slowed:SetBambuExtras(true)
        text slowedPath = files:Path("gcode/overhang-slowed.gcode")
        slowed:Write(shifted, slowedPath)
        GcodeReader slowedReader
        slowedReader:Read(slowedPath)
        text slowedText = slowedReader:GetText()
        ExpectContains(slowedText, " F420", "the outer wall over thin air at 7 mm/s")
        ExpectContains(slowedText, "; FEATURE: Overhang wall", "Bambu Studio sees it as overhang wall")
        ExpectTrue(slowed:GetMoveSeconds() > plain:GetMoveSeconds(), "which takes longer")
        // the first layer has nothing below it to overhang, and the inner
        // walls and the left side are supported: not everything is slowed
        integer slowMoves = 0
        Array<text> lines = slowedReader:GetLines()
        integer i = 0
        repeat while i < lines:GetSize()
            text line = lines:Get(i)
            if line:Contains(" F420")
                slowMoves = slowMoves + 1
            end
            i = i + 1
        end
        ExpectTrue(slowMoves >= 1 and slowMoves <= 4, "only the overhanging stretch switches to 7 mm/s (" + slowMoves + " times)")
    end

    action SeamGapAndWipe
        Case("seam gap and wipe")
        GcodeWriter plain = Writer()
        text plainPath = files:Path("gcode/cube-seam-plain.gcode")
        plain:Write(ordered, plainPath)

        GcodeWriter wiped = Writer()
        wiped:SetSeam(0.06, 2)
        wiped:SetRetractionLimit(1000, 1)
        text path = files:Path("gcode/cube-seam-wipe.gcode")
        wiped:Write(ordered, path)
        GcodeReader reader
        reader:Read(path)
        Array<text> lines = reader:GetLines()
        integer wipes = 0
        integer i = 0
        repeat while i < lines:GetSize()
            text line = lines:Get(i)
            if line:StartsWith("G1 X") and line:Contains(" E-")
                wipes = wipes + 1
            end
            i = i + 1
        end
        // one outer wall loop per layer, 100 layers; a wipe is one or more moves
        ExpectTrue(wipes >= 100, "every outer wall loop ends with a retracting wipe (" + wipes + " wipe moves)")
        ExpectTrue(wiped:GetFilamentLength() < plain:GetFilamentLength(), "the seam gap leaves out a little plastic")
        ExpectNumber(reader:GetMinRatio(), FullLineRatio(), FullLineRatio() * 0.02, "the walls themselves are unchanged")
    end

    action FullLineRatio returns number
        return 0.08 / (3.141592653589793 * 0.875 * 0.875)
    end

    action RejectsBadSettings
        Case("bad settings are refused")
        ExpectTrue(Refuses(0, 30), "a layer height of 0")
        ExpectTrue(Refuses(0.2, 0), "a travel speed of 0 (every travel would take forever)")
        ExpectFalse(Refuses(0.2, 150), "sensible values are accepted")
        boolean fan = false
        check
            GcodeWriter gcode
            gcode:SetFan(300, 1, 3)
        detect e is InvalidArgumentError
            fan = true
        end
        ExpectTrue(fan, "a fan speed above 255")
        boolean ironing = false
        check
            GcodeWriter ironer
            ironer:SetIroning(15, 1.5, 0.1)
        detect e2 is InvalidArgumentError
            ironing = true
        end
        ExpectTrue(ironing, "ironing with more than a full layer of plastic")
    end

    action Refuses(number layerHeight, number travelSpeed) returns boolean
        boolean refused = false
        check
            GcodeWriter gcode
            gcode:SetLayerHeight(layerHeight)
            gcode:SetTravelSpeed(travelSpeed)
        detect e is InvalidArgumentError
            refused = true
        end
        return refused
    end
end
