package Tests.Fabrication.Printing

use Libraries.Containers.Array
use Libraries.Data.Compression.ZipReader
use Libraries.Data.Formats.JavaScriptObjectNotationTemplate
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Slicing.PathGenerator
use Libraries.Fabrication.Slicing.PathOrderer
use Libraries.Fabrication.Printing.GcodeWriter
use Libraries.Fabrication.Printing.Bambu.BambuPackager
use Libraries.Fabrication.Printing.Bambu.BambuProjectSettings
use Libraries.Fabrication.Printing.Bambu.BambuSettingsMap
use Libraries.Fabrication.Profiles.ProfileManager
use Libraries.Fabrication.Profiles.Profile
use Tests.LampreyTest
use Tests.TestModels
use Tests.TestFiles

/*
Tests the Bambu Lab printing classes (BambuPackager, BambuProjectSettings,
BambuSettingsMap) with the P2S settings template in Templates/bambu-p2s.
*/
class BambuTest is LampreyTest
    TestModels models
    TestFiles files
    text settingsTemplate = "Templates/bambu-p2s/p2s_project_settings.json"
    text gcodePath = ""
    text lf = ""

    on create
        SetName("Bambu: BambuPackager, BambuProjectSettings, BambuSettingsMap")
        lf = lf:GetLineFeed()
    end

    action Run
        // a cube's G-code with Bambu's header block and a T0 in its start code
        Array<Contour> outlines = models:Outlines(models:Cube(), 0.2)
        integer planes = models:GetLastPlaneCount()
        PathGenerator paths
        paths:Generate(outlines, planes)
        PathOrderer orderer
        Array<Contour> ordered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)
        GcodeWriter gcode
        gcode:SetBambuExtras(true)
        gcode:SetTemperatures(220, 65)
        gcode:SetStartGCodeFile(files:Write("bambu/start.gcode", "M190 S{BED_TEMP}" + lf + "M109 S{NOZZLE_TEMP}" + lf + "T0"))
        gcode:SetEndGCodeFile(files:Write("bambu/end.gcode", "M104 S0"))
        gcodePath = files:Path("bambu/cube.gcode")
        gcode:Write(ordered, gcodePath)

        PackagesACube()
        PackagingProblems()
        ProjectSettings()
        SettingsFromAProfile()
        A1Settings()
    end

    action PackagesACube
        Case("a .gcode.3mf for a cube")
        BambuPackager packer
        packer:SetSettingsTemplate(settingsTemplate)
        packer:SetFilamentColor("#ff0000")
        text archive = packer:Pack(gcodePath)
        ExpectText(archive, files:Path("bambu/cube.gcode.3mf"), "the archive goes next to the G-code")
        Array<text> warnings = packer:GetWarnings()
        ExpectInteger(warnings:GetSize(), 0, "no warnings")
        ExpectInteger(packer:GetLayerCount(), 100, "layers read from the header")
        ExpectTrue(packer:GetFilamentGrams() > 1 and packer:GetFilamentGrams() < 15, "a plausible weight for a 20 mm cube (" + packer:GetFilamentGrams() + " g)")
        ExpectText(packer:GetSettingsVersion(), "02.08.02.61", "the template's Bambu Studio version")

        ZipReader zip
        text entries = "[Content_Types].xml Metadata/plate_1.png Metadata/plate_1_small.png Metadata/plate_no_light_1.png Metadata/top_1.png Metadata/pick_1.png Metadata/plate_1.json 3D/3dmodel.model Metadata/project_settings.config Metadata/plate_1.gcode.md5 Metadata/plate_1.gcode Metadata/_rels/model_settings.config.rels Metadata/model_settings.config Metadata/cut_information.xml Metadata/slice_info.config Metadata/filament_sequence.json _rels/.rels"
        Array<text> names = entries:Split(" ")
        integer i = 0
        repeat while i < names:GetSize()
            ExpectTrue(zip:HasEntry(archive, names:Get(i)), "the archive has " + names:Get(i))
            i = i + 1
        end

        text plateGcode = zip:ReadText(archive, "Metadata/plate_1.gcode")
        ExpectText(zip:ReadText(archive, "Metadata/plate_1.gcode.md5"), files:Md5(plateGcode), "the MD5 matches the G-code inside")
        ExpectContains(plateGcode, "; total filament weight [g] :", "the header block is rewritten with the filament use")

        JavaScriptObjectNotationTemplate settings
        settings:Load(zip:ReadText(archive, "Metadata/project_settings.config"))
        ExpectText(settings:GetText("filament_colour", "?"), "#FF0000", "the colour, upper case")
        ExpectText(settings:GetText("nozzle_temperature", "?"), "220", "the nozzle temperature read from the G-code")
        ExpectText(settings:GetText("textured_plate_temp", "?"), "65", "the bed temperature read from the G-code")
        ExpectText(settings:GetText("curr_bed_type", "?"), "Textured PEI Plate", "the plate")
        text sliceInfo = zip:ReadText(archive, "Metadata/slice_info.config")
        ExpectContains(sliceInfo, "printer_model_id", "slice_info names the printer")
        ExpectContains(sliceInfo, "N7", "the P2S model id")
    end

    action PackagingProblems
        Case("packaging problems")
        BambuPackager noT0
        noT0:SetSettingsTemplate(settingsTemplate)
        text plain = files:Write("bambu/no-t0.gcode", "; HEADER_BLOCK_START" + lf + "; HEADER_BLOCK_END" + lf + "G1 X1 Y1 E1")
        text archive = noT0:Pack(plain)
        Array<text> warnings = noT0:GetWarnings()
        ExpectInteger(warnings:GetSize(), 1, "G-code that never selects T0 is warned about")

        ExpectTrue(PackFails("#FFFFFF", "textured_plate", files:Write("bambu/no-header.gcode", "G1 X1 Y1 E1")), "G-code without Bambu's header block")
        ExpectTrue(PackFails("red", "textured_plate", gcodePath), "a colour that isn't #RRGGBB")
        ExpectTrue(PackFails("#FFFFFF", "glass_plate", gcodePath), "an unknown bed type")
        ExpectTrue(PackFails("#FFFFFF", "textured_plate", files:Path("bambu/missing.gcode")), "a missing G-code file")
    end

    action PackFails(text colour, text bed, text path) returns boolean
        boolean failed = false
        check
            BambuPackager packer
            packer:SetSettingsTemplate(settingsTemplate)
            packer:SetFilamentColor(colour)
            packer:SetBedType(bed)
            text archive = packer:Pack(path, files:Path("bambu/failed.gcode.3mf"))
        detect e
            failed = true
        end
        return failed
    end

    action ProjectSettings
        Case("BambuProjectSettings")
        BambuProjectSettings settings
        settings:LoadFile(settingsTemplate)
        ExpectText(settings:GetText("name", "?"), "project_settings", "the template loads")
        boolean fine = true
        check
            settings:Check()
        detect e1
            fine = false
        end
        ExpectTrue(fine, "the shipped template passes Bambu Studio's checks")

        BambuProjectSettings wrong
        wrong:Load("{ " + Quoted("name") + ": " + Quoted("something_else") + " }")
        boolean refused = false
        check
            wrong:Check()
        detect e2
            refused = true
        end
        ExpectTrue(refused, "a file that isn't project_settings fails Check")

        boolean missing = false
        check
            BambuProjectSettings nowhere
            nowhere:LoadFile(files:Path("bambu/missing.json"))
        detect e3
            missing = true
        end
        ExpectTrue(missing, "a missing template file")
    end

    action SettingsFromAProfile
        Case("BambuSettingsMap from the bambu-p2s profile")
        ProfileManager profiles
        profiles:Load("Profiles/profiles.json")
        Profile profile = profiles:Require("bambu-p2s")
        BambuSettingsMap map
        JavaScriptObjectNotationTemplate filled
        filled:Load(map:FilledTemplate(profile, settingsTemplate))
        ExpectText(filled:GetText("layer_height", "?"), "0.2", "layer_height")
        ExpectText(filled:GetText("wall_loops", "?"), "3", "wall_loops from wallCount")
        ExpectText(filled:GetText("sparse_infill_density", "?"), "15%", "the infill density as a percentage")
        ExpectText(filled:GetText("textured_plate_temp", "?"), "60", "the bed temperature")
        ExpectText(filled:GetText("filament_type", "?"), "PLA", "the filament")
        ExpectText(filled:GetText("brim_type", "?"), "no_brim", "no brim")
        ExpectInteger(filled:Count("printable_area"), 4, "the bed corners")
        ExpectTrue(map:GetFilledCount() > 40, "most of the mapped settings were found in the template")

        profile:SetNumber("nozzleDiameter", 0.6)
        profile:SetNumber("lineWidth", 0.6)
        text json = map:FilledTemplate(profile, settingsTemplate)
        Array<text> warnings = map:GetWarnings()
        boolean nozzleWarned = false
        integer i = 0
        repeat while i < warnings:GetSize()
            text warning = warnings:Get(i)
            if warning:Contains("nozzle")
                nozzleWarned = true
            end
            i = i + 1
        end
        ExpectTrue(nozzleWarned, "a template for another nozzle is warned about")
    end

    action A1Settings
        Case("the A1 settings template and the bambu-a1 profile")
        text a1Template = "Templates/bambu-a1/a1_project_settings.json"
        BambuProjectSettings settings
        settings:LoadFile(a1Template)
        boolean fine = true
        check
            settings:Check()
        detect e1
            fine = false
        end
        ExpectTrue(fine, "the A1 template passes Bambu Studio's checks")
        ExpectText(settings:GetText("printer_model", "?"), "Bambu Lab A1", "it is for the A1")
        ExpectText(settings:GetText("printer_settings_id", "?"), "Bambu Lab A1 0.4 nozzle", "with a 0.4 mm nozzle")
        ExpectText(settings:GetText("printer_structure", "?"), "i3", "a bed slinger")
        ExpectText(settings:GetText("nozzle_type", "?"), "stainless_steel", "the A1's stock nozzle")

        ProfileManager profiles
        profiles:Load("Profiles/profiles.json")
        BambuSettingsMap map
        JavaScriptObjectNotationTemplate filled
        filled:Load(map:FilledTemplate(profiles:Require("bambu-a1"), a1Template))
        Array<text> warnings = map:GetWarnings()
        ExpectInteger(warnings:GetSize(), 0, "the bambu-a1 profile matches its template (nozzle, filament, keys)")
        ExpectText(filled:GetText("wall_loops", "?"), "2", "wall_loops from the A1 profile")
        ExpectText(filled:GetText("textured_plate_temp", "?"), "65", "the A1's PLA bed temperature")
        ExpectText(filled:GetText("nozzle_temperature", "?"), "220", "the A1's PLA nozzle temperature")
        ExpectText(filled:GetText("travel_speed", "?"), "500", "travel at the A1 firmware's cap")
    end

    action Quoted(text value) returns text
        text dq = ""
        dq = dq:GetDoubleQuote()
        return dq + value + dq
    end
end
