package Tests.Fabrication.Slicing

use Libraries.Containers.Array
use Libraries.Compute.Math
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Geometry.PathRole
use Libraries.Fabrication.Slicing.PathGenerator
use Libraries.Fabrication.Slicing.PathOrderer
use Tests.LampreyTest
use Tests.TestModels

/* Tests Libraries.Fabrication.Slicing.PathOrderer: printing order, roles, seams and cleanup. */
class PathOrdererTest is LampreyTest
    TestModels models
    PathRole roles
    Math math

    on create
        SetName("PathOrderer")
    end

    action Run
        CubeOrder()
        SkirtFirst()
        Cleanup()
        TopSurfaceLast()
        SeamOnCorners()
    end

    action CubeOrder
        Case("a sliced cube")
        Array<Contour> outlines = models:Outlines(models:Cube(), 0.2)
        integer planes = models:GetLastPlaneCount()
        PathGenerator paths
        paths:SetWallCount(3)
        paths:Generate(outlines, planes)
        PathOrderer orderer
        orderer:SetSeamPoint(0, 1000000)
        Array<Contour> ordered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)
        ExpectTrue(ordered:GetSize() > 0, "paths come out")

        boolean layersInOrder = true
        boolean rolesSet = true
        integer previous = 0
        integer i = 0
        repeat while i < ordered:GetSize()
            Contour path = ordered:Get(i)
            if path:planeIndex < previous
                layersInOrder = false
            end
            previous = path:planeIndex
            if path:role < 0
                rolesSet = false
            end
            i = i + 1
        end
        ExpectTrue(layersInOrder, "layer by layer, bottom up")
        ExpectTrue(rolesSet, "every path has a role")

        // layer 50: walls from the inside out, then sparse infill
        Array<Contour> layer
        i = 0
        repeat while i < ordered:GetSize()
            Contour candidate = ordered:Get(i)
            if candidate:planeIndex = 50
                layer:Add(candidate)
            end
            i = i + 1
        end
        ExpectTrue(layer:GetSize() > 3, "layer 50 has walls and infill")
        if layer:GetSize() > 3
            Contour first = layer:Get(0)
            Contour second = layer:Get(1)
            Contour third = layer:Get(2)
            ExpectInteger(first:role, roles:INNER_WALL, "the innermost wall first")
            ExpectInteger(first:wallIndex, 2, "the innermost wall is wall 2")
            ExpectInteger(second:wallIndex, 1, "then wall 1")
            ExpectInteger(third:role, roles:OUTER_WALL, "the outer wall third")
            ExpectTrue(third:HeadY() > 19 and third:HeadX() < 1, "the seam is at the back left corner, nearest the seam point")
            boolean restInfill = true
            i = 3
            repeat while i < layer:GetSize()
                Contour rest = layer:Get(i)
                if rest:role not= roles:INFILL
                    restInfill = false
                end
                i = i + 1
            end
            ExpectTrue(restInfill, "the rest of layer 50 is infill")
        end
    end

    action SkirtFirst
        Case("the skirt comes first on its layer")
        Array<Contour> outlines = models:ListOf(models:Square(0, 0, 10, 0))
        Array<Contour> walls = models:ListOf(models:Square(0.2, 0.2, 9.6, 0))
        Array<Contour> none
        PathOrderer orderer
        orderer:SetSkirt(models:ListOf(models:Square(-5, -5, 20, 0)))
        Array<Contour> ordered = orderer:Order(outlines, walls, none, none, 1)
        ExpectInteger(ordered:GetSize(), 2, "the skirt and the wall")
        Contour first = ordered:Get(0)
        Contour second = ordered:Get(1)
        ExpectInteger(first:role, roles:SKIRT, "skirt first")
        ExpectInteger(second:role, roles:OUTER_WALL, "then the wall")
    end

    action Cleanup
        Case("paths too short to print are dropped")
        Array<Contour> outlines = models:ListOf(models:Square(0, 0, 10, 0))
        Array<Contour> walls
        walls:Add(models:Square(0.2, 0.2, 9.6, 0))
        walls:Add(models:Square(5, 5, 0.1, 0))
        Array<Contour> skin
        Contour stub
        stub:AddPoint(1, 1)
        stub:AddPoint(1.1, 1)
        skin:Add(stub)
        Contour kept
        kept:AddPoint(2, 2)
        kept:AddPoint(2.1, 2)
        kept:keepShort = true
        skin:Add(kept)
        Array<Contour> none
        PathOrderer orderer
        orderer:SetCleanup(1.0, 0.4, 0.05)
        Array<Contour> ordered = orderer:Order(outlines, walls, skin, none, 1)
        ExpectInteger(ordered:GetSize(), 2, "the wall and the keepShort line remain")
        ExpectInteger(orderer:GetDroppedCount(), 2, "the 0.4 mm loop and the 0.1 mm line are dropped")
    end

    action TopSurfaceLast
        Case("top surface and ironing, in one sweep")
        Array<Contour> outlines = models:Outlines(models:Cube(), 0.2)
        integer planes = models:GetLastPlaneCount()
        PathGenerator paths
        paths:SetWallCount(3)
        paths:SetTopSurfaceLayers(1)
        paths:SetIroning(true, 0.1, 0.2)
        paths:Generate(outlines, planes)
        PathOrderer orderer
        orderer:SetTopSurface(paths:GetTopSurface())
        orderer:SetIroning(paths:GetIroning())
        Array<Contour> ordered = orderer:Order(outlines, paths:GetWalls(), paths:GetSkin(), paths:GetInfill(), planes)

        // layer 99: walls, then the top surface, then the ironing over it
        Array<integer> layerRoles
        Array<Contour> surface
        integer i = 0
        repeat while i < ordered:GetSize()
            Contour path = ordered:Get(i)
            if path:planeIndex = 99
                layerRoles:Add(path:role)
                if path:role = roles:TOP_SURFACE
                    surface:Add(path)
                end
            end
            i = i + 1
        end
        integer topCount = 0
        integer ironCount = 0
        boolean inOrder = true
        integer stage = 0      // 0 walls, 1 top surface, 2 ironing
        i = 0
        repeat while i < layerRoles:GetSize()
            integer role = layerRoles:Get(i)
            integer kind = 0
            if role = roles:TOP_SURFACE
                kind = 1
                topCount = topCount + 1
            elseif role = roles:IRONING
                kind = 2
                ironCount = ironCount + 1
            elseif role not= roles:OUTER_WALL and role not= roles:INNER_WALL
                kind = 3
            end
            if kind < stage or kind = 3
                inOrder = false
            end
            stage = kind
            i = i + 1
        end
        ExpectTrue(topCount > 0, "the top layer has top surface paths")
        ExpectTrue(ironCount > 0, "and ironing")
        ExpectTrue(inOrder, "walls, then top surface, then ironing, and nothing else on the top layer")

        // one sweep: across the surface (perpendicular to its 135 degree
        // lines, measured by x + y) the nozzle only ever moves one way
        boolean up = true
        boolean down = true
        boolean havePrevious = false
        number previous = 0.0
        i = 0
        repeat while i < surface:GetSize()
            Contour line = surface:Get(i)
            integer k = 0
            repeat while k < line:GetSize()
                number across = line:xs:Get(k) + line:ys:Get(k)
                if havePrevious
                    if across < previous - 0.001
                        up = false
                    end
                    if across > previous + 0.001
                        down = false
                    end
                end
                previous = across
                havePrevious = true
                k = k + 1
            end
            i = i + 1
        end
        ExpectTrue(up or down, "the top surface is laid in one direction, line after line")
    end

    /*
    A loop like a boat seen from the side: a straight bottom and ends, and
    a smooth arched top that peaks at (10, 13). Its corners are at (0, 0),
    (20, 0), (0, 10) and (20, 10).
    */
    action ArchLoop returns Contour
        Contour loop
        loop:AddPoint(0, 0)
        loop:AddPoint(20, 0)
        loop:AddPoint(20, 10)
        integer i = 39
        repeat while i >= 1
            number x = cast(number, i) * 0.5
            loop:AddPoint(x, 10 + 3 * math:Sine(3.141592653589793 * x / 20))
            i = i - 1
        end
        loop:AddPoint(0, 10)
        loop:closed = true
        loop:planeIndex = 0
        loop:wallIndex = 0
        return loop
    end

    action SeamOnCorners
        Case("seams on corners")
        Array<Contour> outlines
        outlines:Add(ArchLoop())
        Array<Contour> walls
        walls:Add(ArchLoop())
        Array<Contour> none

        PathOrderer plain
        plain:SetSeamPoint(0, 1000000)
        Array<Contour> plainOrder = plain:Order(outlines, walls, none, none, 1)
        ExpectInteger(plainOrder:GetSize(), 1, "one wall")
        if plainOrder:GetSize() = 1
            Contour wall = plainOrder:Get(0)
            ExpectNumber(wall:HeadX(), 10, 0.01, "without corners: the seam at the top of the arch (x)")
            ExpectNumber(wall:HeadY(), 13, 0.01, "without corners: the seam at the top of the arch (y)")
        end

        PathOrderer cornered
        cornered:SetSeamPoint(0, 1000000)
        cornered:SetSeamCorners(true)
        Array<Contour> cornerOrder = cornered:Order(outlines, walls, none, none, 1)
        if cornerOrder:GetSize() = 1
            Contour wall2 = cornerOrder:Get(0)
            ExpectNumber(wall2:HeadX(), 0, 0.01, "with corners: the seam on the corner nearest the back (x)")
            ExpectNumber(wall2:HeadY(), 10, 0.01, "with corners: the seam on the corner nearest the back (y)")
        end
    end
end
