package Tests.Fabrication.Slicing

use Libraries.Containers.Array
use Libraries.Game.Graphics.Models.Data.ModelData
use Libraries.Game.Graphics.Models.Data.MeshData
use Libraries.Language.Errors.InvalidArgumentError
use Libraries.Fabrication.Geometry.TriangleMesh
use Libraries.Fabrication.Slicing.MeshSlicer
use Libraries.Fabrication.Slicing.Segment
use Tests.LampreyTest
use Tests.TestModels
use Libraries.Data.Containers.NumberBuffer

/* Tests Libraries.Fabrication.Slicing.MeshSlicer on boxes whose slices are known exactly. */
class MeshSlicerTest is LampreyTest
    TestModels models

    on create
        SetName("MeshSlicer")
    end

    action Run
        SlicesACube()
        DetectsUnits()
        PutsTheBaseDown()
        IgnoresASmallFlatSide()
        KeepsOrientationWhenAsked()
        Rotates()
        SlicesUnevenPlanes()
        RejectsMisuse()
    end

    action Prepared(ModelData model) returns MeshSlicer
        TriangleMesh mesh
        mesh:Load(model)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        return slicer
    end

    action SlicesACube
        Case("a 20 mm cube at 0.2 mm layers")
        MeshSlicer slicer = Prepared(models:Cube())
        ExpectText(slicer:GetBaseDirection(), "-Z", "an upright cube stays as it is")
        ExpectNumber(slicer:GetUnitScale(), 1, 0, "millimetres")
        ExpectInteger(slicer:GetUniqueVertexCount(), 8, "distinct vertices")
        NumberBuffer range = slicer:GetSliceRange()
        ExpectNumber(range:Get(0), 0, 0.000001, "bottom")
        ExpectNumber(range:Get(1), 20, 0.000001, "top")
        NumberBuffer planes = slicer:BuildPlanes(0, 20, 0.2)
        ExpectInteger(planes:GetSize(), 100, "one plane per layer")
        ExpectNumber(planes:Get(0), 0.1, 0.000001, "the first plane is mid-layer")
        Array<Segment> segments = slicer:Slice(planes)
        // each plane cuts both triangles of each of the 4 sides
        ExpectInteger(segments:GetSize(), 800, "segments")
        Array<text> warnings = slicer:GetWarnings()
        ExpectInteger(warnings:GetSize(), 0, "no warnings for a clean 20 mm cube")
        Segment first = segments:Get(0)
        ExpectTrue(first:planeIndex >= 0 and first:planeIndex < 100, "segments carry their plane")
    end

    action DetectsUnits
        Case("unit detection")
        MeshSlicer metres = Prepared(models:Box(0, 0, 0, 0.02, 0.02, 0.02))
        ExpectNumber(metres:GetUnitScale(), 1000, 0, "a 0.02 unit model is taken as metres")
        NumberBuffer range = metres:GetSliceRange()
        ExpectNumber(range:Get(1), 20, 0.001, "scaled to 20 mm")
        Array<text> metreWarnings = metres:GetWarnings()
        ExpectInteger(metreWarnings:GetSize(), 1, "the guess is reported")

        MeshSlicer small = Prepared(models:Box(0, 0, 0, 2, 2, 2))
        Array<text> smallWarnings = small:GetWarnings()
        ExpectInteger(smallWarnings:GetSize(), 1, "a 2 mm model may be in inches: warned")

        TriangleMesh mesh
        mesh:Load(models:Box(0, 0, 0, 2, 2, 2))
        MeshSlicer inches
        inches:SetUnitScale(25.4)
        inches:SetTriangles(mesh)
        NumberBuffer inchRange = inches:GetSliceRange()
        ExpectNumber(inchRange:Get(1), 50.8, 0.0001, "SetUnitScale(25.4) turns 2 inches into 50.8 mm")
        Array<text> inchWarnings = inches:GetWarnings()
        ExpectInteger(inchWarnings:GetSize(), 0, "no warning when the scale is given")

        MeshSlicer huge = Prepared(models:Box(0, 0, 0, 500, 10, 10))
        Array<text> hugeWarnings = huge:GetWarnings()
        ExpectInteger(hugeWarnings:GetSize(), 1, "a model larger than the bed is warned about")
    end

    action PutsTheBaseDown
        Case("the largest flat face goes on the bed")
        // a 30 x 30 plate standing on a 2 mm edge: its big face looks down -Y
        MeshSlicer slicer = Prepared(models:Box(0, 0, 0, 30, 2, 30))
        ExpectText(slicer:GetBaseDirection(), "-Y", "the base faced -Y")
        NumberBuffer range = slicer:GetSliceRange()
        ExpectNumber(range:Get(1) - range:Get(0), 2, 0.000001, "lying flat, it is 2 mm tall")

        MeshSlicer raised = Prepared(models:Box(5, 5, 7, 25, 25, 27))
        NumberBuffer raisedRange = raised:GetSliceRange()
        ExpectNumber(raisedRange:Get(0), 0, 0.000001, "a model above Z = 0 is moved down to the bed")
    end

    // A 10 x 10 x 10 block with a 2 x 2 pillar on it, 30 mm tall, flush with
    // the block at x = 0: the flat faces on -X (160 mm^2) beat the bottom
    // (100 mm^2), but cover only 0.4 of that side of the 10 x 40 box.
    action BlockWithPillar returns ModelData
        ModelData model
        Array<MeshData> meshes
        meshes:Add(models:BoxMesh(0, 0, 0, 10, 10, 10))
        meshes:Add(models:BoxMesh(0, 0, 10, 2, 2, 40))
        model:SetMeshes(meshes)
        return model
    end

    action IgnoresASmallFlatSide
        Case("a side only partly flat is the base only if enough of it is flat")
        MeshSlicer byDefault = Prepared(BlockWithPillar())
        ExpectText(byDefault:GetBaseDirection(), "-X", "0.4 of the side is flat: enough at the default share of 0.05")

        TriangleMesh mesh
        mesh:Load(BlockWithPillar())
        MeshSlicer strict
        strict:SetMinBaseShare(0.5)
        strict:SetTriangles(mesh)
        ExpectText(strict:GetBaseDirection(), "-Z", "with a share of 0.5 the side is not flat enough: it stays upright")
        NumberBuffer range = strict:GetSliceRange()
        ExpectNumber(range:Get(1), 40, 0.000001, "standing, it is 40 mm tall")
    end

    // A 10 x 20 x 30 box: auto-orient lays it on a 20 x 30 side.
    action KeepsOrientationWhenAsked
        Case("auto-orient can be turned off")
        MeshSlicer turned = Prepared(models:Box(0, 0, 0, 10, 20, 30))
        ExpectText(turned:GetBaseDirection(), "-X", "auto-orient puts the biggest side down")
        NumberBuffer turnedRange = turned:GetSliceRange()
        ExpectNumber(turnedRange:Get(1), 10, 0.000001, "lying on its biggest side it is 10 mm tall")

        TriangleMesh mesh
        mesh:Load(models:Box(0, 0, 0, 10, 20, 30))
        MeshSlicer kept
        kept:SetAutoOrient(false)
        kept:SetTriangles(mesh)
        ExpectText(kept:GetBaseDirection(), "-Z", "with auto-orient off the file's bottom stays down")
        NumberBuffer keptRange = kept:GetSliceRange()
        ExpectNumber(keptRange:Get(1), 30, 0.000001, "standing as in the file it is 30 mm tall")
    end

    // The height of a 10 x 20 x 30 box after the given rotation, with or without auto-orient.
    action RotatedHeight(boolean orient, number x, number y, number z) returns number
        TriangleMesh mesh
        mesh:Load(models:Box(0, 0, 0, 10, 20, 30))
        MeshSlicer slicer
        slicer:SetAutoOrient(orient)
        slicer:SetRotation(x, y, z)
        slicer:SetTriangles(mesh)
        NumberBuffer range = slicer:GetSliceRange()
        return range:Get(1) - range:Get(0)
    end

    action Rotates
        Case("rotation")
        ExpectNumber(RotatedHeight(false, 90, 0, 0), 20, 0.000001, "X 90 stands the 20 mm side up")
        ExpectNumber(RotatedHeight(false, 0, 90, 0), 10, 0.000001, "Y 90 stands the 10 mm side up")
        ExpectNumber(RotatedHeight(false, 0, 0, 45), 30, 0.000001, "Z 45 turns it on the bed: as tall as before")
        ExpectNumber(RotatedHeight(false, -90, 0, 0), 20, 0.000001, "X -90 stands the 20 mm side up too")
        // auto-orient lays it on a 20 x 30 side (10 tall, 20 deep), then X 90 stands it on its 30 x 10 side
        ExpectNumber(RotatedHeight(true, 90, 0, 0), 20, 0.000001, "the rotation comes after auto-orient")

        TriangleMesh mesh
        mesh:Load(models:Box(0, 0, 0, 10, 20, 30))
        MeshSlicer slicer
        slicer:SetAutoOrient(false)
        slicer:SetRotation(0, 0, 90)
        slicer:SetTriangles(mesh)
        ExpectInteger(slicer:GetUniqueVertexCount(), 8, "a quarter turn keeps the 8 corners exact")

        boolean tooFar = false
        check
            MeshSlicer wild
            wild:SetRotation(0, 0, 400)
        detect e1 is InvalidArgumentError
            tooFar = true
        end
        ExpectTrue(tooFar, "a rotation past 360 degrees is refused")
    end

    // Planes need not be evenly spaced (a thicker first layer, variable layers).
    action SlicesUnevenPlanes
        Case("uneven planes")
        MeshSlicer slicer = Prepared(models:Cube())
        NumberBuffer planes
        planes:Add(0.15)
        planes:Add(0.35)
        planes:Add(0.5)
        planes:Add(10.0)
        planes:Add(19.95)
        Array<Segment> segments = slicer:Slice(planes)
        ExpectInteger(segments:GetSize(), 40, "8 segments on each of 5 uneven planes")
        integer onLast = 0
        integer i = 0
        repeat while i < segments:GetSize()
            Segment seg = segments:Get(i)
            if seg:planeIndex = 4
                onLast = onLast + 1
            end
            i = i + 1
        end
        ExpectInteger(onLast, 8, "the top plane, 0.05 mm under the top, is cut too")

        boolean unordered = false
        check
            NumberBuffer backwards
            backwards:Add(5.0)
            backwards:Add(1.0)
            Array<Segment> none = slicer:Slice(backwards)
        detect e2
            unordered = true
        end
        ExpectTrue(unordered, "planes out of order are refused")
    end

    action RejectsMisuse
        Case("misuse stops with a message")
        boolean emptyMesh = false
        check
            TriangleMesh nothing
            MeshSlicer slicer
            slicer:SetTriangles(nothing)
        detect e1
            emptyMesh = true
        end
        ExpectTrue(emptyMesh, "SetTriangles with an empty mesh")

        boolean early = false
        check
            MeshSlicer unused
            NumberBuffer range = unused:GetSliceRange()
        detect e2
            early = true
        end
        ExpectTrue(early, "GetSliceRange before SetTriangles")

        boolean zeroLayer = false
        check
            MeshSlicer cube = Prepared(models:Cube())
            NumberBuffer planes = cube:BuildPlanes(0, 20, 0)
        detect e3 is InvalidArgumentError
            zeroLayer = true
        end
        ExpectTrue(zeroLayer, "a layer height of 0 (which would loop forever)")

        boolean flat = false
        check
            MeshSlicer cube2 = Prepared(models:Cube())
            NumberBuffer none = cube2:BuildPlanes(0, 0.05, 0.2)
        detect e4
            flat = true
        end
        ExpectTrue(flat, "a model thinner than half a layer")

        boolean negativeScale = false
        check
            MeshSlicer scaled
            scaled:SetUnitScale(-1)
        detect e5 is InvalidArgumentError
            negativeScale = true
        end
        ExpectTrue(negativeScale, "a negative unit scale")
    end
end
