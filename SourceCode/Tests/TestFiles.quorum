package Tests

use Libraries.System.File
use Libraries.Data.Compression.ZipWriter
use Libraries.Data.Compression.ZipReader

/*
The TestFiles class manages the scratch files tests write. Everything goes
under Outputs/tests/, which is ignored by git and safe to delete.
*/
class TestFiles
    text root = "Outputs/tests"
    integer checksums = 0

    /* The path of a scratch file, such as Path("gcode/cube.gcode"). */
    action Path(text name) returns text
        return root + "/" + name
    end

    /* Writes a scratch file, creating its folder. Returns its path. */
    action Write(text name, text content) returns text
        return WriteAt(Path(name), content)
    end

    /* Writes any file (relative to the project folder), creating its folder. Returns its path. */
    action WriteAt(text path, text content) returns text
        File file
        file:SetPath(path)
        File folder = file:GetParentDirectory()
        if not folder:Exists()
            folder:CreateDirectories()
        end
        file:Write(content)
        return path
    end

    /* Deletes a scratch file if it exists. */
    action Delete(text name)
        File file
        file:SetPath(Path(name))
        if file:Exists()
            file:Delete()
        end
    end

    /*
    The MD5 (32 upper-case hex digits) of the text's UTF-8 bytes. Lamprey's
    only MD5 is ZipWriter:AddMd5, so this writes it into a scratch archive
    and reads it back (a new archive each time, so none is rewritten while
    Windows may still hold it open for reading).
    */
    action Md5(text content) returns text
        checksums = checksums + 1
        text archive = Path("md5/checksum-" + checksums + ".zip")
        ZipWriter zip
        zip:Open(archive)
        zip:AddMd5("checksum.md5", content)
        zip:Close()
        ZipReader reader
        return reader:ReadText(archive, "checksum.md5")
    end

    /* Whether a scratch file exists. */
    action Exists(text name) returns boolean
        File file
        file:SetPath(Path(name))
        return file:Exists()
    end
end
