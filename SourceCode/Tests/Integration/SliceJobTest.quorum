package Tests.Integration

use Libraries.Containers.Array
use Libraries.Data.Compression.ZipReader
use Libraries.Game.Graphics.Models.Data.ModelData
use Libraries.Fabrication.SliceJob
use Libraries.Fabrication.Profiles.Profile
use Libraries.Fabrication.Profiles.ProfileManager
use Libraries.System.File
use Tests.LampreyTest
use Tests.TestModels
use Tests.TestFiles
use Tests.GcodeReader

/*
Integration tests: whole slices, model to G-code, with every shipped profile
in Profiles/profiles.json, the way Main runs them. These catch stages that
work alone but not together, and profiles or templates that no longer work.
*/
class SliceJobTest is LampreyTest
    TestModels models
    TestFiles files
    ProfileManager profiles

    on create
        SetName("SliceJob with every shipped profile")
    end

    action Run
        profiles:Load("Profiles/profiles.json")
        EveryProfileSlicesACube()
        SupportsAndAdhesion()
        TopSurfaceAndIroning()
        BambuArchive()
        BambuA1Archive()
        UnusableInput()
    end

    /* Slices quietly and reads the G-code back. */
    action Slice(ModelData model, Profile profile, text name) returns GcodeReader
        SliceJob job
        job:SetVerbose(false)
        text path = files:Path("slice/" + name + ".gcode")
        text written = job:Run(model, profile, path)
        GcodeReader reader
        reader:Read(path)
        return reader
    end

    action EveryProfileSlicesACube
        Case("every profile slices a cube")
        integer i = 0
        repeat while i < profiles:GetSize()
            Profile profile = profiles:Get(i)
            text name = profile:GetName()
            GcodeReader reader = Slice(models:Cube(), profile, name + "-cube")
            number layerHeight = profile:GetNumber("layerHeight")
            integer layers = reader:GetLayerCount()
            ExpectNumber(layers * layerHeight, 20, layerHeight, name + ": layers x height covers the 20 mm cube")
            ExpectNumber(reader:GetLayerZ(layers - 1), 20, layerHeight, name + ": the last layer is at the top")
            ExpectInteger(reader:GetBadNumberCount(), 0, name + ": every number is plain decimal text")
            ExpectTrue(reader:GetPrintMoveCount() > 1000, name + ": the cube is printed")
            number centreX = profile:GetNumber("bedWidth") / 2
            ExpectNumber((reader:GetMinX() + reader:GetMaxX()) / 2, centreX, 0.5, name + ": centred on the bed")
            text gcodeText = reader:GetText()
            ExpectNotContains(gcodeText, "{NOZZLE_TEMP}", name + ": the start G-code placeholders are filled in")
            ExpectContains(gcodeText, ";TYPE:WALL-OUTER", name + ": walls")
            ExpectContains(gcodeText, ";TYPE:SKIN", name + ": skin")
            i = i + 1
        end
    end

    action SupportsAndAdhesion
        Case("supports, skirt and brim on the ledge model")
        Profile supported = profiles:Derive("ender3-v2", "test-supported")
        supported:SetBoolean("supportsEnabled", true)
        supported:Set("adhesionType", "skirt")
        GcodeReader withSupport = Slice(models:Ledge(), supported, "ledge-supported")
        text supportedText = withSupport:GetText()
        ExpectContains(supportedText, ";TYPE:SUPPORT", "the ledge gets support")
        ExpectContains(supportedText, ";TYPE:SKIRT", "the skirt is printed")

        Profile bare = profiles:Derive("ender3-v2", "test-bare")
        bare:SetBoolean("supportsEnabled", false)
        bare:Set("adhesionType", "skirt")
        GcodeReader withoutSupport = Slice(models:Ledge(), bare, "ledge-bare")
        text bareText = withoutSupport:GetText()
        ExpectNotContains(bareText, ";TYPE:SUPPORT", "no support when it's off")
        ExpectTrue(withSupport:GetExtruded() > withoutSupport:GetExtruded(), "support uses extra filament")

        Profile brimmed = profiles:Derive("ender3-v2", "test-brim")
        brimmed:SetBoolean("supportsEnabled", false)
        brimmed:Set("adhesionType", "brim")
        GcodeReader withBrim = Slice(models:Cube(), brimmed, "cube-brim")
        text brimText = withBrim:GetText()
        ExpectContains(brimText, ";TYPE:SKIRT", "the brim is printed (G-code previewers call it SKIRT)")
        // 8 brim loops 0.4 mm apart touching the cube: the outermost centre line is 3 mm out
        ExpectNumber(withBrim:GetMaxX() - withBrim:GetMinX(), 20 + 2 * 3.0, 0.1, "the brim's width")
    end

    action TopSurfaceAndIroning
        Case("top surfaces and ironing from a profile")
        Profile plain = profiles:Derive("ender3-v2", "test-top-plain")
        plain:SetInteger("topSurfaceLayers", 0)
        plain:SetNumber("topSurfaceSpeed", 31)
        GcodeReader plainCube = Slice(models:Cube(), plain, "cube-top-plain")
        text plainText = plainCube:GetText()
        ExpectNotContains(plainText, " F1860", "topSurfaceLayers 0: no top surface speed")

        Profile top = profiles:Derive("ender3-v2", "test-top")
        top:SetInteger("topSurfaceLayers", 1)
        top:SetNumber("topSurfaceSpeed", 31)
        GcodeReader topCube = Slice(models:Cube(), top, "cube-top")
        text topText = topCube:GetText()
        ExpectContains(topText, " F1860", "the top surface at its own speed")

        Profile ironed = profiles:Derive("ender3-v2", "test-ironed")
        ironed:SetInteger("topSurfaceLayers", 1)
        ironed:SetBoolean("ironing", true)
        ironed:SetNumber("ironingSpeed", 13)
        GcodeReader ironedCube = Slice(models:Cube(), ironed, "cube-ironed")
        text ironedText = ironedCube:GetText()
        ExpectContains(ironedText, " F780", "ironing at its own speed")
        ExpectTrue(ironedCube:GetPrintMoveCount() > topCube:GetPrintMoveCount() + 100, "ironing adds many moves")
        ExpectTrue(ironedCube:GetExtruded() > topCube:GetExtruded(), "and a little plastic")
        ExpectTrue(ironedCube:GetExtruded() < topCube:GetExtruded() * 1.05, "only a little")
    end

    action BambuArchive
        Case("the P2S profile makes a .gcode.3mf")
        SliceJob job
        job:SetVerbose(false)
        text gcodePath = files:Path("slice/p2s-archive.gcode")
        text archive = job:Run(models:Cube(), profiles:Require("bambu-p2s"), gcodePath)
        ExpectText(archive, files:Path("slice/p2s-archive.gcode.3mf"), "Run returns the archive")
        ZipReader zip
        ExpectTrue(zip:HasEntry(archive, "Metadata/plate_1.gcode"), "the archive holds the G-code")
        File file
        file:SetPath(gcodePath)
        text written = file:Read()
        ExpectTrue(written:StartsWith("; HEADER_BLOCK_START"), "the G-code has Bambu's header")
    end

    action BambuA1Archive
        Case("the A1 profile makes a .gcode.3mf for the A1")
        SliceJob job
        job:SetVerbose(false)
        text gcodePath = files:Path("slice/a1-archive.gcode")
        text archive = job:Run(models:Cube(), profiles:Require("bambu-a1"), gcodePath)
        ExpectText(archive, files:Path("slice/a1-archive.gcode.3mf"), "Run returns the archive")
        ZipReader zip
        ExpectTrue(zip:HasEntry(archive, "Metadata/plate_1.gcode"), "the archive holds the G-code")
        text sliceInfo = zip:ReadText(archive, "Metadata/slice_info.config")
        ExpectContains(sliceInfo, "N2S", "slice_info has the A1's model id")
        text settings = zip:ReadText(archive, "Metadata/project_settings.config")
        ExpectContains(settings, "Bambu Lab A1 0.4 nozzle", "the A1 settings template went into the 3MF")

        File file
        file:SetPath(gcodePath)
        text written = file:Read()
        ExpectTrue(written:StartsWith("; HEADER_BLOCK_START"), "the G-code has Bambu's header")
        ExpectContains(written, "M1002 set_filament_type:PLA", "the start code names the filament")
        ExpectContains(written, "M620 S0A", "filament 1 comes from the AMS lite or the external spool")
        ExpectContains(written, "G29 A1 X", "the bed mesh covers the print")
        text placeholders = "{FILAMENT_TYPE} {FIRST_CENTER_Y} {PARK_Z_UP} {PARK_Z_UP_BACK} {PRIME_FEED} {PRIME_FEED_SLOW} {LINE_FEED} {CALI_FEED} {CALI_FLOW} {FLOW_FEED} {NOZZLE_TEMP_LESS_50}"
        Array<text> names = placeholders:Split(" ")
        integer i = 0
        repeat while i < names:GetSize()
            ExpectNotContains(written, names:Get(i), names:Get(i) + " is filled in")
            i = i + 1
        end

        // the end code raises the gantry 100 mm above the cube's 20 mm top
        integer parkAt = written:IndexOf(" F600 ; raise the gantry")
        ExpectTrue(parkAt > 16, "the end code has the A1 park move")
        if parkAt > 16
            text before = written:GetSubtext(parkAt - 16, parkAt)
            integer zAt = before:IndexOf("G1 Z")
            ExpectTrue(zAt >= 0, "the park move is a G1 Z")
            if zAt >= 0
                text z = before:GetSubtext(zAt + 4)
                ExpectNumber(z:ParseNumber(), 120, 0.5, "the gantry parks 100 mm above the print")
            end
        end
    end

    action UnusableInput
        Case("unusable input stops with a message")
        boolean flat = false
        check
            SliceJob job
            job:SetVerbose(false)
            text result = job:Run(models:Box(0, 0, 0, 20, 20, 0.05), profiles:Require("ender3-v2"), files:Path("slice/flat.gcode"))
        detect e1
            flat = true
        end
        ExpectTrue(flat, "a model thinner than half a layer")

        boolean noPath = false
        check
            SliceJob job2
            text result2 = job2:Run(models:Cube(), profiles:Require("ender3-v2"), "")
        detect e2
            noPath = true
        end
        ExpectTrue(noPath, "no G-code path")
    end
end
