package Lamprey.Profiles

use Libraries.Compute.Math

/*
    Numbers as the short text people write: 0.2 not 0.2000000001, 200 not
    200.0. The same rules as Bambu3mfPacker's Short (Python's "{:g}" for
    everyday values: up to 6 significant digits, no trailing zeros).
*/
class NumberText
    Math math

    action Short(number value) returns text
        integer decimals = 6
        number whole = math:Floor(math:AbsoluteValue(value))
        if whole >= 1
            text wholeDigits = WholeNumber(whole)
            decimals = 6 - wholeDigits:GetSize()
            if decimals < 0
                decimals = 0
            end
        end
        text result = Fixed(value, decimals)
        if result:Contains(".")
            repeat while result:EndsWith("0")
                result = result:GetSubtext(0, result:GetSize() - 1)
            end
            if result:EndsWith(".")
                result = result:GetSubtext(0, result:GetSize() - 1)
            end
        end
        if result = "-0"
            result = "0"
        end
        return result
    end

    /* A fraction as a percentage, the way Bambu Studio writes it: 0.15 -> "15%". */
    action Percent(number fraction) returns text
        return Short(fraction * 100.0) + "%"
    end

    /* Rounded to the nearest whole number, without ".0". */
    action Rounded(number value) returns text
        return Short(math:Round(value))
    end

    action Fixed(number value, integer decimals) returns text
        text sign = ""
        number amount = value
        if amount < 0
            sign = "-"
            amount = -amount
        end
        number scale = 1.0
        repeat decimals times
            scale = scale * 10.0
        end
        number rounded = math:Round(amount * scale)
        number whole = math:Floor(rounded / scale)
        number fraction = rounded - whole * scale
        text result = sign + WholeNumber(whole)
        if decimals > 0
            text fractionDigits = WholeNumber(fraction)
            repeat while fractionDigits:GetSize() < decimals
                fractionDigits = "0" + fractionDigits
            end
            result = result + "." + fractionDigits
        end
        return result
    end

    private action WholeNumber(number value) returns text
        if value < 1
            return "0"
        end
        text result = ""
        number remaining = value
        repeat while remaining >= 1
            integer digit = cast(integer, remaining mod 10.0)
            result = "" + digit + result
            remaining = math:Floor(remaining / 10.0)
        end
        return result
    end
end
