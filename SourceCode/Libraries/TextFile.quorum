package Libraries.System

/*
The TextFile class reads whole text files as UTF-8. Bytes that are not valid
UTF-8 become the replacement character instead of stopping the program.
Relative paths are resolved against the folder the program runs in (in Quorum
Studio, the project folder), the same as ZipWriter and ZipReader.

The work is done in Java by plugins.quorum.Libraries.System.TextFile
(Plugins/src), using only the Java standard library.

Attribute: Example

    use Libraries.System.TextFile

    class Main
        action Main
            TextFile file
            if file:Exists("notes.txt")
                output file:Read("notes.txt")
            else
                output "Not found: " + file:GetAbsolutePath("notes.txt")
            end
        end
    end
*/
class TextFile
    /*
    Checks whether a path names an existing file (not a folder).

    Attribute: Parameter path The file to look for.

    Attribute: Returns True if the file exists.
    */
    system action Exists(text path) returns boolean

    /*
    Reads a whole file. Stops with an error naming the absolute path if the
    file does not exist or cannot be read.

    Attribute: Parameter path The file to read.

    Attribute: Returns The contents of the file.
    */
    system action Read(text path) returns text

    /*
    Turns a path into the absolute path it refers to, which is useful in
    error messages about relative paths.

    Attribute: Parameter path A relative or absolute path.

    Attribute: Returns The absolute path.
    */
    system action GetAbsolutePath(text path) returns text
end
