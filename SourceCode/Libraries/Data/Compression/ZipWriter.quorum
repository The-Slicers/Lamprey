package Libraries.Data.Compression

/*
The ZipWriter class writes a ZIP archive entry by entry. Entries are written
in the order they are added, text is stored as UTF-8, PNG images can be
drawn pixel by pixel and added as entries, and an entry can hold the MD5
checksum of some text (as Bambu Lab printers expect next to a .gcode).
This is Lamprey's only Java plugin: the standard library can unzip
(Decompresser) but not create archives. The work is done by java.util.zip
and javax.imageio through the plugin
plugins.quorum.Libraries.Data.Compression.ZipWriter (Plugins/src).

Every action stops with an error that names the archive and the entry when
something goes wrong: adding before Open, adding the same entry twice,
copying an entry that was never added (or that isn't an image), or a file
system error.

Only image entries are kept in memory after they are written, so AddCopy
can copy them. A large text file is best added with AddFile, which reads it
a piece at a time instead of holding it all as text.

Attribute: Example

    use Libraries.Data.Compression.ZipWriter

    class Main
        action Main
            ZipWriter zip
            zip:Open("Outputs/example.zip")
            zip:AddText("readme.txt", "Hello")
            zip:BeginImage(2, 2)
            zip:SetPixel(0, 0, 255, 0, 0, 255)
            zip:AddImage("red-dot.png")
            zip:AddCopy("copy-of-red-dot.png", "red-dot.png")
            zip:AddMd5("readme.txt.md5", "Hello")
            zip:Close()
        end
    end
*/
class ZipWriter
    /*
    Creates (or overwrites) the archive, creating its folder if needed. An
    archive that was still open is finished first.

    Attribute: Parameter path Where to write the archive.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/notes.zip")
        zip:AddText("notes.txt", "Hello")
        zip:Close()
    */
    system action Open(text path)

    /*
    Adds one entry whose content is the text, encoded as UTF-8.

    Attribute: Parameter entryName The name inside the archive, such as "Metadata/plate_1.gcode".
    Attribute: Parameter content The text to store.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/print.zip")
        zip:AddText("Metadata/plate_1.gcode", "G28 ;home all axes")
        zip:Close()
    */
    system action AddText(text entryName, text content)

    /*
    Starts a blank, fully transparent RGBA image. Sizes below 1 become 1.

    Attribute: Parameter width The width in pixels.
    Attribute: Parameter height The height in pixels.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/thumbnail.zip")
        zip:BeginImage(128, 128)
        zip:SetPixel(64, 64, 255, 255, 255, 255)
        zip:AddImage("thumbnail.png")
        zip:Close()
    */
    system action BeginImage(integer width, integer height)

    /*
    Sets one pixel of the current image. Pixels outside the image are
    ignored, and each channel is clamped to 0 to 255.

    Attribute: Parameter x The column, from the left.
    Attribute: Parameter y The row, from the top.
    Attribute: Parameter red The red channel.
    Attribute: Parameter green The green channel.
    Attribute: Parameter blue The blue channel.
    Attribute: Parameter alpha The opacity, 255 being opaque.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/square.zip")
        zip:BeginImage(8, 8)
        integer x = 2
        repeat while x < 6
            zip:SetPixel(x, 2, 0, 128, 255, 255)
            x = x + 1
        end
        zip:AddImage("square.png")
        zip:Close()
    */
    system action SetPixel(integer x, integer y, integer red, integer green, integer blue, integer alpha)

    /*
    Encodes the current image as PNG and adds it as an entry.

    Attribute: Parameter entryName The name inside the archive.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/dot.zip")
        zip:BeginImage(1, 1)
        zip:SetPixel(0, 0, 255, 0, 0, 255)
        zip:AddImage("Metadata/dot.png")
        zip:Close()
    */
    system action AddImage(text entryName)

    /*
    Adds another entry with exactly the same bytes as an image added earlier
    (with AddImage, or a copy of one). Other entries are not kept in memory,
    so they can't be copied.

    Attribute: Parameter entryName The name of the new entry.
    Attribute: Parameter existingEntryName The image entry to copy.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/plate.zip")
        zip:BeginImage(2, 2)
        zip:AddImage("Metadata/plate_1.png")
        zip:AddCopy("Metadata/plate_no_light_1.png", "Metadata/plate_1.png")
        zip:Close()
    */
    system action AddCopy(text entryName, text existingEntryName)

    /*
    Adds a text entry holding the MD5 checksum of the content's UTF-8 bytes:
    32 upper-case hexadecimal digits, the form Bambu Studio writes in
    Metadata/plate_1.gcode.md5. The content itself is not added.

    Attribute: Parameter entryName The name of the checksum entry.
    Attribute: Parameter content The text to checksum.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        text gcode = "G28"
        ZipWriter zip
        zip:Open("Outputs/print.zip")
        zip:AddMd5("Metadata/plate_1.gcode.md5", gcode)
        zip:AddText("Metadata/plate_1.gcode", gcode)
        zip:Close()
    */
    system action AddMd5(text entryName, text content)

    /*
    Adds a text file as an entry, read a piece at a time so it is never held
    in memory whole. The file is read as text the way File:Read reads it and
    stored as UTF-8, like AddText. The characters from position firstCharacter up
    to (not including) position endCharacter are replaced by the replacement
    text, so the entry holds exactly what AddText would store for
    text:GetSubtext(0, firstCharacter) + replacement + text:GetSubtext(endCharacter),
    where text is the whole file. AddFile(name, path, 0, 0, "") adds the
    file unchanged. Positions count characters, as GetSubtext does.

    Attribute: Parameter entryName The name inside the archive, such as "Metadata/plate_1.gcode".
    Attribute: Parameter path The text file to add.
    Attribute: Parameter firstCharacter The first character to replace.
    Attribute: Parameter endCharacter The character after the last one to replace (firstCharacter for none).
    Attribute: Parameter replacement The text written in their place.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/print.zip")
        zip:AddFile("Metadata/plate_1.gcode", "Outputs/cube.gcode", 0, 0, "")
        zip:Close()
    */
    system action AddFile(text entryName, text path, integer firstCharacter, integer endCharacter, text replacement)

    /*
    Adds a text entry holding the MD5 checksum of exactly the bytes
    AddFile(entryName, path, firstCharacter, endCharacter, replacement) would write, in
    the same form as AddMd5. The file is read a piece at a time.

    Attribute: Parameter entryName The name of the checksum entry.
    Attribute: Parameter path The text file to checksum.
    Attribute: Parameter firstCharacter The first character to replace.
    Attribute: Parameter endCharacter The character after the last one to replace (firstCharacter for none).
    Attribute: Parameter replacement The text checksummed in their place.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/print.zip")
        zip:AddMd5OfFile("Metadata/plate_1.gcode.md5", "Outputs/cube.gcode", 0, 0, "")
        zip:AddFile("Metadata/plate_1.gcode", "Outputs/cube.gcode", 0, 0, "")
        zip:Close()
    */
    system action AddMd5OfFile(text entryName, text path, integer firstCharacter, integer endCharacter, text replacement)

    /*
    The first characters of a text file (all of it, if it is shorter), read
    the way File:Read reads the whole file: the same as File:Read followed by
    GetSubtext(0, count), without reading the rest. It does not need an open
    archive.

    Attribute: Parameter path The text file.
    Attribute: Parameter count How many characters to read at most.
    Attribute: Returns The start of the file.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        text top = zip:ReadStart("Outputs/cube.gcode", 3000)
    */
    system action ReadStart(text path, integer count) returns text

    /*
    Finishes the archive. Nothing in it can be read until this is called.
    Calling it again does nothing.

    Attribute: Example

        use Libraries.Data.Compression.ZipWriter

        ZipWriter zip
        zip:Open("Outputs/readme.zip")
        zip:AddText("readme.txt", "Finished archives can be opened by any ZIP tool.")
        zip:Close()
    */
    system action Close
end
