package Libraries.Fabrication.Geometry

use Libraries.Containers.Array
use Libraries.Fabrication.ArgumentChecker
use Libraries.Fabrication.Geometry.OutlineEdges
use Libraries.Fabrication.Geometry.VoronoiJava

/*
The VoronoiDiagram class builds the Voronoi diagram of a layer's outline, the
start of the adaptive walls' skeleton (SkeletalTrapezoidation). It is built by
the VoronoiJava plugin with the JTS Topology Suite, which runs on every
operating system without a native library.

JTS diagrams points, not segments, so the outline is sampled every `spacing`
mm (and at every corner). The diagram therefore comes out already cut down to
the skeleton: only edges inside the outline, all straight (linear = 1), no
unbounded edges, and each run between the same two segments joined into one
edge. SkeletalTrapezoidation reads `sampled` to skip its own inside test, and
measures radii to the real outline segments and corners.

The arrays hold one entry per directed edge; every edge appears twice, once per
direction, with its cells, categories and vertices swapped. A cell is a
segment of OutlineEdges (cell0 is on the edge's left): category 1 for a
segment's start point (a reflex corner), 8 for the segment itself.

Attribute: Example

    use Libraries.Containers.Array
    use Libraries.Fabrication.Geometry.Contour
    use Libraries.Fabrication.Geometry.OutlineEdges
    use Libraries.Fabrication.Geometry.VoronoiDiagram

    class Main
        action Main
            Contour square
            square:AddPoint(0, 0)
            square:AddPoint(1, 0)
            square:AddPoint(1, 1)
            square:AddPoint(0, 1)
            square:closed = true
            Array<Contour> outline
            outline:Add(square)

            OutlineEdges edges
            edges:BuildEdges(outline)
            VoronoiDiagram diagram
            diagram:Generate(edges)
            if diagram:Failed()
                output diagram:GetError()
            else
                output diagram:vertX:GetSize() + " vertices"
            end
        end
    end
*/
class VoronoiDiagram
    number scale = 1000.0
    number spacing = 0.1                // mm between outline samples

    /* True: the edges come from a sampled outline (inside only, straight). */
    public boolean sampled = true

    boolean failed = false
    text error = ""

    VoronoiJava plugin
    ArgumentChecker checker

    // vertices (mm)
    public Array<number> vertX
    public Array<number> vertY

    // directed edges
    public Array<integer> cell0
    public Array<integer> category0
    public Array<integer> cell1
    public Array<integer> category1
    public Array<integer> vertex0          // vertex where edge starts
    public Array<integer> vertex1          // vertex were edge ends
    public Array<integer> linear

    /*
    Builds the diagram of the outline's segments, replacing any earlier one.
    If it fails, Failed is true, GetError says why, and the arrays are empty.
    */
    action Generate(OutlineEdges edges)
        scale = edges:scale
        failed = false
        error = ""

        // reset arrays
        vertX:Empty()
        vertY:Empty()
        cell0:Empty()
        cell1:Empty()
        category0:Empty()
        category1:Empty()
        vertex0:Empty()
        vertex1:Empty()
        linear:Empty()

        if edges:x0:GetSize() = 0
            return now
        end

        // segments in OutlineEdges order, so the plugin's cells are OutlineEdges' segment indices
        plugin:Clear()
        integer i = 0
        repeat while i < edges:x0:GetSize()
            plugin:AddSegment(edges:ScaleDown(edges:x0:Get(i)), edges:ScaleDown(edges:y0:Get(i)),
                              edges:ScaleDown(edges:x1:Get(i)), edges:ScaleDown(edges:y1:Get(i)))
            i = i + 1
        end

        integer status = plugin:Build(spacing)
        if status not= 0
            failed = true
            error = plugin:GetError()
            return now
        end

        integer vertexCount = plugin:GetVertexCount()
        integer v = 0
        repeat while v < vertexCount
            vertX:Add(plugin:GetVertexX(v))
            vertY:Add(plugin:GetVertexY(v))
            v = v + 1
        end

        integer edgeCount = plugin:GetEdgeCount()
        integer e = 0
        repeat while e < edgeCount
            cell0:Add(plugin:GetEdgeCell0(e))
            category0:Add(plugin:GetEdgeCategory0(e))
            cell1:Add(plugin:GetEdgeCell1(e))
            category1:Add(plugin:GetEdgeCategory1(e))
            vertex0:Add(plugin:GetEdgeVertex0(e))
            vertex1:Add(plugin:GetEdgeVertex1(e))
            linear:Add(1)
            e = e + 1
        end
    end

    /*
    Sets how far apart (mm) the outline is sampled. Smaller is closer to the exact
    skeleton but slower: the skeleton's error is about spacing^2 / (8 * radius).
    */
    action SetSpacing(number mm)
        checker:RequirePositive("VoronoiDiagram:SetSpacing mm", mm)
        spacing = mm
    end

    action GetSpacing returns number
        return spacing
    end

    /* True if the last Generate failed (see GetError). */
    action Failed returns boolean
        return failed
    end

    /* Why the last Generate failed; empty when it didn't. */
    action GetError returns text
        return error
    end

    /* How many outline samples the last Generate used. */
    action GetSampleCount returns integer
        return plugin:GetSampleCount()
    end
end
