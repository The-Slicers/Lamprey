package Libraries.Fabrication.Geometry

use Libraries.Containers.Array
use Libraries.Compute.Math
use Libraries.Data.Containers.NumberBuffer

/*
The PolygonOffsetter class moves closed loops inward or outward by a fixed
distance: every edge moves sideways, and PolygonOperations then keeps
whatever winds positively.

At a corner where the two moved edges converge they normally meet at a
mitre point. Where that point would cut more than half off either edge
beside the corner (short edges, small steps in the outline) the moved edges
could fold over each other, so there the loop instead goes from the end of
the first moved edge back through the original corner to the start of the
second, as Clipper does: the fold then winds the other way and Resolve
drops it, so insets come out exact instead of with spurs. At a corner where they diverge, Offset keeps the shapes it always
had: an inset rounds the corner with an arc (16 degree steps), an outset
keeps it sharp (mitred, or a plain link when sharper than 120 degrees).
OffsetRounded rounds every diverging corner instead, which grows or shrinks
the loops by a disc, like a Minkowski sum.

The sign follows the material, which lies on the left of every loop: a
positive distance shrinks the material (an inset), a negative one grows it
(an outset).

Attribute: Example

    use Libraries.Containers.Array
    use Libraries.Fabrication.Geometry.Contour
    use Libraries.Fabrication.Geometry.PolygonOffsetter

    class Main
        action Main
            Array<Contour> outline      // one layer's loops, from ContourGenerator
            PolygonOffsetter offsetter
            Array<Contour> wall = offsetter:Offset(outline, 0.2)       // 0.2 mm inside
            Array<Contour> brim = offsetter:Offset(outline, -3.0)      // 3 mm outside, sharp corners
            Array<Contour> reach = offsetter:OffsetRounded(outline, -0.4)  // everything within 0.4 mm
        end
    end
*/
class PolygonOffsetter
    Math math
    PolygonOperations ops

    // 16 degree arc step for rounded corners (max sag ~1% of the distance)
    number stepCos = 0.9612616959383189
    number stepSin = 0.27563735581699916

    /*
    Offsets every closed loop of a layer. Open paths and loops of fewer than
    3 points are ignored.

    Attribute: Parameter loops Loops on one plane (the first loop's plane is used for the result).
    Attribute: Parameter distance How far to move (mm): positive moves into the material, negative away from it.
    Attribute: Returns The offset loops; copies of the input for a distance of 0.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Geometry.PolygonOffsetter

        Contour square
        square:AddPoint(0, 0)
        square:AddPoint(20, 0)
        square:AddPoint(20, 20)
        square:AddPoint(0, 20)
        square:closed = true
        Array<Contour> outline
        outline:Add(square)
        PolygonOffsetter offsetter
        Array<Contour> inset = offsetter:Offset(outline, 0.2)      // 0.2 mm in: an outer wall's centre line
        Contour wall = inset:Get(0)
        output wall:Area()      // 384.16, a 19.6 mm square
    */
    action Offset(Array<Contour> loops, number distance) returns Array<Contour>
        return OffsetLoops(loops, distance, false)
    end

    /*
    Offsets every closed loop like Offset, but rounds every corner where the
    moved edges diverge, outsets too: the result is everything within
    distance of the material (an outset) or everything at least distance
    inside it (an inset), with corners rounded in 16 degree steps.

    Attribute: Parameter loops Loops on one plane (the first loop's plane is used for the result).
    Attribute: Parameter distance How far to move (mm): positive moves into the material, negative away from it.
    Attribute: Returns The offset loops; copies of the input for a distance of 0.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Geometry.PolygonOffsetter

        Contour square
        square:AddPoint(0, 0)
        square:AddPoint(20, 0)
        square:AddPoint(20, 20)
        square:AddPoint(0, 20)
        square:closed = true
        Array<Contour> outline
        outline:Add(square)
        PolygonOffsetter offsetter
        Array<Contour> grown = offsetter:OffsetRounded(outline, -2)
        Contour around = grown:Get(0)
        output around:Area()      // 572.41: 24 x 24 with corners rounded to 2 mm
    */
    action OffsetRounded(Array<Contour> loops, number distance) returns Array<Contour>
        return OffsetLoops(loops, distance, true)
    end

    private action OffsetLoops(Array<Contour> loops, number distance, boolean rounded) returns Array<Contour>
        Array<Contour> result
        if loops:GetSize() = 0
            return result
        end
        Contour firstLoop = loops:Get(0)
        integer planeIndex = firstLoop:planeIndex

        if distance = 0
            integer c = 0
            repeat while c < loops:GetSize()
                Contour src = loops:Get(c)
                result:Add(src:Copy())
                c = c + 1
            end
            return result
        end

        ops:Clear()
        NumberBuffer qx
        NumberBuffer qy
        integer i = 0
        repeat while i < loops:GetSize()
            Contour con = loops:Get(i)
            if con:closed and con:GetSize() >= 3
                qx:Empty()
                qy:Empty()
                RawLoop(con, distance, rounded, qx, qy)
                ops:AddPoints(qx, qy, false)
            end
            i = i + 1
        end
        return ops:Resolve(1, planeIndex)
    end

    // Offsets every corner of the loop by d (see the class description) and
    // writes the raw loop, folds and all, into qx / qy.
    private action RawLoop(Contour con, number d, boolean rounded, NumberBuffer qx, NumberBuffer qy)
        integer n = con:GetSize()
        integer i = 0
        repeat while i < n
            // corner B with its neighbors A (before) and C (after)
            integer ia = i - 1
            if ia < 0
                ia = n - 1
            end
            integer ic = i + 1
            if ic = n
                ic = 0
            end
            number ax = con:xs:Get(ia)
            number ay = con:ys:Get(ia)
            number bx = con:xs:Get(i)
            number by = con:ys:Get(i)
            number cx = con:xs:Get(ic)
            number cy = con:ys:Get(ic)

            number u1x = bx - ax
            number u1y = by - ay
            number l1 = math:SquareRoot(u1x * u1x + u1y * u1y)
            number u2x = cx - bx
            number u2y = cy - by
            number l2 = math:SquareRoot(u2x * u2x + u2y * u2y)

            if l1 > 0 and l2 > 0
                // unit directions of two edges
                u1x = u1x / l1
                u1y = u1y / l1
                u2x = u2x / l2
                u2y = u2y / l2
                // left normals
                number n1x = -u1y
                number n1y = u1x
                number n2x = -u2y
                number n2y = u2x
                number turn = u1x * u2y - u1y * u2x
                number dot = u1x * u2x + u1y * u2y

                if dot > 0.99
                    // nearly straight (under 8 degrees): the point where both moved edges meet
                    number f = d / (1.0 + dot)
                    qx:Add(bx + (n1x + n2x) * f)
                    qy:Add(by + (n1y + n2y) * f)
                elseif turn * d >= 0
                    // The moved edges converge. Their mitre point cuts
                    // |d| * tan(turn / 2) off each of them; while that is at
                    // most half of both edges nothing can fold over.
                    boolean foldFree = false
                    if dot > -0.999999
                        number reach = d
                        if reach < 0
                            reach = -reach
                        end
                        number trim = reach * math:SquareRoot((1.0 - dot) / (1.0 + dot))
                        foldFree = trim <= 0.5 * l1 and trim <= 0.5 * l2
                    end
                    if foldFree
                        number f4 = d / (1.0 + dot)
                        qx:Add(bx + (n1x + n2x) * f4)
                        qy:Add(by + (n1y + n2y) * f4)
                    else
                        // back through the corner itself, so a fold winds the other way
                        qx:Add(bx + d * n1x)
                        qy:Add(by + d * n1y)
                        qx:Add(bx)
                        qy:Add(by)
                        qx:Add(bx + d * n2x)
                        qy:Add(by + d * n2y)
                    end
                elseif d > 0 or rounded
                    // the moved edges diverge: round the corner
                    if dot > stepCos
                        number f2 = d / (1.0 + dot)
                        qx:Add(bx + (n1x + n2x) * f2)
                        qy:Add(by + (n1y + n2y) * f2)
                    else
                        // rotate n1 toward n2 the short way: clockwise when the
                        // outline turns right, counter-clockwise when it turns left
                        boolean clockwise = turn < 0
                        number vx = n1x
                        number vy = n1y
                        qx:Add(bx + d * vx)
                        qy:Add(by + d * vy)
                        boolean going = true
                        repeat while going
                            number wx = vx * stepCos - vy * stepSin
                            number wy = vx * stepSin + vy * stepCos
                            boolean before = wx * n2y - wy * n2x > 0
                            if clockwise
                                wx = vx * stepCos + vy * stepSin
                                wy = -vx * stepSin + vy * stepCos
                                before = wx * n2y - wy * n2x < 0
                            end
                            if before
                                qx:Add(bx + d * wx)
                                qy:Add(by + d * wy)
                                vx = wx
                                vy = wy
                            else
                                going = false
                            end
                        end
                        qx:Add(bx + d * n2x)
                        qy:Add(by + d * n2y)
                    end
                else
                    // an outset's convex corner stays sharp: mitred, or a
                    // plain link when sharper than 120 degrees
                    if dot > -0.5
                        number f3 = d / (1.0 + dot)
                        qx:Add(bx + (n1x + n2x) * f3)
                        qy:Add(by + (n1y + n2y) * f3)
                    else
                        qx:Add(bx + d * n1x)
                        qy:Add(by + d * n1y)
                        qx:Add(bx + d * n2x)
                        qy:Add(by + d * n2y)
                    end
                end
            end
            i = i + 1
        end
    end
end
