package Libraries.Fabrication.Geometry

/*
The PathRole class names what a toolpath prints as. PathOrderer stores one of
these constants in each Contour's role, and the G-code writer picks speeds,
accelerations and the ;TYPE: comment from it.

Attribute: Example

    use Libraries.Fabrication.Geometry.Contour
    use Libraries.Fabrication.Geometry.PathRole

    class Main
        action Main
            PathRole roles
            Contour wall
            wall:role = roles:OUTER_WALL
            output roles:GetFeatureName(wall:role)     // WALL-OUTER
        end
    end
*/
class PathRole
    public constant integer OUTER_WALL = 0
    public constant integer INNER_WALL = 1
    /* Solid top / bottom fill, and solid fill in parts too thin for walls. */
    public constant integer SKIN = 2
    /* Sparse infill. */
    public constant integer INFILL = 3
    /* Skirt or brim loops. */
    public constant integer SKIRT = 4
    /* The outline of a support tine or branch. */
    public constant integer SUPPORT_WALL = 5
    /* The lines inside a support tine or branch. */
    public constant integer SUPPORT_FILL = 6
    /*
    Solid fill on a top surface: the layer(s) that nothing is printed on, so
    they stay visible. Printed with their own speed, flow and acceleration.
    */
    public constant integer TOP_SURFACE = 7
    /*
    A second, nearly dry pass over a finished top surface at the same height,
    smoothing it and closing the gaps between its lines.
    */
    public constant integer IRONING = 8

    /*
    Checks whether a role is part of a top surface (its fill or its ironing).

    Attribute: Parameter role One of the constants.
    Attribute: Returns True for TOP_SURFACE and IRONING.

    Attribute: Example

        use Libraries.Fabrication.Geometry.PathRole

        PathRole roles
        output roles:IsTopSurface(roles:IRONING)     // true
        output roles:IsTopSurface(roles:SKIN)        // false
    */
    action IsTopSurface(integer role) returns boolean
        return role = TOP_SURFACE or role = IRONING
    end

    /*
    Checks whether a role is part of the support.

    Attribute: Parameter role One of the constants.
    Attribute: Returns True for SUPPORT_WALL and SUPPORT_FILL.

    Attribute: Example

        use Libraries.Fabrication.Geometry.PathRole

        PathRole roles
        output roles:IsSupport(roles:SUPPORT_FILL)     // true
        output roles:IsSupport(roles:INFILL)           // false
    */
    action IsSupport(integer role) returns boolean
        return role = SUPPORT_WALL or role = SUPPORT_FILL
    end

    /*
    The feature name G-code previewers colour by (Cura's ;TYPE: names).
    Cura has no separate names for top surfaces or ironing (it marks both
    SKIN), so TOP_SURFACE and IRONING are SKIN here too.

    Attribute: Parameter role One of the constants.
    Attribute: Returns The name; "FILL" for sparse infill and for anything unknown.

    Attribute: Example

        use Libraries.Fabrication.Geometry.PathRole

        PathRole roles
        output roles:GetFeatureName(roles:OUTER_WALL)     // WALL-OUTER
    */
    action GetFeatureName(integer role) returns text
        if role = OUTER_WALL
            return "WALL-OUTER"
        elseif role = INNER_WALL
            return "WALL-INNER"
        elseif role = SKIN or IsTopSurface(role)
            return "SKIN"
        elseif role = SKIRT
            return "SKIRT"
        elseif IsSupport(role)
            return "SUPPORT"
        end
        return "FILL"
    end

    /*
    The feature name Bambu Studio's G-code preview colours by (its
    "; FEATURE: " comments, the names of its extrusion roles). Solid fill
    (SKIN) is "Internal solid infill" here; GcodeWriter names its first-layer
    and gap-filling lines "Bottom surface" and "Gap infill" itself, as only
    it knows which they are.

    Attribute: Parameter role One of the constants.
    Attribute: Returns The name; "Sparse infill" for sparse infill and for anything unknown.

    Attribute: Example

        use Libraries.Fabrication.Geometry.PathRole

        PathRole roles
        output roles:GetBambuFeatureName(roles:OUTER_WALL)     // Outer wall
    */
    action GetBambuFeatureName(integer role) returns text
        if role = OUTER_WALL
            return "Outer wall"
        elseif role = INNER_WALL
            return "Inner wall"
        elseif role = SKIN
            return "Internal solid infill"
        elseif role = TOP_SURFACE
            return "Top surface"
        elseif role = IRONING
            return "Ironing"
        elseif role = SKIRT
            return "Skirt"
        elseif IsSupport(role)
            return "Support"
        end
        return "Sparse infill"
    end
end
