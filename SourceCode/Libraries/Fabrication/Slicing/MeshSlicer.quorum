package Libraries.Fabrication.Slicing

use Libraries.Containers.Array
use Libraries.Containers.Number64BitArray
use Libraries.Containers.Integer32BitArray
use Libraries.Compute.Math
use Libraries.Fabrication.ArgumentChecker
use Libraries.Fabrication.Geometry.GeometryUtilities
use Libraries.Fabrication.Geometry.PointIndex
use Libraries.Fabrication.Geometry.TriangleMesh
use Libraries.Data.Containers.NumberBuffer
use Libraries.Data.Containers.IntegerBuffer

/*
The MeshSlicer class cuts a triangle mesh into horizontal slices. SetTriangles
takes the mesh, turns it so its largest flat face is on the bed (unless
SetAutoOrient is off), applies any rotation from SetRotation, scales it to
millimetres and moves its lowest point to Z = 0. Slice then cuts every
triangle with every plane it spans, giving one Segment per cut, ready for
ContourGenerator to join into loops. The planes can be any heights in
ascending order: evenly spaced from BuildPlanes, or uneven (a different first
layer, variable layer heights).

Warnings about the model (a size that suggests the wrong units, a model
larger than the bed) are collected in GetWarnings rather
than printed.

Attribute: Example

    use Libraries.Containers.Array
    use Libraries.Fabrication.Geometry.TriangleMesh
    use Libraries.Fabrication.Slicing.MeshSlicer
    use Libraries.Fabrication.Slicing.Segment
    use Libraries.Data.Containers.NumberBuffer

    class Main
        action Main
            TriangleMesh mesh       // filled with mesh:Load(modelData)
            MeshSlicer slicer
            slicer:SetTriangles(mesh)
            NumberBuffer range = slicer:GetSliceRange()
            NumberBuffer planes = slicer:BuildPlanes(range:Get(0), range:Get(1), 0.2)
            Array<Segment> segments = slicer:Slice(planes)
        end
    end
*/
class MeshSlicer
    Number64BitArray vertX
    Number64BitArray vertY
    Number64BitArray vertZ
    Integer32BitArray faceCorners
    boolean loaded = false

    IntegerBuffer mergedIds
    integer uniqueVertices = 0

    number unitScale = 1.0
    number forcedUnitScale = 0.0
    number bedSize = 220.0
    integer baseDirection = 4
    boolean autoOrient = true
    // a side of the bounding box can be the base only if the triangles lying
    // flat on it cover at least this share of that side
    number minBaseShare = 0.05
    // the turn SetRotation asks for, in degrees about X, then Y, then Z
    number rotationX = 0.0
    number rotationY = 0.0
    number rotationZ = 0.0
    Array<text> warnings

    number minX = 0.0
    number maxX = 0.0
    number minY = 0.0
    number maxY = 0.0
    number minZ = 0.0
    number maxZ = 0.0

    Math math
    GeometryUtilities util
    ArgumentChecker checker

    /*
    The factor that turns the model's units into millimetres: 25.4 for a
    file in inches, 1 for millimetres. 0 (the default) guesses it from the
    model's size.

    Attribute: Parameter scale The factor, or 0 to detect it.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetUnitScale(25.4)      // the file is in inches
        slicer:SetTriangles(mesh)
    */
    action SetUnitScale(number scale)
        checker:RequireAtLeast("MeshSlicer:SetUnitScale scale", scale, 0)
        forcedUnitScale = scale
    end

    /*
    The largest side of the bed (mm), to warn about models exported in the
    wrong units.

    Attribute: Parameter size The bed size (mm).

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetBedSize(256)      // warn about models bigger than a Bambu P2S bed
        slicer:SetTriangles(mesh)
    */
    action SetBedSize(number size)
        checker:RequirePositive("MeshSlicer:SetBedSize size", size)
        bedSize = size
    end

    /*
    Whether SetTriangles turns the model so its largest flat face is on the
    bed (on by default). Off keeps the orientation the file has, with -Z down.

    Attribute: Parameter toggle True to turn the model onto its base.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetAutoOrient(false)     // the file is already the right way up
        slicer:SetTriangles(mesh)
    */
    action SetAutoOrient(boolean toggle)
        autoOrient = toggle
    end

    /*
    How much of a side of the model's bounding box the triangles lying flat on
    it must cover for that side to be chosen as the base (0.05, a twentieth,
    by default). It keeps a model with no flat bottom from being turned onto
    a tiny flat spot somewhere else; such a model stays as the file has it.

    Attribute: Parameter share The share, from 0 to 1.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetMinBaseShare(0.2)     // only turn the model onto a large flat side
        slicer:SetTriangles(mesh)
    */
    action SetMinBaseShare(number share)
        checker:RequireRange("MeshSlicer:SetMinBaseShare share", share, 0, 1)
        minBaseShare = share
    end

    /*
    Turns the model by these angles (degrees) when SetTriangles copies it:
    first about the X axis, then Y, then Z, each counter-clockwise when
    looking down that axis toward the origin (so X 90 tips the top of the
    model toward -Y, and Z 90 turns it a quarter turn to the left on the
    bed). The turn comes after auto-orient has put the model on its base, so
    Z turns it on the bed and X or Y tip it onto another side; with
    SetAutoOrient(false) it turns the model from the file's orientation.

    Attribute: Parameter xDegrees The turn about X, -360 to 360.
    Attribute: Parameter yDegrees The turn about Y, -360 to 360.
    Attribute: Parameter zDegrees The turn about Z, -360 to 360.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetRotation(0, 0, 45)    // turn it 45 degrees on the bed
        slicer:SetTriangles(mesh)
    */
    action SetRotation(number xDegrees, number yDegrees, number zDegrees)
        checker:RequireRange("MeshSlicer:SetRotation xDegrees", xDegrees, -360, 360)
        checker:RequireRange("MeshSlicer:SetRotation yDegrees", yDegrees, -360, 360)
        checker:RequireRange("MeshSlicer:SetRotation zDegrees", zDegrees, -360, 360)
        rotationX = xDegrees
        rotationY = yDegrees
        rotationZ = zDegrees
    end

    /*
    Takes the triangles to slice: copies them turned so the base faces down
    (SetAutoOrient), turned by SetRotation, scaled to millimetres and resting
    on Z = 0, and merges vertices that sit at exactly the same spot (so
    neighbouring triangles share edges).

    Attribute: Parameter mesh The loaded mesh.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        output "The model's base faced " + slicer:GetBaseDirection()
    */
    action SetTriangles(TriangleMesh mesh)
        Number64BitArray srcX = mesh:GetVertexX()
        Number64BitArray srcY = mesh:GetVertexY()
        Number64BitArray srcZ = mesh:GetVertexZ()
        faceCorners = mesh:GetCorners()
        integer count = srcX:GetSize()
        if count = 0 or mesh:GetTriangleCount() = 0
            alert("MeshSlicer:SetTriangles was given a mesh with no triangles. Call TriangleMesh:Load with the model first.")
        end
        warnings:Empty()

        ComputeBounds(srcX, srcY, srcZ)
        baseDirection = 4
        if autoOrient
            baseDirection = FindBaseDirection(srcX, srcY, srcZ)
        end
        unitScale = DetectUnitScale()

        // copy into our own arrays, rotated so the base faces -Z
        Number64BitArray newX
        Number64BitArray newY
        Number64BitArray newZ
        newX:SetSize(count)
        newY:SetSize(count)
        newZ:SetSize(count)
        vertX = newX
        vertY = newY
        vertZ = newZ

        integer i = 0
        repeat while i < count
            number x = srcX:Get(i) * unitScale
            number y = srcY:Get(i) * unitScale
            number z = srcZ:Get(i) * unitScale

            if baseDirection = 4         // base faces -Z: already upright
                vertX:Set(i, x)
                vertY:Set(i, y)
                vertZ:Set(i, z)
            elseif baseDirection = 5     // base faces +Z: upside down
                vertX:Set(i, x)
                vertY:Set(i, -y)
                vertZ:Set(i, -z)
            elseif baseDirection = 2     // base faces -Y: Y is up
                vertX:Set(i, x)
                vertY:Set(i, -z)
                vertZ:Set(i, y)
            elseif baseDirection = 3     // base faces +Y
                vertX:Set(i, x)
                vertY:Set(i, z)
                vertZ:Set(i, -y)
            elseif baseDirection = 0     // base faces -X: X is up
                vertX:Set(i, -z)
                vertY:Set(i, y)
                vertZ:Set(i, x)
            else                         // base faces +X
                vertX:Set(i, z)
                vertY:Set(i, y)
                vertZ:Set(i, -x)
            end
            i = i + 1
        end

        if rotationX not= 0 or rotationY not= 0 or rotationZ not= 0
            Rotate(count)
        end

        // shift so the lowest point is at Z = 0
        number lowZ = vertZ:Get(0)
        i = 1
        repeat while i < count
            lowZ = util:Min2(lowZ, vertZ:Get(i))
            i = i + 1
        end
        i = 0
        repeat while i < count
            vertZ:Set(i, vertZ:Get(i) - lowZ)
            i = i + 1
        end

        // merge vertices that sit at exactly the same position: (x, y) gets
        // a number, then (that number, z) does, so each distinct (x, y, z)
        // gets one. PointIndex matches numbers the way the text keys
        // "" + x + "_" + y + "_" + z used to, without formatting each one.
        PointIndex flat
        PointIndex points
        IntegerBuffer firstVertex       // per distinct point: the first vertex there
        mergedIds:Empty()
        mergedIds:Reserve(count)        // one per vertex: size it once instead of doubling
        integer v = 0
        repeat while v < count
            integer xy = flat:IdOf(vertX:Get(v), vertY:Get(v))
            integer point = points:IdOf(cast(number, xy), vertZ:Get(v))
            if point = firstVertex:GetSize()
                firstVertex:Add(v)
            end
            mergedIds:Add(firstVertex:Get(point))
            v = v + 1
        end
        uniqueVertices = points:GetSize()
        loaded = true
    end

    /*
    The lowest and highest Z of the mesh after SetTriangles (mm).

    Attribute: Returns An array of two numbers: the lowest Z, then the highest.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer
        use Libraries.Data.Containers.NumberBuffer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        NumberBuffer range = slicer:GetSliceRange()
        output "The model is " + (range:Get(1) - range:Get(0)) + " mm tall"
    */
    action GetSliceRange returns NumberBuffer
        RequireLoaded("GetSliceRange")
        NumberBuffer range
        number low = vertZ:Get(0)
        number high = low
        integer i = 1
        repeat while i < vertZ:GetSize()
            low = util:Min2(low, vertZ:Get(i))
            high = util:Max2(high, vertZ:Get(i))
            i = i + 1
        end
        range:Add(low)
        range:Add(high)
        return range
    end

    /*
    The heights to slice at: the middle of each layer from zMin up to zMax.

    Attribute: Parameter zMin The bottom of the first layer (mm).
    Attribute: Parameter zMax The top of the model (mm).
    Attribute: Parameter delta The layer height (mm).
    Attribute: Returns One plane height per layer, from the bottom up.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer
        use Libraries.Data.Containers.NumberBuffer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        NumberBuffer planes = slicer:BuildPlanes(0, 20, 0.2)
        output planes:Get(0)       // 0.1, the middle of the first layer
    */
    action BuildPlanes(number zMin, number zMax, number delta) returns NumberBuffer
        checker:RequirePositive("MeshSlicer:BuildPlanes layer height", delta)
        NumberBuffer planes
        number firstPlaneZ = zMin + delta / 2.0

        integer i = 0
        repeat while firstPlaneZ + i * delta < zMax
            planes:Add(firstPlaneZ + i * delta)
            i = i + 1
        end
        if planes:GetSize() = 0
            alert("The model is too flat to slice: it is " + (zMax - zMin) + " mm tall above the cut, less than half a " + delta + " mm layer.")
        end
        return planes
    end

    /*
    Cuts every triangle with every plane it spans. The planes may be any
    heights, evenly spaced or not, as long as they go up (each higher than the
    one before). A triangle crosses a plane
    on two of its edges or none (each corner is either below the plane or at
    or above it, and a loop of three corners changes side an even number of
    times), so each cut gives one Segment. Holes in the mesh show up later,
    as chains ContourGenerator can't close.

    Attribute: Parameter planeZ The plane heights in ascending order, such as BuildPlanes gives.
    Attribute: Returns The segments of every plane, in no particular order.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer
        use Libraries.Fabrication.Slicing.Segment
        use Libraries.Data.Containers.NumberBuffer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        NumberBuffer range = slicer:GetSliceRange()
        NumberBuffer planes = slicer:BuildPlanes(range:Get(0), range:Get(1), 0.2)
        Array<Segment> segments = slicer:Slice(planes)
        output segments:GetSize() + " segments on " + planes:GetSize() + " planes"
    */
    action Slice(NumberBuffer planeZ) returns Array<Segment>
        RequireLoaded("Slice")
        integer planeCount = planeZ:GetSize()
        integer next = 1
        repeat while next < planeCount
            if not (planeZ:Get(next) > planeZ:Get(next - 1))
                alert("MeshSlicer:Slice needs the plane heights in ascending order, but plane " + next + " (" + planeZ:Get(next)
                    + " mm) is not above plane " + (next - 1) + " (" + planeZ:Get(next - 1) + " mm).")
            end
            next = next + 1
        end
        Array<Segment> result

        integer cornersPerFace = 3
        // one crossing per triangle edge at most, so a few are made once and
        // CollectCrossings overwrites them for every triangle and plane
        Array<SliceCrossing> crossings
        integer spare = 0
        repeat while spare < cornersPerFace
            SliceCrossing crossing
            crossings:Add(crossing)
            spare = spare + 1
        end
        integer faceCount = GetFaceCount()

        integer f = 0
        repeat while f < faceCount
            number zMin = vertZ:Get(GetCorner(f, 0))
            number zMax = zMin
            integer c = 1
            repeat while c < cornersPerFace
                number z = vertZ:Get(GetCorner(f, c))
                zMin = util:Min2(zMin, z)
                zMax = util:Max2(zMax, z)
                c = c + 1
            end

            // only the planes from the triangle's lowest corner up to its
            // highest can cut it (a corner at a plane's height counts as
            // above it, so a plane at zMin cuts nothing, one at zMax can)
            integer i = FirstPlaneAtOrAbove(planeZ, zMin)
            repeat while i < planeCount and planeZ:Get(i) <= zMax
                if CollectCrossings(f, cornersPerFace, planeZ:Get(i), crossings) = 2
                    EmitSegment(crossings, i, result)
                end
                i = i + 1
            end
            f = f + 1
        end
        return result
    end

    /*
    The factor SetTriangles scaled the model by (25.4 for inches, 1000 for metres, 1 for millimetres).

    Attribute: Returns The factor SetTriangles scaled the model by (25.4 for inches, 1000 for metres, 1 for millimetres).

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        output "Scaled by " + slicer:GetUnitScale()      // 25.4 for a model in inches
    */
    action GetUnitScale returns number
        return unitScale
    end

    /*
    How many distinct vertex positions the mesh has after merging duplicates.

    Attribute: Returns How many distinct vertex positions the mesh has after merging duplicates.

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        output slicer:GetUniqueVertexCount() + " vertices after merging duplicates"
    */
    action GetUniqueVertexCount returns integer
        return uniqueVertices
    end

    /*
    Which way the model's base faced in the file.

    Attribute: Returns One of "-X", "+X", "-Y", "+Y", "-Z" (already upright) or "+Z".

    Attribute: Example

        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        if slicer:GetBaseDirection() not= "-Z"
            output "The model was turned upright."
        end
    */
    action GetBaseDirection returns text
        if baseDirection = 0
            return "-X"
        elseif baseDirection = 1
            return "+X"
        elseif baseDirection = 2
            return "-Y"
        elseif baseDirection = 3
            return "+Y"
        elseif baseDirection = 5
            return "+Z"
        end
        return "-Z"
    end

    /*
    Warnings from the last SetTriangles and Slice, as sentences.

    Attribute: Returns Warnings from the last SetTriangles and Slice, as sentences.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.TriangleMesh
        use Libraries.Fabrication.Slicing.MeshSlicer
        use Libraries.Fabrication.Slicing.Segment
        use Libraries.Data.Containers.NumberBuffer

        TriangleMesh mesh       // filled with mesh:Load(modelData)
        MeshSlicer slicer
        slicer:SetTriangles(mesh)
        NumberBuffer range = slicer:GetSliceRange()
        NumberBuffer planes = slicer:BuildPlanes(range:Get(0), range:Get(1), 0.2)
        Array<Segment> segments = slicer:Slice(planes)
        Array<text> warnings = slicer:GetWarnings()
        integer i = 0
        repeat while i < warnings:GetSize()
            output "warning: " + warnings:Get(i)
            i = i + 1
        end
    */
    action GetWarnings returns Array<text>
        return warnings
    end

    private action RequireLoaded(text actionName)
        if not loaded
            alert("MeshSlicer:" + actionName + " was called before SetTriangles.")
        end
    end

    private action GetFaceCount returns integer
        return faceCorners:GetSize() / 3
    end

    private action GetCorner(integer f, integer j) returns integer
        return faceCorners:Get(3 * f + j)
    end

    // Adds up, for each of the six sides of the bounding box, the area of
    // the triangles lying flat on it, and picks the side with the most as
    // the base. The current bottom (-Z) wins unless another side has 20%
    // more, and a side whose flat triangles cover less than minBaseShare of
    // it can't win (a sliver of flat surface on a curved model is no base).
    // Returns 0..5 for -X, +X, -Y, +Y, -Z, +Z.
    private action FindBaseDirection(Number64BitArray x, Number64BitArray y, Number64BitArray z) returns integer
        number eps = 0.002 * util:Max2(maxX - minX, util:Max2(maxY - minY, maxZ - minZ))

        NumberBuffer area
        integer i = 0
        repeat while i < 6
            area:Add(0.0)
            i = i + 1
        end

        integer f = 0
        repeat while f < GetFaceCount()
            integer i0 = GetCorner(f, 0)
            integer i1 = GetCorner(f, 1)
            integer i2 = GetCorner(f, 2)
            number ax = x:Get(i1) - x:Get(i0)
            number ay = y:Get(i1) - y:Get(i0)
            number az = z:Get(i1) - z:Get(i0)
            number bx = x:Get(i2) - x:Get(i0)
            number by = y:Get(i2) - y:Get(i0)
            number bz = z:Get(i2) - z:Get(i0)

            // face normal = cross product of two edges; its length is twice the area
            number nx = ay * bz - az * by
            number ny = az * bx - ax * bz
            number nz = ax * by - ay * bx
            number len = math:SquareRoot(nx * nx + ny * ny + nz * nz)

            if len > 0
                number faceArea = len / 2.0
                nx = nx / len
                ny = ny / len
                nz = nz / len
                number loX = util:Min2(x:Get(i0), util:Min2(x:Get(i1), x:Get(i2)))
                number hiX = util:Max2(x:Get(i0), util:Max2(x:Get(i1), x:Get(i2)))
                number loY = util:Min2(y:Get(i0), util:Min2(y:Get(i1), y:Get(i2)))
                number hiY = util:Max2(y:Get(i0), util:Max2(y:Get(i1), y:Get(i2)))
                number loZ = util:Min2(z:Get(i0), util:Min2(z:Get(i1), z:Get(i2)))
                number hiZ = util:Max2(z:Get(i0), util:Max2(z:Get(i1), z:Get(i2)))

                if nx < -0.99 and hiX <= minX + eps
                    area:Set(0, area:Get(0) + faceArea)
                end
                if nx > 0.99 and loX >= maxX - eps
                    area:Set(1, area:Get(1) + faceArea)
                end
                if ny < -0.99 and hiY <= minY + eps
                    area:Set(2, area:Get(2) + faceArea)
                end
                if ny > 0.99 and loY >= maxY - eps
                    area:Set(3, area:Get(3) + faceArea)
                end
                if nz < -0.99 and hiZ <= minZ + eps
                    area:Set(4, area:Get(4) + faceArea)
                end
                if nz > 0.99 and loZ >= maxZ - eps
                    area:Set(5, area:Get(5) + faceArea)
                end
            end
            f = f + 1
        end

        // the area of each side of the bounding box
        number sizeX = maxX - minX
        number sizeY = maxY - minY
        number sizeZ = maxZ - minZ
        NumberBuffer sideArea
        sideArea:Add(sizeY * sizeZ)
        sideArea:Add(sizeY * sizeZ)
        sideArea:Add(sizeX * sizeZ)
        sideArea:Add(sizeX * sizeZ)
        sideArea:Add(sizeX * sizeY)
        sideArea:Add(sizeX * sizeY)

        integer base = 4
        i = 0
        repeat while i < 6
            if area:Get(i) >= minBaseShare * sideArea:Get(i) and area:Get(i) > area:Get(base) * 1.2
                base = i
            end
            i = i + 1
        end
        return base
    end

    // The index of the first plane at or above z (planes ascending), or the
    // plane count if every plane is below z.
    private action FirstPlaneAtOrAbove(NumberBuffer planes, number z) returns integer
        integer low = 0
        integer high = planes:GetSize()
        repeat while low < high
            integer middle = (low + high) / 2
            if planes:Get(middle) < z
                low = middle + 1
            else
                high = middle
            end
        end
        return low
    end

    // Turns the first count vertices by SetRotation's angles: about X, then
    // Y, then Z (the matrix Rz * Ry * Rx). Sines and cosines within 10^-12 of
    // 0 or 1 are made exact, so quarter turns move vertices exactly.
    private action Rotate(integer count)
        number toRadians = math:pi / 180.0
        number cx = Exact(math:Cosine(rotationX * toRadians))
        number sx = Exact(math:Sine(rotationX * toRadians))
        number cy = Exact(math:Cosine(rotationY * toRadians))
        number sy = Exact(math:Sine(rotationY * toRadians))
        number cz = Exact(math:Cosine(rotationZ * toRadians))
        number sz = Exact(math:Sine(rotationZ * toRadians))

        number m00 = cz * cy
        number m01 = cz * sy * sx - sz * cx
        number m02 = cz * sy * cx + sz * sx
        number m10 = sz * cy
        number m11 = sz * sy * sx + cz * cx
        number m12 = sz * sy * cx - cz * sx
        number m20 = 0.0 - sy
        number m21 = cy * sx
        number m22 = cy * cx

        integer i = 0
        repeat while i < count
            number x = vertX:Get(i)
            number y = vertY:Get(i)
            number z = vertZ:Get(i)
            vertX:Set(i, m00 * x + m01 * y + m02 * z)
            vertY:Set(i, m10 * x + m11 * y + m12 * z)
            vertZ:Set(i, m20 * x + m21 * y + m22 * z)
            i = i + 1
        end
    end

    // v, with values within 10^-12 of 0, 1 or -1 made exactly that
    private action Exact(number v) returns number
        if v > -0.000000000001 and v < 0.000000000001
            return 0.0
        elseif v > 0.999999999999
            return 1.0
        elseif v < -0.999999999999
            return -1.0
        end
        return v
    end

    private action ComputeBounds(Number64BitArray x, Number64BitArray y, Number64BitArray z)
        minX = x:Get(0)
        maxX = minX
        minY = y:Get(0)
        maxY = minY
        minZ = z:Get(0)
        maxZ = minZ
        integer i = 1
        repeat while i < x:GetSize()
            minX = util:Min2(minX, x:Get(i))
            maxX = util:Max2(maxX, x:Get(i))
            minY = util:Min2(minY, y:Get(i))
            maxY = util:Max2(maxY, y:Get(i))
            minZ = util:Min2(minZ, z:Get(i))
            maxZ = util:Max2(maxZ, z:Get(i))
            i = i + 1
        end
    end

    // The unit scale to use: the forced one if set, otherwise a guess from
    // the model's largest extent (under 1 unit across means metres).
    private action DetectUnitScale returns number
        if forcedUnitScale > 0
            return forcedUnitScale
        end

        number extent = util:Max2(maxX - minX, util:Max2(maxY - minY, maxZ - minZ))
        if extent <= 0
            warnings:Add("The model has no size (every vertex is at the same point).")
            return 1.0
        elseif extent < 1.0
            warnings:Add("The model is only " + extent + " units across, so its units are taken to be metres (scaled by 1000). Set unitScale to override.")
            return 1000.0
        elseif extent < 10.0
            warnings:Add("The model is only " + extent + " mm across. If it was exported in inches, set unitScale to 25.4.")
        elseif extent > bedSize
            warnings:Add("The model is " + extent + " mm across, larger than the " + bedSize + " mm bed. Check the units it was exported in.")
        end
        return 1.0
    end

    // walks the edges of triangle f and records every edge that has
    // one end below the plane and the other at or above it, overwriting
    // the first crossings in result (which holds one per edge); returns
    // how many it filled in
    private action CollectCrossings(integer f, integer cornersPerFace, number planeValue,
                                    Array<SliceCrossing> result) returns integer
        integer count = 0
        integer j = 0
        repeat while j < cornersPerFace
            integer k = j + 1
            if k = cornersPerFace
                k = 0
            end
            integer va = mergedIds:Get(GetCorner(f, j))
            integer vb = mergedIds:Get(GetCorner(f, k))
            boolean aBelow = vertZ:Get(va) < planeValue
            boolean bBelow = vertZ:Get(vb) < planeValue

            if aBelow not= bBelow
                // Always interpolate from the lower vertex id to the higher
                // one. The neighbouring triangle walks this edge the other
                // way, and this makes both get bit-identical coordinates.
                integer low = va
                integer high = vb
                if vb < va
                    low = vb
                    high = va
                end

                // t = how far along the edge (0..1) the plane sits
                number t = (planeValue - vertZ:Get(low)) / (vertZ:Get(high) - vertZ:Get(low))

                SliceCrossing point = result:Get(count)
                point:x = vertX:Get(low) + t * (vertX:Get(high) - vertX:Get(low))
                point:y = vertY:Get(low) + t * (vertY:Get(high) - vertY:Get(low))
                point:edgeLow = low
                point:edgeHigh = high
                point:rising = aBelow
                count = count + 1
            end
            j = j + 1
        end
        return count
    end

    // Turns a triangle's two crossings into a segment. The rising crossing
    // is always the end, so every segment runs the same way around the
    // solid and the chained loops come out consistently oriented.
    private action EmitSegment(Array<SliceCrossing> points, integer planeIndex, Array<Segment> result)
        SliceCrossing from = points:Get(0)
        SliceCrossing to = points:Get(1)
        if from:rising
            from = points:Get(1)
            to = points:Get(0)
        end

        Segment s
        s:planeIndex = planeIndex
        s:x0 = from:x
        s:y0 = from:y
        s:x1 = to:x
        s:y1 = to:y
        s:aLow = from:edgeLow
        s:aHigh = from:edgeHigh
        s:bLow = to:edgeLow
        s:bHigh = to:edgeHigh
        result:Add(s)
    end
end
