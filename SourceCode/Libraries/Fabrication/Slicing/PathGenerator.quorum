package Libraries.Fabrication.Slicing

use Libraries.Containers.Array
use Libraries.Compute.Math
use Libraries.Fabrication.ArgumentChecker
use Libraries.Fabrication.Geometry.Contour
use Libraries.Fabrication.Geometry.ContourLayers
use Libraries.Fabrication.Geometry.GeometryUtilities
use Libraries.Fabrication.Geometry.LineFill
use Libraries.Fabrication.Geometry.PolygonOffsetter
use Libraries.Fabrication.Geometry.PolygonOperations
use Libraries.Fabrication.Geometry.PointIndex
use Libraries.Fabrication.Slicing.AdaptivePath
use Libraries.Data.Containers.NumberBuffer
use Libraries.Data.Containers.IntegerBuffer

/*
The PathGenerator class turns each layer's outlines into toolpaths: walls
(loops following the outline, wallIndex 0 outermost), skin (solid fill
under top surfaces and over bottom surfaces) and sparse infill. Parts too
thin for a wall get a single center line, and bands too thin for an inner
wall get solid lines, so nothing thin prints hollow.

Optionally, the solid fill of top surfaces is kept apart (GetTopSurface) so
it can be printed differently, and top surfaces can be ironed (GetIroning).

The paths are not in printing order yet; PathOrderer does that.

Attribute: Example

    use Libraries.Containers.Array
    use Libraries.Fabrication.Geometry.Contour
    use Libraries.Fabrication.Slicing.PathGenerator

    class Main
        action Main
            Array<Contour> outlines     // from ContourGenerator:Build
            PathGenerator paths
            paths:SetLineWidth(0.4)
            paths:SetWallCount(3)
            paths:SetInfillDensity(0.15)
            paths:Generate(outlines, 100)
            Array<Contour> walls = paths:GetWalls()
        end
    end
*/
class PathGenerator
    number lineWidth = 0.4
    integer wallCount = 2
    number infillDensity = 0.2
    number infillOverlap = 0.25
    // adaptive planes only: how far fill reaches into the innermost adaptive wall, as a fraction of the
    // line width. Negative leaves a gap. Uniform planes never read this.
    number adaptiveFillOverlap = 0.25
    number minInfillLength = 0.4
    // shortest tip dot worth printing (mm); anything smaller is a speck
    number minDotLength = 0.1
    // layer 0's solid fill is printed as continuous zigzags (no loose line
    // ends that can peel off the bed)
    boolean joinFirstLayer = true
    // solid fill (skin) and sparse infill on every layer are chained into
    // zigzags too: fewer starts, stops and jumps per layer
    boolean joinSkin = false
    boolean joinInfill = false
    integer topLayers = 4
    integer bottomLayers = 4
    // solid fill within this many layers of a top surface is kept apart as
    // top surface (0 = off: it is ordinary skin)
    integer topSurfaceLayers = 0
    // ironing: a second pass over every top surface, lines this far apart,
    // kept this far in from the surface's edge (mm)
    boolean ironing = false
    number ironingSpacing = 0.1
    number ironingInset = 0.2
    // gap fill: bands inside the innermost wall too narrow for fill lines
    // (thin walls a bit wider than the walls themselves) get solid lines
    boolean gapFill = true
    boolean adaptive = false
    AdaptivePath arachne
    // 1 if adaptive wall, 0 when uniform
    IntegerBuffer planeAdaptive
    integer adaptiveFallbacks = 0
    integer adaptiveClamped = 0     // adaptive bead points printed at the widest allowed width instead of wider

    Array<Contour> walls
    Array<Contour> skin
    Array<Contour> infill
    Array<Contour> topSurface
    Array<Contour> ironingLines
    // gap-filled bands of each plane (gapAreas[gapStart[p] ... gapStart[p + 1]]),
    // kept out of that plane's fill
    Array<Contour> gapAreas
    IntegerBuffer gapStart

    // the outlines being processed, grouped by plane
    ContourLayers modelLayers

    // area left inside the walls on each plane (inner[innerStart[p] ... inner[innerStart[p + 1]]])
    Array<Contour> inner
    IntegerBuffer innerStart

    integer planeTotal = 0

    // inset loops thrown away because they didn't fit inside the part
    integer droppedLoops = 0
    // islands whose inset was rebuilt exactly (see ExactInset)
    integer rebuiltIslands = 0
    // inset loops kept after cutting off their spurs (see TrimmedLoop)
    integer trimmedLoops = 0
    // print how far Generate has got (SetProgress)
    boolean progress = false

    // FitInset results for the plane being worked on, by depth (see CachedFitInset)
    NumberBuffer cacheDepth
    IntegerBuffer cacheStart
    IntegerBuffer cacheCount
    Array<Contour> cacheLoops

    // scratch points for AddEdgeBands
    NumberBuffer bandX
    NumberBuffer bandY
    number cos30 = 0.8660254037844386
    number sin30 = 0.5
    // plane being worked on (PolygonOperations calls take it)
    integer plane = 0

    Math math
    PolygonOffsetter offsetter

    // The outline FitInset is insetting, indexed once per call for LoopFits
    // and TrimmedLoop (BuildFitIndex): its edges, from the point before to the
    // point (as CloserThan and ContainsPoint take them), in grid cells a
    // little over the distance limit wide, and in horizontal bands.
    number fitLimit = 0.0
    NumberBuffer fitAX
    NumberBuffer fitAY
    NumberBuffer fitBX
    NumberBuffer fitBY
    number fitOriginX = 0.0
    number fitOriginY = 0.0
    number fitCell = 1.0
    PointIndex fitCells
    IntegerBuffer fitCellFirst      // per cell: its first entry, -1 if none
    IntegerBuffer fitEntryEdge      // per entry: an edge passing through the cell
    IntegerBuffer fitEntryNext      // per entry: the cell's next entry, -1 at the end
    IntegerBuffer fitLongEdges      // edges spanning too many cells, checked for every point
    integer fitBandCount = 0
    number fitBandMin = 0.0
    number fitBandHeight = 1.0
    IntegerBuffer fitBandStart      // per band: where its edges start in fitBandEdges
    IntegerBuffer fitBandEdges

    // The same outline's islands (BuildIslandIndex): per loop, 1 if it is a
    // hole (as IsHole says), its area (as SignedArea2, made positive) and its
    // bounding box, for OwnerIsland and IslandWithHoles.
    IntegerBuffer fitHole
    NumberBuffer fitLoopArea
    NumberBuffer fitBoxMinX
    NumberBuffer fitBoxMinY
    NumberBuffer fitBoxMaxX
    NumberBuffer fitBoxMaxY
    PolygonOperations ops
    GeometryUtilities util
    LineFill lineFill
    ArgumentChecker checker

    action SetAdaptive(boolean bool)
        adaptive = bool
    end

    // Diagnostic: the adaptive walls by kind, and for every open wall's end, the distance to the nearest end of
    // another open adaptive wall with the same bead index on the same plane.
    private action ReportAdaptiveWalls()
        integer closedCount = 0
        integer openCount = 0
        integer shortOpen = 0
        integer outerOpen = 0
        integer nearlyClosed = 0
        integer gapSnap = 0
        integer gapSmall = 0
        integer gapWidth = 0
        integer gapFar = 0
        integer i = 0
        repeat while i < walls:GetSize()
            Contour w = walls:Get(i)
            if w:IsAdaptive() and w:GetSize() >= 2
                if w:closed
                    closedCount = closedCount + 1
                else
                    openCount = openCount + 1
                    if util:PathLength(w) < 1.0
                        shortOpen = shortOpen + 1
                    end
                    if w:wallIndex = 0
                        outerOpen = outerOpen + 1
                    end
                    integer last = w:GetSize() - 1
                    if Gap(w:xs:Get(0), w:ys:Get(0), w:xs:Get(last), w:ys:Get(last)) < 0.4
                        nearlyClosed = nearlyClosed + 1
                    end
                    integer side = 0
                    repeat while side < 2
                        integer k = 0
                        if side = 1
                            k = last
                        end
                        number d = NearestOpenEnd(i, w:xs:Get(k), w:ys:Get(k))
                        if d < 0.02
                            gapSnap = gapSnap + 1
                        elseif d < 0.1
                            gapSmall = gapSmall + 1
                        elseif d < 0.4
                            gapWidth = gapWidth + 1
                        else
                            gapFar = gapFar + 1
                        end
                        side = side + 1
                    end
                end
            end
            i = i + 1
        end
        output "adaptive walls: closed " + closedCount + ", open " + openCount + " (outer " + outerOpen
            + ", shorter than 1 mm " + shortOpen + ", own ends within 0.4 mm " + nearlyClosed + ")"
        output "open ends to the nearest other open end of the same index: under 0.02 mm " + gapSnap
            + ", 0.02-0.1 " + gapSmall + ", 0.1-0.4 " + gapWidth + ", farther " + gapFar
    end

    private action Gap(number ax, number ay, number bx, number by) returns number
        return math:SquareRoot((ax - bx) * (ax - bx) + (ay - by) * (ay - by))
    end

    private action NearestOpenEnd(integer self, number x, number y) returns number
        Contour mine = walls:Get(self)
        number best = 1000000.0
        integer j = 0
        repeat while j < walls:GetSize()
            if j not= self
                Contour o = walls:Get(j)
                if o:IsAdaptive() and not o:closed and o:GetSize() >= 2 and o:planeIndex = mine:planeIndex and o:wallIndex = mine:wallIndex
                    number a = Gap(x, y, o:xs:Get(0), o:ys:Get(0))
                    number b = Gap(x, y, o:xs:Get(o:GetSize() - 1), o:ys:Get(o:GetSize() - 1))
                    if a < best
                        best = a
                    end
                    if b < best
                        best = b
                    end
                end
            end
            j = j + 1
        end
        return best
    end

    // fill overlap on adaptive planes as fraction of line width
    // if pos, reaches into innermost adaptive wall, neg leaves a gap
    // no change to uniform output (still uses infillOverlap and seperate inset)
    action SetAdaptiveFillOverlap(number overlap)
        checker:RequireRange("PathGenerator:SetAdaptiveFillOverlap overlap", overlap, -1, 1)
        adaptiveFillOverlap = overlap
    end

    /*
    The extrusion width, which is also the spacing of solid fill and the
    shortest fill line kept.

    Attribute: Parameter width The width (mm), greater than 0.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetLineWidth(0.42)
        paths:Generate(outlines, 100)
    */
    action SetLineWidth(number width)
        checker:RequirePositive("PathGenerator:SetLineWidth width", width)
        lineWidth = width
        minInfillLength = width
    end

    /*
    The number of walls (0 for none).

    Attribute: Parameter count The number of walls.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetWallCount(2)
        paths:Generate(outlines, 100)
    */
    action SetWallCount(integer count)
        checker:RequireAtLeast("PathGenerator:SetWallCount count", count, 0)
        wallCount = count
    end

    /*
    The sparse infill density: 0 for none, 1 for solid (lines touching side
    by side).

    Attribute: Parameter density The density, 0 to 1.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetInfillDensity(0.15)      // 15% infill
        paths:Generate(outlines, 100)
    */
    action SetInfillDensity(number density)
        checker:RequireRange("PathGenerator:SetInfillDensity density", density, 0, 1)
        infillDensity = density
    end

    /*
    How far fill lines reach into the innermost wall, as a fraction of the
    line width.

    Attribute: Parameter overlap The fraction, 0 to 1.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetInfillOverlap(0.25)      // a quarter of a line width into the wall
        paths:Generate(outlines, 100)
    */
    action SetInfillOverlap(number overlap)
        checker:RequireRange("PathGenerator:SetInfillOverlap overlap", overlap, 0, 1)
        infillOverlap = overlap
    end

    /*
    Solid layers under top surfaces. Typical is 0.6 - 1.0 mm worth: 3 - 5
    layers at 0.2 mm. 0 turns them off.

    Attribute: Parameter count The number of layers.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetTopLayers(4)      // 0.8 mm at 0.2 mm layers
        paths:Generate(outlines, 100)
    */
    action SetTopLayers(integer count)
        checker:RequireAtLeast("PathGenerator:SetTopLayers count", count, 0)
        topLayers = count
    end

    /*
    Solid layers over bottom surfaces; 0 turns them off.

    Attribute: Parameter count The number of layers.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetBottomLayers(3)
        paths:Generate(outlines, 100)
    */
    action SetBottomLayers(integer count)
        checker:RequireAtLeast("PathGenerator:SetBottomLayers count", count, 0)
        bottomLayers = count
    end

    /*
    true (the default): layer 0's solid fill is chained into continuous
    zigzags. false: separate straight lines, as on every other layer.

    Attribute: Parameter toggle Whether to join the first layer's lines.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetJoinFirstLayer(false)      // straight lines on the first layer too
        paths:Generate(outlines, 100)
    */
    action SetJoinFirstLayer(boolean toggle)
        joinFirstLayer = toggle
    end

    /*
    true: solid fill (skin) on every layer is chained into continuous
    zigzags, as the first layer's is. Each line's end is linked to the next
    line's start along the edge of the fill, wherever that link stays inside
    it, so the nozzle keeps extruding instead of stopping, travelling and
    starting again for every line. false (the default): separate straight
    lines (the first layer still follows SetJoinFirstLayer).

    Attribute: Parameter toggle Whether to join the solid fill lines.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetJoinSkin(true)
        paths:Generate(outlines, 100)
    */
    action SetJoinSkin(boolean toggle)
        joinSkin = toggle
    end

    /*
    true: sparse infill lines are chained into continuous zigzags, linked
    along the edge of the infill where the link stays inside it (like
    "connected" rectilinear infill in other slicers). The links lie along the
    innermost wall, so they also tie the infill to it. false (the default):
    separate straight lines.

    Attribute: Parameter toggle Whether to join the sparse infill lines.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetInfillDensity(0.15)
        paths:SetJoinInfill(true)
        paths:Generate(outlines, 100)
    */
    action SetJoinInfill(boolean toggle)
        joinInfill = toggle
    end

    /*
    true (the default): where the space left inside the innermost wall is
    too narrow for the next wall and too narrow for fill lines (a thin wall
    a little wider than its walls, such as a boat's hull rim or a
    chimney), it is filled with solid lines instead of being left as an
    open slot down the middle of the part. false: such slots stay empty.

    Attribute: Parameter toggle Whether to fill the gaps.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetGapFill(false)      // leave slots between walls open
        paths:Generate(outlines, 100)
    */
    action SetGapFill(boolean toggle)
        gapFill = toggle
    end

    /*
    Keeps the solid fill of top surfaces apart from the rest of the skin, so
    it can be printed slower, with its own flow, and in one sweep (see
    GetTopSurface). count is how many layers down from a surface count as
    top surface: 1 is just the layer you see; 0 (the default) turns this off
    and top surfaces are ordinary skin.

    Where a part finishes partway up the print (a ledge, a short pillar next
    to a tall one), its last layer is a top surface too.

    Attribute: Parameter count How many layers under each top surface.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetTopSurfaceLayers(1)      // only the layer you see
        paths:Generate(outlines, 100)
        Array<Contour> top = paths:GetTopSurface()
    */
    action SetTopSurfaceLayers(integer count)
        checker:RequireAtLeast("PathGenerator:SetTopSurfaceLayers count", count, 0)
        topSurfaceLayers = count
    end

    /*
    Ironing: after a top surface is printed, the nozzle goes over it again
    at the same height, along lines `spacing` mm apart and across the
    surface's own lines, pushing out only a trickle of plastic. That melts
    the ridges flat and fills the small gaps between lines. Only surfaces
    with nothing printed on them are ironed, and only `inset` mm in from
    their edge. Off by default.

    Attribute: Parameter toggle Whether to iron top surfaces.
    Attribute: Parameter spacing The distance between ironing lines (mm), greater than 0; 0.1 - 0.15 is typical.
    Attribute: Parameter inset How far in from the surface's edge ironing stops (mm).

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetIroning(true, 0.1, 0.2)
        paths:Generate(outlines, 100)
        Array<Contour> ironing = paths:GetIroning()
    */
    action SetIroning(boolean toggle, number spacing, number inset)
        checker:RequirePositive("PathGenerator:SetIroning spacing", spacing)
        checker:RequireAtLeast("PathGenerator:SetIroning inset", inset, 0)
        ironing = toggle
        ironingSpacing = spacing
        ironingInset = inset
    end

    /*
    true: Generate prints how far it has got, every tenth of the layers, so
    a slow model doesn't look like a hang. Off by default.

    Attribute: Parameter toggle Whether to print progress.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetProgress(true)     // "walls: 10% (38 of 381 layers)" ...
        paths:Generate(outlines, 381)
    */
    action SetProgress(boolean toggle)
        progress = toggle
    end

    /*
    The wall loops of every plane from the last Generate.

    Attribute: Returns The wall loops of every plane from the last Generate.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:Generate(outlines, 100)
        Array<Contour> walls = paths:GetWalls()
        output walls:GetSize() + " wall loops"
    */
    action GetWalls returns Array<Contour>
        return walls
    end

    /*
    The solid fill lines (and thin-part center lines) of every plane.

    Attribute: Returns The solid fill lines (and thin-part center lines) of every plane.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:Generate(outlines, 100)
        Array<Contour> skin = paths:GetSkin()
        output skin:GetSize() + " solid fill lines"
    */
    action GetSkin returns Array<Contour>
        return skin
    end

    /*
    The sparse infill lines of every plane.

    Attribute: Returns The sparse infill lines of every plane.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:Generate(outlines, 100)
        Array<Contour> infill = paths:GetInfill()
        output infill:GetSize() + " infill lines"
    */
    action GetInfill returns Array<Contour>
        return infill
    end

    /*
    The top surface fill of every plane (empty unless SetTopSurfaceLayers
    was given 1 or more). Each path is a zigzag that climbs from one line to
    the next in one direction; PathOrderer keeps them that way.

    Attribute: Returns The top surface zigzags of every plane.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetTopSurfaceLayers(1)
        paths:Generate(outlines, 100)
        Array<Contour> top = paths:GetTopSurface()
        output top:GetSize() + " top surface paths"
    */
    action GetTopSurface returns Array<Contour>
        return topSurface
    end

    /*
    The ironing zigzags of every plane (empty unless SetIroning turned it on).

    Attribute: Returns The ironing zigzags of every plane.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetIroning(true, 0.1, 0.2)
        paths:Generate(outlines, 100)
        Array<Contour> ironing = paths:GetIroning()
        output ironing:GetSize() + " ironing paths"
    */
    action GetIroning returns Array<Contour>
        return ironingLines
    end

    /*
    How many inner-wall / fill loops the last Generate dropped for not fitting inside a thin part.

    Attribute: Returns How many inner-wall / fill loops the last Generate dropped for not fitting inside a thin part.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:Generate(outlines, 100)
        output paths:GetDroppedLoopCount() + " loops didn't fit inside thin parts"
    */
    action GetDroppedLoopCount returns integer
        return droppedLoops
    end

    /*
    How many thin islands the last Generate rebuilt with the exact (slower) inset.

    Attribute: Returns How many thin islands the last Generate rebuilt with the exact (slower) inset.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:Generate(outlines, 100)
        output paths:GetRebuiltIslandCount() + " thin islands needed the exact inset"
    */
    action GetRebuiltIslandCount returns integer
        return rebuiltIslands
    end

    /*
    How many inset loops the last Generate kept after cutting off spurs
    (points the offsetter folded too close to the outline) instead of
    rebuilding their island with the exact, slower inset.

    Attribute: Returns How many inset loops were trimmed.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:Generate(outlines, 100)
        output paths:GetTrimmedLoopCount() + " inset loops had spurs cut off"
    */
    action GetTrimmedLoopCount returns integer
        return trimmedLoops
    end

    /*
    Makes the walls, skin and infill of every plane, replacing the results
    of an earlier call.

    Attribute: Parameter contours The oriented outlines from ContourGenerator:Build.
    Attribute: Parameter planeCount The number of planes sliced.

    Attribute: Example

        use Libraries.Containers.Array
        use Libraries.Fabrication.Geometry.Contour
        use Libraries.Fabrication.Slicing.PathGenerator

        Array<Contour> outlines     // from ContourGenerator:Build
        PathGenerator paths
        paths:SetWallCount(3)
        paths:SetInfillDensity(0.2)
        paths:Generate(outlines, 100)
        Array<Contour> walls = paths:GetWalls()
    */
    action Generate(Array<Contour> contours, integer planeCount)
        planeAdaptive:Empty()
        adaptiveFallbacks = 0
        adaptiveClamped = 0
        walls:Empty()
        skin:Empty()
        infill:Empty()
        topSurface:Empty()
        ironingLines:Empty()
        inner:Empty()
        innerStart:Empty()
        gapAreas:Empty()
        gapStart:Empty()
        droppedLoops = 0
        rebuiltIslands = 0
        trimmedLoops = 0
        planeTotal = planeCount
        modelLayers:Index(contours, planeCount, true)

        // pass 1: walls and inner areas for every plane
        integer p = 0
        repeat while p < planeCount
            plane = p
            ClearCache()
            innerStart:Add(inner:GetSize())
            gapStart:Add(gapAreas:GetSize())
            Array<Contour> layer = modelLayers:GetLayer(p)
//            Array<Contour> planeWalls
            planeAdaptive:Add(0)
            Array<Contour> planeWalls
            if layer:GetSize() > 0
//                if not adaptive
//                    // the center line of wall sits (w + 0.5)
//                    // line widths inside the outline
//                    integer w = 0
//                    repeat while w < wallCount
//                        Array<Contour> ring
//                        Array<Contour> deeper
//                        if w = 0
//                            ring = Inset(layer, lineWidth * 0.5)
//                        else
//                            // only where wall w fits from both sides: shrink past
//                            // the far edge of this wall, then grow back to its centre
//                            deeper = CachedFitInset(layer, lineWidth * cast(number, w + 1), false)
//                            ring = ExactOutset(deeper, lineWidth * 0.5)
//                        end
//                        integer r = 0
//                        repeat while r < ring:GetSize()
//                            Contour wall = ring:Get(r)
//                            wall:wallIndex = w
//                            walls:Add(wall)
//                            r = r + 1
//                        end
//                        if w = 0
//                            ThinIslands(layer, ring, p)
//                        else
//                            WallGaps(layer, w, deeper, p)
//                        end
//                        w = w + 1
//                    end
//                else
//                    arachne:SetWidth(lineWidth)
//                    arachne:SetWallCount(wallCount)
//                    Array<Contour> APwalls = arachne:Generate(layer)
//
//                    integer aw = 0
//                    repeat while aw < APwalls:GetSize()
//                        Contour APwall = APwalls:Get(aw)
//                        APwall:planeIndex = p
//                       walls:Add(APwall)
//                        aw = aw + 1
//                    end
//                    planeWalls = APwalls
//                end

                boolean useArachne = false
                if adaptive
                    arachne:SetWidth(lineWidth)
                    arachne:SetWallCount(wallCount)
                    Array<Contour> APwalls = arachne:Generate(layer)
                    if arachne:IsValid()
                        useArachne = true
                        adaptiveClamped = adaptiveClamped + arachne:GetClampedCount()
                        planeAdaptive:Set(p, 1)
                        planeWalls = APwalls
                        integer aw = 0
                        repeat while aw < APwalls:GetSize()
                            Contour APwall = APwalls:Get(aw)
                            APwall:planeIndex = p
                            walls:Add(APwall)
                            aw = aw + 1
                        end
                    else
                        adaptiveFallbacks = adaptiveFallbacks + 1
                        if progress
                            output "adaptive fallback plane " + p + ": " + arachne:Reason()
                        end
                    end
//                    output "plane " + p + " valid " + arachne:IsValid() + " walls " + APwalls:GetSize()
                end

                if not useArachne
                    integer w = 0
                    repeat while w < wallCount
                        Array<Contour> ring
                        Array<Contour> deeper
                        if w = 0
                            ring = Inset(layer, lineWidth * 0.5)
                        else
                            // only where wall w fits from both sides: shrink past
                            // the far edge of this wall, then grow back to its centre
                            deeper = CachedFitInset(layer, lineWidth * cast(number, w + 1), false)
                            ring = ExactOutset(deeper, lineWidth * 0.5)
                        end
                        integer r = 0
                        repeat while r < ring:GetSize()
                            Contour wall = ring:Get(r)
                            wall:wallIndex = w
                            walls:Add(wall)
                            r = r + 1
                        end
                        if w = 0
                            ThinIslands(layer, ring, p)
                        else
                            WallGaps(layer, w, deeper, p)
                        end
                        w = w + 1
                    end
                end

//                Array<Contour> area = Inset(layer, lineWidth * cast(number, wallCount))
                Array<Contour> area
                if planeAdaptive:Get(p) = 1
                    area = AdaptiveInner(layer, planeWalls)
                else
                    area = Inset(layer, lineWidth * cast(number, wallCount))
                end
                integer a = 0
                repeat while a < area:GetSize()
                    inner:Add(area:Get(a))
                    a = a + 1
                end
//                if gapFill and wallCount > 0 and area:GetSize() > 0
                if gapFill and planeAdaptive:Get(p) = 0 and wallCount > 0 and area:GetSize() > 0         
                    GapFill(layer, area, p)
                end
            end
            Progress("walls", p)
            p = p + 1
        end
        innerStart:Add(inner:GetSize())
        gapStart:Add(gapAreas:GetSize())

        // pass 2: skin and infill (needs the inner areas of neighbours)
        number sparseSpacing = lineWidth
        if infillDensity > 0
            sparseSpacing = lineWidth / util:Min2(infillDensity, 1.0)
        end
        p = 0
        repeat while p < planeCount
            plane = p
            ClearCache()
            Array<Contour> layer2 = modelLayers:GetLayer(p)
            Array<Contour> innerArea = InnerContours(p)
            if layer2:GetSize() > 0 and innerArea:GetSize() > 0
                // fill area = inner area grown back into the last wall by the overlap is at wallCount * lineWidth
                number inset = lineWidth * (cast(number, wallCount) + 0.5 - infillOverlap)
//                Array<Contour> fillArea = Inset(layer2, inset)
                Array<Contour> fillArea
                if planeAdaptive:Get(p) = 1
                    // adaptive planes: the fill reaches adaptiveFillOverlap line widths into the innermost wall.
                    // fillArea holds the fill lines' centres, so (as for uniform planes) it sits half a line width
                    // further in than the edge the lines may reach: the walls end wallCount widths in, and a line's
                    // edge reaches adaptiveFillOverlap widths past that.
                    fillArea = Inset(layer2, lineWidth * (cast(number, wallCount) + 0.5 - adaptiveFillOverlap))
                else
                    fillArea = Inset(layer2, inset)
                end
                Array<Contour> filledGaps = GapContours(p)
                if fillArea:GetSize() > 0 and filledGaps:GetSize() > 0
                    // the gap fill already covers these bands
                    fillArea = ops:Difference(fillArea, filledGaps, p)
                end
                if fillArea:GetSize() > 0
                    Array<Contour> skinArea = FindSkin(p, innerArea)
                    if skinArea:GetSize() > 0
                        Array<Contour> solid = ops:Intersect(fillArea, skinArea, p)
                        if topSurfaceLayers > 0 or ironing
                            // top surfaces (and their ironing) are made here;
                            // what's left is ordinary skin
                            solid = SplitTopSurface(p, solid)
                        end
                        // first layer: one continuous zigzag, no loose ends to lift;
                        // other layers too when joinSkin is on
                        if joinSkin or (joinFirstLayer and p = 0)
                            lineFill:FillJoined(solid, p, lineWidth, minInfillLength, skin)
                        else
                            lineFill:Fill(solid, p, lineWidth, minInfillLength, skin)
                        end
                        if infillDensity > 0
                            Array<Contour> sparse = ops:Difference(fillArea, skinArea, p)
                            FillSparse(sparse, p, sparseSpacing)
                        end
                    elseif infillDensity > 0
                        FillSparse(fillArea, p, sparseSpacing)
                    end
                end
            end
            Progress("fill", p)
            p = p + 1
        end
        // diagnostics, printed with SetProgress(true) (SliceJob's verbose output)
        if progress
            output "extruded mm2: walls " + ExtrudedArea(walls) + ", solid " + (ExtrudedArea(skin) + ExtrudedArea(topSurface)) + ", infill " + ExtrudedArea(infill) + ", region " + RegionArea(contours)
            if adaptive
                output "adaptive fallback planes " + adaptiveFallbacks + " of " + planeTotal
                output "adaptive bead points printed at the widest allowed width: " + adaptiveClamped
            end
        end
    end

    // sparse infill lines over `area`, chained into zigzags if joinInfill is on
    private action FillSparse(Array<Contour> area, integer p, number spacing)
        if area:GetSize() = 0
            return now
        end
        if joinInfill
            lineFill:FillJoined(area, p, spacing, minInfillLength, infill)
        else
            lineFill:Fill(area, p, spacing, minInfillLength, infill)
        end
    end

    // Prints "walls: 30% (114 of 381 layers)" after every tenth of the planes.
    private action Progress(text stage, integer p)
        if not progress or planeTotal < 10
            return now
        end
        integer step = planeTotal / 10
        if (p + 1) mod step = 0 or p + 1 = planeTotal
            output "  " + stage + ": " + ((p + 1) * 100 / planeTotal) + "% (" + (p + 1) + " of " + planeTotal + " layers)"
        end
    end

    // ------------------------------------------------------------ insets
    //
    // PolygonOffsetter moves each corner in by `depth` and lets PolygonOperations keep
    // whatever winds positively. Where the outline has small notches, or
    // the part is about as thin as the inset, the moved edges fold over
    // each other and some of the folds still wind positively. Those leftovers
    // sit closer than `depth` to the edge: spurs on walls, stray walls beside
    // thin ankles, spikes and spear shafts, skin past the outer wall. A real
    // inset loop lies inside the outline and `depth` from it everywhere, so a
    // loop that doesn't first has its spurs cut off (TrimmedLoop); only if
    // that fails, and the loop is big enough to matter, is its island
    // rebuilt exactly. Specks smaller than a quarter of a line width squared
    // are dropped: nothing that small prints, and on a jagged outline (a
    // decimated mesh) the offsetter leaves dozens of them on every layer.
    private action Inset(Array<Contour> outline, number depth) returns Array<Contour>
        return CachedFitInset(outline, depth, true)
    end

    private action ClearCache
        cacheDepth:Empty()
        cacheStart:Empty()
        cacheCount:Empty()
        cacheLoops:Empty()
    end

    // FitInset, remembering each depth's result for the current plane
    // (ClearCache starts a plane): the walls ask for the same depths more
    // than once. Wall w + 1's inset is wall w's gap band, and the last
    // wall's is the area left for fill.
    private action CachedFitInset(Array<Contour> outline, number depth, boolean count) returns Array<Contour>
        integer i = 0
        repeat while i < cacheDepth:GetSize()
            if cacheDepth:Get(i) = depth
                Array<Contour> hit
                integer k = cacheStart:Get(i)
                repeat while k < cacheStart:Get(i) + cacheCount:Get(i)
                    hit:Add(cacheLoops:Get(k))
                    k = k + 1
                end
                return hit
            end
            i = i + 1
        end
        Array<Contour> fresh = FitInset(outline, depth, count)
        cacheDepth:Add(depth)
        cacheStart:Add(cacheLoops:GetSize())
        cacheCount:Add(fresh:GetSize())
        integer f = 0
        repeat while f < fresh:GetSize()
            cacheLoops:Add(fresh:Get(f))
            f = f + 1
        end
        return fresh
    end

    private action FitInset(Array<Contour> outline, number depth, boolean count) returns Array<Contour>
        BuildFitIndex(outline, 0.9 * depth)
        BuildIslandIndex(outline)
        Array<Contour> raw = offsetter:Offset(outline, depth)
        Array<Contour> kept
        Array<Contour> dropped
        number speck = lineWidth * lineWidth
        integer i = 0
        repeat while i < raw:GetSize()
            Contour loop = raw:Get(i)
            number loopArea = loop:Area()
            if loopArea < 0.25 * speck
                // a fold-over speck: too small to print, whatever it is
                if count
                    droppedLoops = droppedLoops + 1
                end
            elseif LoopFits(loop, outline, depth)
                kept:Add(loop)
            else
                Contour trimmed = TrimmedLoop(loop, outline, depth)
                if trimmed:GetSize() >= 3
                    kept:Add(trimmed)
                    trimmedLoops = trimmedLoops + 1
                else
                    if count
                        droppedLoops = droppedLoops + 1
                    end
                    // only a real piece going missing is worth an exact rebuild
                    if loopArea >= speck
                        dropped:Add(loop)
                    end
                end
            end
            i = i + 1
        end

        // Islands that lost a loop (one LoopFits rejected and trimming
        // couldn't save) are rebuilt with an exact inset. An island with no
        // loop at all is simply too thin at this depth: the offsetter's
        // folds wind the other way and drop out, so its inset is exact, and
        // rebuilding it to confirm the island is empty (most of ExactInset's
        // time on spiky models) found nothing in any of 595 tries.
        Array<Contour> result
        integer o = 0
        repeat while o < outline:GetSize()
            if fitHole:Get(o) = 0
                if not OwnsAny(o, outline, dropped)
                    integer k = 0
                    repeat while k < kept:GetSize()
                        Contour good = kept:Get(k)
                        if good:GetSize() > 0
                            if OwnerIsland(outline, good:xs:Get(0), good:ys:Get(0)) = o
                                result:Add(good)
                            end
                        end
                        k = k + 1
                    end
                else
                    Array<Contour> exact = ExactInset(IslandWithHoles(o, outline), depth)
                    if exact:GetSize() > 0 and count
                        rebuiltIslands = rebuiltIslands + 1
                    end
                    integer e = 0
                    repeat while e < exact:GetSize()
                        Contour piece = exact:Get(e)
                        if piece:GetSize() >= 3 and LoopFits(piece, outline, depth)
                            result:Add(piece)
                        end
                        e = e + 1
                    end
                end
            end
            o = o + 1
        end
        return result
    end

    // The smallest island (non-hole loop) of the outline containing (x, y),
    // or -1. Needs BuildIslandIndex(outline) first (FitInset does it). A loop
    // whose bounding box can't hold the point is skipped: ContainsPoint
    // counts no crossing for a point above or below every edge, and none
    // that changes the answer for one left or right of them all (the 10^-6
    // mm margin keeps rounding of the crossing point out of it).
    private action OwnerIsland(Array<Contour> outline, number x, number y) returns integer
        integer best = -1
        number bestArea = 0.0
        integer i = 0
        repeat while i < outline:GetSize()
            if fitHole:Get(i) = 0 and MayContain(i, x, y)
                Contour shape = outline:Get(i)
                if shape:ContainsPoint(x, y)
                    number area = fitLoopArea:Get(i)
                    if best = -1 or area < bestArea
                        best = i
                        bestArea = area
                    end
                end
            end
            i = i + 1
        end
        return best
    end

    private action OwnsAny(integer island, Array<Contour> outline, Array<Contour> loops) returns boolean
        integer i = 0
        repeat while i < loops:GetSize()
            Contour loop = loops:Get(i)
            if loop:GetSize() > 0
                if OwnerIsland(outline, loop:xs:Get(0), loop:ys:Get(0)) = island
                    return true
                end
            end
            i = i + 1
        end
        return false
    end

    // outline[index] plus the holes that start inside it. Needs
    // BuildIslandIndex(outline) first.
    private action IslandWithHoles(integer index, Array<Contour> outline) returns Array<Contour>
        Array<Contour> island
        Contour shape = outline:Get(index)
        island:Add(shape)
        integer i = 0
        repeat while i < outline:GetSize()
            if i not= index and fitHole:Get(i) = 1
                Contour hole = outline:Get(i)
                if hole:GetSize() > 0
                    if OwnerIsland(outline, hole:xs:Get(0), hole:ys:Get(0)) = index
                        island:Add(hole)
                    end
                end
            end
            i = i + 1
        end
        return island
    end

    // Exact inset: the island minus everything within `depth` of its outline
    // (AddEdgeBands, material side). Whatever is left is everything at least
    // `depth` from the edge, with no spikes or inside-out loops.
    private action ExactInset(Array<Contour> island, number depth) returns Array<Contour>
        ops:Clear()
        if AddEdgeBands(island, depth, false) = 0
            Array<Contour> blank
            return blank
        end
        Array<Contour> band = ops:Resolve(1, plane)
        if band:GetSize() = 0
            Array<Contour> none
            return none
        end
        return ops:Difference(island, band, plane)
    end

    // Adds to ops everything within r of the loops' edges on one side of
    // them: a band along each edge, plus a round wedge at each corner where
    // the outline turns away from that side. Material is on the left of
    // every loop (outer loops counter-clockwise, holes clockwise), so
    // outward = false covers the material side (for insets) and
    // outward = true the other side (for outsets). This is the same area the
    // capsules (a band on both sides with round ends) used to cover, from
    // about a third of the edges and much less overlap, which is what makes
    // PolygonOperations slow. A corner whose turn can't be trusted (sharper
    // than 90 degrees, or beside an edge shorter than r / 8, where a 0.002 mm
    // zigzag reads as two sharp turns the wrong way) gets a whole disc, as
    // the capsules gave every corner. Returns how many pieces were added
    // (edges shorter than 0.000001 mm are skipped).
    private action AddEdgeBands(Array<Contour> loops, number r, boolean outward) returns integer
        number side = 1.0
        if outward
            side = -1.0
        end
        number shortEdge = 0.125 * r
        integer added = 0
        integer c = 0
        repeat while c < loops:GetSize()
            Contour con = loops:Get(c)
            integer n = con:GetSize()
            if n >= 3
                integer i = 0
                repeat while i < n
                    integer j = i + 1
                    if j = n
                        j = 0
                    end
                    number ax = con:xs:Get(i)
                    number ay = con:ys:Get(i)
                    number bx = con:xs:Get(j)
                    number by = con:ys:Get(j)
                    number len = math:SquareRoot((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
                    if len > 0.000001
                        number ux = (bx - ax) / len
                        number uy = (by - ay) / len
                        // normal pointing to the covered side
                        number nx = -uy * side
                        number ny = ux * side
                        bandX:Empty()
                        bandY:Empty()
                        bandX:Add(ax)
                        bandY:Add(ay)
                        bandX:Add(bx)
                        bandY:Add(by)
                        bandX:Add(bx + r * nx)
                        bandY:Add(by + r * ny)
                        bandX:Add(ax + r * nx)
                        bandY:Add(ay + r * ny)
                        AddCounterClockwise(bandX, bandY)
                        added = added + 1

                        // the corner at b, toward the next point that isn't b
                        integer k = j
                        integer steps = 0
                        number cx = bx
                        number cy = by
                        number nextLen = 0.0
                        repeat while nextLen <= 0.000001 and steps < n
                            k = k + 1
                            if k = n
                                k = 0
                            end
                            cx = con:xs:Get(k)
                            cy = con:ys:Get(k)
                            nextLen = math:SquareRoot((cx - bx) * (cx - bx) + (cy - by) * (cy - by))
                            steps = steps + 1
                        end
                        if nextLen > 0.000001
                            number vx = (cx - bx) / nextLen
                            number vy = (cy - by) / nextLen
                            number turn = ux * vy - uy * vx
                            number dot = ux * vx + uy * vy
                            if dot < 0 or len < shortEdge or nextLen < shortEdge
                                AddDisc(bx, by, r)
                                added = added + 1
                            elseif turn * side < -0.000000001
                                // turning away from the covered side opens a gap
                                // between the two bands: fill it with an arc
                                AddWedge(bx, by, r, nx, ny, -vy * side, vx * side, side > 0)
                                added = added + 1
                            end
                        end
                    end
                    i = i + 1
                end
            end
            c = c + 1
        end
        return added
    end

    // A pie slice of radius r at (x, y), from normal 1 to normal 2, turning
    // clockwise or counter-clockwise in 30 degree steps.
    private action AddWedge(number x, number y, number r, number n1x, number n1y, number n2x, number n2y,
                            boolean clockwise)
        bandX:Empty()
        bandY:Empty()
        bandX:Add(x)
        bandY:Add(y)
        bandX:Add(x + r * n1x)
        bandY:Add(y + r * n1y)
        number px = n1x
        number py = n1y
        integer step = 0
        boolean going = true
        repeat while going and step < 12
            number tx = px * cos30 - py * sin30
            number ty = px * sin30 + py * cos30
            if clockwise
                tx = px * cos30 + py * sin30
                ty = -px * sin30 + py * cos30
            end
            // reached or passed normal 2?
            number cross = tx * n2y - ty * n2x
            boolean passed = cross <= 0
            if clockwise
                passed = cross >= 0
            end
            if passed
                going = false
            else
                bandX:Add(x + r * tx)
                bandY:Add(y + r * ty)
                px = tx
                py = ty
                step = step + 1
            end
        end
        bandX:Add(x + r * n2x)
        bandY:Add(y + r * n2y)
        AddCounterClockwise(bandX, bandY)
    end

    // A 12-sided disc of radius r around (x, y).
    private action AddDisc(number x, number y, number r)
        bandX:Empty()
        bandY:Empty()
        number px = 1.0
        number py = 0.0
        integer k = 0
        repeat while k < 12
            bandX:Add(x + r * px)
            bandY:Add(y + r * py)
            number qx = px * cos30 - py * sin30
            number qy = px * sin30 + py * cos30
            px = qx
            py = qy
            k = k + 1
        end
        ops:AddPoints(bandX, bandY, false)
    end

    // Adds the points to ops as a counter-clockwise loop, whichever way they run.
    private action AddCounterClockwise(NumberBuffer xs, NumberBuffer ys)
        number area2 = 0.0
        integer n = xs:GetSize()
        integer i = 0
        repeat while i < n
            integer j = i + 1
            if j = n
                j = 0
            end
            area2 = area2 + xs:Get(i) * ys:Get(j) - xs:Get(j) * ys:Get(i)
            i = i + 1
        end
        ops:AddPoints(xs, ys, area2 < 0)
    end

    // ------------------------------------------------------------ thin parts

    // Outlines too thin for an outer wall (a spike tip, a fin edge, a
    // spear prong) get one line down their middle instead of nothing.
    private action ThinIslands(Array<Contour> layer, Array<Contour> outerRing, integer p)
        IntegerBuffer holes
        HoleFlags(layer, holes)
        integer i = 0
        repeat while i < layer:GetSize()
            Contour con = layer:Get(i)
            if con:GetSize() >= 3 and holes:Get(i) = 0
                // a usable outer wall inside it? (shorter loops get dropped
                // when the paths are ordered)
                boolean walled = false
                integer r = 0
                repeat while r < outerRing:GetSize() and not walled
                    Contour loop = outerRing:Get(r)
                    if loop:GetSize() >= 3
                        if con:ContainsPoint(loop:xs:Get(0), loop:ys:Get(0)) and util:PathLength(loop) >= 1.0
                            walled = true
                        end
                    end
                    r = r + 1
                end
                if not walled
                    CenterLine(con, p)
                end
            end
            i = i + 1
        end
    end

    // One line along the outline's long axis, ending half a line width
    // short of each end and pulled in if the part curves away.
    private action CenterLine(Contour con, integer p)
        integer n = con:GetSize()
        number mx = 0.0
        number my = 0.0
        integer i = 0
        repeat while i < n
            mx = mx + con:xs:Get(i)
            my = my + con:ys:Get(i)
            i = i + 1
        end
        mx = mx / cast(number, n)
        my = my / cast(number, n)
        number sxx = 0.0
        number sxy = 0.0
        number syy = 0.0
        i = 0
        repeat while i < n
            number ex = con:xs:Get(i) - mx
            number ey = con:ys:Get(i) - my
            sxx = sxx + ex * ex
            sxy = sxy + ex * ey
            syy = syy + ey * ey
            i = i + 1
        end
        // long axis: power iteration on the spread of the points
        number ax = 1.0
        number ay = 0.37
        integer it = 0
        repeat while it < 16
            number nx = sxx * ax + sxy * ay
            number ny = sxy * ax + syy * ay
            number nlen = math:SquareRoot(nx * nx + ny * ny)
            if nlen < 0.000000001
                it = 16
            else
                ax = nx / nlen
                ay = ny / nlen
                it = it + 1
            end
        end
        number alen = math:SquareRoot(ax * ax + ay * ay)
        ax = ax / alen
        ay = ay / alen

        number low = 0.0
        number high = 0.0
        i = 0
        repeat while i < n
            number t = (con:xs:Get(i) - mx) * ax + (con:ys:Get(i) - my) * ay
            if i = 0 or t < low
                low = t
            end
            if i = 0 or t > high
                high = t
            end
            i = i + 1
        end
        number rawLength = high - low
        low = low + lineWidth * 0.5
        high = high - lineWidth * 0.5
        if high - low < lineWidth * 0.5
            // a dot, not a line
            Dot(con, mx, my, ax, ay, rawLength, p)
            return now
        end

        // pull each end toward the middle until it's inside the part
        integer tries = 0
        repeat while tries < 8 and not con:ContainsPoint(mx + ax * low, my + ay * low)
            low = low * 0.75
            tries = tries + 1
        end
        tries = 0
        repeat while tries < 8 and not con:ContainsPoint(mx + ax * high, my + ay * high)
            high = high * 0.75
            tries = tries + 1
        end
        if high - low < lineWidth * 0.5
            Dot(con, mx, my, ax, ay, rawLength, p)
            return now
        end

        Contour line
        line:AddPoint(mx + ax * low, my + ay * low)
        line:AddPoint(mx + ax * high, my + ay * high)
        line:closed = false
        line:planeIndex = p
        line:keepShort = true
        skin:Add(line)
    end

    // An island too small for even a center line (the last layers of an
    // ear tip or a horn): one short dab along its long axis instead of
    // nothing. Its length is picked so the dab holds about as much plastic
    // as the island (area / line width), never longer than the island.
    private action Dot(Contour con, number mx, number my, number ax, number ay, number rawLength, integer p)
        if not con:ContainsPoint(mx, my)
            return now
        end
        number length = con:Area() / lineWidth
        if length > rawLength
            length = rawLength
        end
        if length < minDotLength
            return now
        end
        number halfLength = length / 2.0
        Contour dot
        dot:AddPoint(mx - ax * halfLength, my - ay * halfLength)
        dot:AddPoint(mx + ax * halfLength, my + ay * halfLength)
        dot:closed = false
        dot:planeIndex = p
        dot:keepShort = true
        skin:Add(dot)
    end

    // loops[index] is a hole if it lies inside an odd number of the others
    // (Contour:IsInside, so islands that only touch are not holes).
    // Which of the outline's loops are holes, and each loop's area and
    // bounding box, for OwnerIsland and IslandWithHoles (FitInset asks about
    // the same outline many times).
    private action BuildIslandIndex(Array<Contour> outline)
        HoleFlags(outline, fitHole)
        fitLoopArea:Empty()
        fitBoxMinX:Empty()
        fitBoxMinY:Empty()
        fitBoxMaxX:Empty()
        fitBoxMaxY:Empty()
        integer c = 0
        repeat while c < outline:GetSize()
            Contour con = outline:Get(c)
            number area = con:SignedArea2()
            if area < 0
                area = -area
            end
            fitLoopArea:Add(area)
            AddBox(con, fitBoxMinX, fitBoxMinY, fitBoxMaxX, fitBoxMaxY)
            c = c + 1
        end
    end

    // Could loop c of the indexed outline contain (x, y)? False only where
    // ContainsPoint is sure to say no (see OwnerIsland).
    private action MayContain(integer c, number x, number y) returns boolean
        if y < fitBoxMinY:Get(c) or y >= fitBoxMaxY:Get(c)
            return false
        end
        return x >= fitBoxMinX:Get(c) - 0.000001 and x <= fitBoxMaxX:Get(c) + 0.000001
    end

    // Appends the loop's bounding box (an empty box, min above max, for a loop without points).
    private action AddBox(Contour con, NumberBuffer minX, NumberBuffer minY, NumberBuffer maxX, NumberBuffer maxY)
        integer n = con:GetSize()
        if n = 0
            minX:Add(1.0)
            minY:Add(1.0)
            maxX:Add(0.0)
            maxY:Add(0.0)
            return now
        end
        number loX = con:xs:Get(0)
        number hiX = loX
        number loY = con:ys:Get(0)
        number hiY = loY
        integer i = 1
        repeat while i < n
            loX = util:Min2(loX, con:xs:Get(i))
            hiX = util:Max2(hiX, con:xs:Get(i))
            loY = util:Min2(loY, con:ys:Get(i))
            hiY = util:Max2(hiY, con:ys:Get(i))
            i = i + 1
        end
        minX:Add(loX)
        minY:Add(loY)
        maxX:Add(hiX)
        maxY:Add(hiY)
    end

    // flags[i] = 1 if loop i is a hole: an odd number of the other loops
    // contain it, the same answer as counting loops[i]:IsInside(other) over
    // the others. The test point Contour:IsInside picks (just inside the
    // longest edge) is worked out once per loop instead of once per pair, and
    // a loop whose bounding box can't hold it is skipped (see OwnerIsland).
    private action HoleFlags(Array<Contour> loops, IntegerBuffer flags)
        integer count = loops:GetSize()
        NumberBuffer probeX
        NumberBuffer probeY
        NumberBuffer boxMinX
        NumberBuffer boxMinY
        NumberBuffer boxMaxX
        NumberBuffer boxMaxY
        integer c = 0
        repeat while c < count
            Contour con = loops:Get(c)
            AddBox(con, boxMinX, boxMinY, boxMaxX, boxMaxY)
            integer n = con:GetSize()
            if n < 3
                probeX:Add(0.0)
                probeY:Add(0.0)
            else
                // as Contour:IsInside: the middle of the longest edge, stepped
                // 1/100000 of its length to the loop's inside
                integer longest = 0
                number longestD2 = -1.0
                integer i = 0
                repeat while i < n
                    integer k = (i + 1) mod n
                    number dx = con:xs:Get(k) - con:xs:Get(i)
                    number dy = con:ys:Get(k) - con:ys:Get(i)
                    number d2 = dx * dx + dy * dy
                    if d2 > longestD2
                        longest = i
                        longestD2 = d2
                    end
                    i = i + 1
                end
                integer after = (longest + 1) mod n
                number ex = con:xs:Get(after) - con:xs:Get(longest)
                number ey = con:ys:Get(after) - con:ys:Get(longest)
                number px = con:xs:Get(longest) + ex / 2.0
                number py = con:ys:Get(longest) + ey / 2.0
                number side = 0.00001
                if con:SignedArea2() < 0
                    side = -side
                end
                px = px - ey * side
                py = py + ex * side
                probeX:Add(px)
                probeY:Add(py)
            end
            c = c + 1
        end

        flags:Empty()
        integer index = 0
        repeat while index < count
            Contour loop = loops:Get(index)
            boolean hole = false
            if loop:GetSize() >= 3
                number x = probeX:Get(index)
                number y = probeY:Get(index)
                integer j = 0
                repeat while j < count
                    if j not= index
                        Contour other = loops:Get(j)
                        if other:GetSize() >= 3 and y >= boxMinY:Get(j) and y < boxMaxY:Get(j) and x >= boxMinX:Get(j) - 0.000001 and x <= boxMaxX:Get(j) + 0.000001
                            if other:ContainsPoint(x, y)
                                hole = not hole
                            end
                        end
                    end
                    j = j + 1
                end
            end
            if hole
                flags:Add(1)
            else
                flags:Add(0)
            end
            index = index + 1
        end
    end

    private action LoopFits(Contour loop, Array<Contour> outline, number depth) returns boolean
        integer n = loop:GetSize()
        if n < 3
            return false
        end
        // A true inset point is never closer than `depth` to the outline; 10%
        // slack covers rounding. Even one vertex closer than that is a fold-
        // over the offsetter kept (a spur on the wall), and the island gets
        // rebuilt exactly instead.
        number need = 0.9 * depth
        integer v = 0
        repeat while v < n
            number x = loop:xs:Get(v)
            number y = loop:ys:Get(v)
            if not InsideFitOutline(x, y)
                return false
            end
            if CloserToFitOutline(x, y)
                return false
            end
            v = v + 1
        end
        return true
    end

    // The loop without the points LoopFits objects to: the tips of spurs the
    // offsetter left where it folded over a notch in the outline. Returns an
    // empty contour, so FitInset falls back on the exact inset, if that
    // would remove more than a quarter of the points or half the area, or
    // if a gap it closes cuts outside the part or too close to its edge.
    private action TrimmedLoop(Contour loop, Array<Contour> outline, number depth) returns Contour
        Contour rejected
        integer n = loop:GetSize()
        if n < 3
            return rejected
        end
        number need = 0.9 * depth
        IntegerBuffer keptIndex
        integer v = 0
        repeat while v < n
            number x = loop:xs:Get(v)
            number y = loop:ys:Get(v)
            if InsideFitOutline(x, y) and not CloserToFitOutline(x, y)
                keptIndex:Add(v)
            end
            v = v + 1
        end
        integer m = keptIndex:GetSize()
        if m < 3 or (n - m) * 4 > n
            return rejected
        end

        // each new edge, where points were left out, must stay inside and
        // clear of the outline at its middle
        integer k = 0
        repeat while k < m
            integer from = keptIndex:Get(k)
            integer to = keptIndex:Get((k + 1) mod m)
            if (to - from + n) mod n not= 1
                number mx = (loop:xs:Get(from) + loop:xs:Get(to)) / 2.0
                number my = (loop:ys:Get(from) + loop:ys:Get(to)) / 2.0
                if not InsideFitOutline(mx, my) or CloserToFitOutline(mx, my)
                    return rejected
                end
            end
            k = k + 1
        end

        Contour trimmed
        k = 0
        repeat while k < m
            integer kv = keptIndex:Get(k)
            trimmed:AddPoint(loop:xs:Get(kv), loop:ys:Get(kv))
            k = k + 1
        end
        trimmed:closed = true
        trimmed:planeIndex = loop:planeIndex
        trimmed:isHole = loop:isHole
        trimmed:depth = loop:depth
        if util:AbsNum(trimmed:SignedArea2()) < 0.5 * util:AbsNum(loop:SignedArea2())
            return rejected
        end
        return trimmed
    end

    // Inside the outline (even-odd over all its loops, so holes count).
    // Indexes the outline for InsideFitOutline and CloserToFitOutline, which
    // then give exactly what InsideOutline(outline, x, y) and
    // CloserThan(outline, x, y, limit) give, from the few edges that can
    // matter instead of every edge of the layer: an edge closer than limit
    // to a point passes through one of the 9 cells around it (the cells are
    // a little wider than limit), and only an edge spanning a point's height
    // can cross the ray InsideOutline casts from it.
    private action BuildFitIndex(Array<Contour> outline, number limit)
        fitLimit = limit
        fitAX:Empty()
        fitAY:Empty()
        fitBX:Empty()
        fitBY:Empty()
        IntegerBuffer forInside     // edges of loops of at least 3 points (ContainsPoint skips smaller ones)
        integer c = 0
        repeat while c < outline:GetSize()
            Contour con = outline:Get(c)
            integer n = con:GetSize()
            integer j = n - 1
            integer i = 0
            repeat while i < n
                if n >= 3
                    forInside:Add(fitAX:GetSize())
                end
                fitAX:Add(con:xs:Get(j))
                fitAY:Add(con:ys:Get(j))
                fitBX:Add(con:xs:Get(i))
                fitBY:Add(con:ys:Get(i))
                j = i
                i = i + 1
            end
            c = c + 1
        end

        fitCells:Empty()
        fitCellFirst:Empty()
        fitEntryEdge:Empty()
        fitEntryNext:Empty()
        fitLongEdges:Empty()
        fitBandStart:Empty()
        fitBandEdges:Empty()
        fitBandCount = 0
        integer edgeCount = fitAX:GetSize()
        if edgeCount = 0
            return now
        end
        number lowX = fitAX:Get(0)
        number lowY = fitAY:Get(0)
        number highY = lowY
        integer e = 1
        repeat while e < edgeCount
            lowX = util:Min2(lowX, fitAX:Get(e))
            lowY = util:Min2(lowY, fitAY:Get(e))
            highY = util:Max2(highY, fitAY:Get(e))
            e = e + 1
        end

        // the grid, for CloserToFitOutline
        fitOriginX = lowX
        fitOriginY = lowY
        fitCell = 1.001 * limit         // a little over limit, so rounding can't hide a neighbour
        if fitCell <= 0
            fitCell = 1.0
        end
        e = 0
        repeat while e < edgeCount
            integer x0 = FitCellOf(util:Min2(fitAX:Get(e), fitBX:Get(e)), fitOriginX)
            integer x1 = FitCellOf(util:Max2(fitAX:Get(e), fitBX:Get(e)), fitOriginX)
            integer y0 = FitCellOf(util:Min2(fitAY:Get(e), fitBY:Get(e)), fitOriginY)
            integer y1 = FitCellOf(util:Max2(fitAY:Get(e), fitBY:Get(e)), fitOriginY)
            if (x1 - x0 + 1) * (y1 - y0 + 1) > 64
                fitLongEdges:Add(e)
            else
                integer gx = x0
                repeat while gx <= x1
                    integer gy = y0
                    repeat while gy <= y1
                        integer cell = fitCells:IdOf(FitCellKey(gx), FitCellKey(gy))
                        if cell = fitCellFirst:GetSize()
                            fitCellFirst:Add(-1)
                        end
                        fitEntryEdge:Add(e)
                        fitEntryNext:Add(fitCellFirst:Get(cell))
                        fitCellFirst:Set(cell, fitEntryEdge:GetSize() - 1)
                        gy = gy + 1
                    end
                    gx = gx + 1
                end
            end
            e = e + 1
        end

        // the bands, for InsideFitOutline (counting sort of the edges by band)
        fitBandCount = edgeCount / 4
        if fitBandCount < 1
            fitBandCount = 1
        end
        if fitBandCount > 512
            fitBandCount = 512
        end
        fitBandMin = lowY
        fitBandHeight = (highY - lowY) / cast(number, fitBandCount)
        if fitBandHeight <= 0
            fitBandHeight = 1.0
        end
        integer b = 0
        repeat while b <= fitBandCount
            fitBandStart:Add(0)
            b = b + 1
        end
        integer k = 0
        repeat while k < forInside:GetSize()
            integer edge = forInside:Get(k)
            integer first = FitBandOf(util:Min2(fitAY:Get(edge), fitBY:Get(edge)))
            integer last = FitBandOf(util:Max2(fitAY:Get(edge), fitBY:Get(edge)))
            b = first
            repeat while b <= last
                fitBandStart:Set(b + 1, fitBandStart:Get(b + 1) + 1)
                b = b + 1
            end
            k = k + 1
        end
        b = 1
        repeat while b <= fitBandCount
            fitBandStart:Set(b, fitBandStart:Get(b) + fitBandStart:Get(b - 1))
            b = b + 1
        end
        fitBandEdges:SetSize(fitBandStart:Get(fitBandCount))
        IntegerBuffer cursor
        b = 0
        repeat while b < fitBandCount
            cursor:Add(fitBandStart:Get(b))
            b = b + 1
        end
        k = 0
        repeat while k < forInside:GetSize()
            integer edge2 = forInside:Get(k)
            integer from = FitBandOf(util:Min2(fitAY:Get(edge2), fitBY:Get(edge2)))
            integer upTo = FitBandOf(util:Max2(fitAY:Get(edge2), fitBY:Get(edge2)))
            b = from
            repeat while b <= upTo
                fitBandEdges:Set(cursor:Get(b), edge2)
                cursor:Set(b, cursor:Get(b) + 1)
                b = b + 1
            end
            k = k + 1
        end
    end

    // InsideOutline for the outline BuildFitIndex indexed: the crossings of
    // a ray from (x, y) toward +x, counted exactly as ContainsPoint counts
    // them, over the edges of the point's band (no other edge can cross it).
    private action InsideFitOutline(number x, number y) returns boolean
        boolean inside = false
        if fitBandCount = 0
            return false
        end
        integer b = FitBandOf(y)
        integer k = fitBandStart:Get(b)
        repeat while k < fitBandStart:Get(b + 1)
            integer e = fitBandEdges:Get(k)
            number xi = fitBX:Get(e)
            number yi = fitBY:Get(e)
            number xj = fitAX:Get(e)
            number yj = fitAY:Get(e)
            boolean iAbove = yi > y
            boolean jAbove = yj > y
            if iAbove not= jAbove
                number xCross = xi + (y - yi) * (xj - xi) / (yj - yi)
                if x < xCross
                    inside = not inside
                end
            end
            k = k + 1
        end
        return inside
    end

    // CloserThan(outline, x, y, fitLimit) for the outline BuildFitIndex
    // indexed: the long edges, then the edges in the 9 cells around (x, y).
    private action CloserToFitOutline(number x, number y) returns boolean
        number limit2 = fitLimit * fitLimit
        integer k = 0
        repeat while k < fitLongEdges:GetSize()
            integer e = fitLongEdges:Get(k)
            if util:SegmentDistance2(x, y, fitAX:Get(e), fitAY:Get(e), fitBX:Get(e), fitBY:Get(e)) < limit2
                return true
            end
            k = k + 1
        end
        if fitCellFirst:GetSize() = 0
            return false
        end
        integer cx = FitCellOf(x, fitOriginX)
        integer cy = FitCellOf(y, fitOriginY)
        integer dx = -1
        repeat while dx <= 1
            integer dy = -1
            repeat while dy <= 1
                integer cell = fitCells:Find(FitCellKey(cx + dx), FitCellKey(cy + dy))
                if cell >= 0
                    integer m = fitCellFirst:Get(cell)
                    repeat while m >= 0
                        integer e2 = fitEntryEdge:Get(m)
                        if util:SegmentDistance2(x, y, fitAX:Get(e2), fitAY:Get(e2), fitBX:Get(e2), fitBY:Get(e2)) < limit2
                            return true
                        end
                        m = fitEntryNext:Get(m)
                    end
                end
                dy = dy + 1
            end
            dx = dx + 1
        end
        return false
    end

    private action FitCellOf(number v, number origin) returns integer
        return util:FloorToInt((v - origin) / fitCell)
    end

    // A grid cell number as a PointIndex key (PointIndex multiplies by 1024).
    private action FitCellKey(integer cell) returns number
        return cast(number, cell) / 1024.0
    end

    private action FitBandOf(number y) returns integer
        integer b = util:FloorToInt((y - fitBandMin) / fitBandHeight)
        if b < 0
            return 0
        end
        if b > fitBandCount - 1
            return fitBandCount - 1
        end
        return b
    end

    private action InsideOutline(Array<Contour> outline, number x, number y) returns boolean
        boolean inside = false
        integer c = 0
        repeat while c < outline:GetSize()
            Contour con = outline:Get(c)
            if con:ContainsPoint(x, y)
                inside = not inside
            end
            c = c + 1
        end
        return inside
    end

    // Is (x, y) closer than `limit` to any edge of the outline? Stops at the
    // first edge that is.
    private action CloserThan(Array<Contour> outline, number x, number y, number limit) returns boolean
        number limit2 = limit * limit
        integer c = 0
        repeat while c < outline:GetSize()
            Contour con = outline:Get(c)
            integer n = con:GetSize()
            integer j = n - 1
            integer i = 0
            repeat while i < n
                if util:SegmentDistance2(x, y, con:xs:Get(j), con:ys:Get(j), con:xs:Get(i), con:ys:Get(i)) < limit2
                    return true
                end
                j = i
                i = i + 1
            end
            c = c + 1
        end
        return false
    end

    private action FindSkin(integer p, Array<Contour> innerArea) returns Array<Contour>
        Array<Contour> top = Uncovered(p, innerArea, 1, topLayers)
        Array<Contour> bottom = Uncovered(p, innerArea, -1, bottomLayers)
        if top:GetSize() = 0
            return bottom
        end
        if bottom:GetSize() = 0
            return top
        end
        return ops:Union(top, bottom, p)
    end

    // ------------------------------------------------------------ top surfaces

    // Fills the part of `solid` that is top surface (not covered by all of
    // the next topSurfaceLayers layers) into topSurface, and the ironing for
    // the part with nothing at all on it into ironingLines. Returns the rest
    // of `solid`, for ordinary skin.
    //
    // A layer is covered by the model's whole outline on the layer above,
    // not just that layer's inner area: where the part narrows going up,
    // the band under the next layer's walls is covered too.
    private action SplitTopSurface(integer p, Array<Contour> solid) returns Array<Contour>
        if solid:GetSize() = 0
            return solid
        end
        Array<Contour> rest = solid
        Array<Contour> exposed
        boolean haveExposed = false

        if topSurfaceLayers > 0
            Array<Contour> covered = CoveredAbove(p, topSurfaceLayers)
            Array<Contour> top = solid
            if covered:GetSize() > 0
                top = ops:Difference(solid, covered, p)
                rest = ops:Intersect(solid, covered, p)
            else
                Array<Contour> none
                rest = none
            end
            if top:GetSize() > 0
                // Joined zigzags climb from each line to the next one, always
                // the same way, so no line is ever squeezed in between two
                // that have already cooled (what leaves ridges and pinholes
                // on a top surface).
                lineFill:FillJoined(top, p, lineWidth, minInfillLength, topSurface)
            end
            if topSurfaceLayers = 1
                exposed = top
                haveExposed = true
            end
        end

        if ironing
            if not haveExposed
                exposed = solid
                Array<Contour> above = CoveredAbove(p, 1)
                if above:GetSize() > 0
                    exposed = ops:Difference(solid, above, p)
                end
            end
            if exposed:GetSize() > 0
                Iron(p, exposed)
            end
        end
        return rest
    end

    // The area covered on every one of the next `count` planes (the model's
    // whole outline there), or nothing if any of them is empty or past the
    // top of the model.
    private action CoveredAbove(integer p, integer count) returns Array<Contour>
        Array<Contour> nothing
        Array<Contour> covered
        integer j = 1
        repeat while j <= count
            integer q = p + j
            if q >= planeTotal
                return nothing
            end
            Array<Contour> above = modelLayers:GetLayer(q)
            if above:GetSize() = 0
                return nothing
            end
            if j = 1
                covered = above
            else
                covered = ops:Intersect(covered, above, p)
                if covered:GetSize() = 0
                    return nothing
                end
            end
            j = j + 1
        end
        return covered
    end

    // Ironing lines over `exposed` (a surface nothing is printed on), kept
    // ironingInset in from its edge. They run across the surface's own lines:
    // filling as if on the next plane gives the other of the two angles.
    private action Iron(integer p, Array<Contour> exposed)
        Array<Contour> area = exposed
        if ironingInset > 0
            area = FitInset(exposed, ironingInset, false)
        end
        if area:GetSize() = 0
            return now
        end
        Array<Contour> lines
        lineFill:FillJoined(area, p + 1, ironingSpacing, minInfillLength, lines)
        integer i = 0
        repeat while i < lines:GetSize()
            Contour line = lines:Get(i)
            line:planeIndex = p
            ironingLines:Add(line)
            i = i + 1
        end
    end

    // The part of innerArea not covered by every one of the next `count`
    // layers in `direction` (+1 = up, -1 = down).
    private action Uncovered(integer p, Array<Contour> innerArea, integer direction, integer count) returns Array<Contour>
        Array<Contour> nothing
        if count <= 0
            return nothing
        end

        Array<Contour> covered
        integer j = 1
        repeat while j <= count
            integer q = p + direction * j
            if q < 0 or q >= planeTotal
                return innerArea // runs off the model: all of it is surface
            end
            Array<Contour> neighbour = InnerContours(q)
            if neighbour:GetSize() = 0
                return innerArea
            end
            if j = 1
                covered = neighbour
            else
                covered = ops:Intersect(covered, neighbour, p)
                if covered:GetSize() = 0
                    return innerArea
                end
            end
            j = j + 1
        end
        return ops:Difference(innerArea, covered, p)
    end

    // Grows `region` outward by r: everything within r of it, corners
    // rounded (the offsetter's rounded outset). It used to be the region plus
    // AddEdgeBands outward, one union of thousands of overlapping bands; the
    // outset is about ten times cheaper and matches it to within the bands'
    // own arc steps.
    private action ExactOutset(Array<Contour> region, number r) returns Array<Contour>
        return offsetter:OffsetRounded(region, -r)
    end

    // Wall w should cover the band w..w+1 widths in. Wherever it couldn't
    // (the part is too thin there), fill that band with solid lines.
    private action WallGaps(Array<Contour> layer, integer w, Array<Contour> deeper, integer p)
        Array<Contour> band = CachedFitInset(layer, lineWidth * cast(number, w), false)
        if band:GetSize() = 0
            return now
        end
        Array<Contour> gaps = band
        Array<Contour> reach = ExactOutset(deeper, lineWidth)
        if reach:GetSize() > 0
            gaps = ops:Difference(band, reach, p)
        end
        if gaps:GetSize() > 0
            lineFill:Fill(gaps, p, lineWidth, minInfillLength, skin)
        end
    end

    // The band inside the innermost wall (`band`, from Inset(layer,
    // lineWidth * wallCount)) where one more wall wouldn't fit from both
    // sides: narrower than two line widths, so the fill lines there come out
    // too short and are dropped, and the band would stay an open slot. Fill
    // it with solid lines, as WallGaps does between walls, and remember it
    // so the plane's fill leaves it alone.
    //
    // Pieces smaller than half a line width squared are left out: they are
    // the slivers in the corners of every wide area (where one more wall
    // would round the corner off), far too small for a line.
    private action GapFill(Array<Contour> layer, Array<Contour> band, integer p)
        Array<Contour> gapArea = band
        Array<Contour> deeper = FitInset(layer, lineWidth * cast(number, wallCount + 1), false)
        if deeper:GetSize() > 0
            Array<Contour> reach = ExactOutset(deeper, lineWidth)
            if reach:GetSize() > 0
                gapArea = ops:Difference(band, reach, p)
            end
        end
        number smallest = lineWidth * lineWidth * 0.5
        Array<Contour> kept
        integer i = 0
        repeat while i < gapArea:GetSize()
            Contour piece = gapArea:Get(i)
            if piece:GetSize() >= 3 and piece:Area() >= smallest
                kept:Add(piece)
            end
            i = i + 1
        end
        if kept:GetSize() = 0
            return now
        end
        // A band a little under a line width wide is crossed by lines not
        // much longer than it is wide, so lines down to half a line width are
        // kept (and marked so PathOrderer keeps them too); each still lays
        // the plastic for the area it covers.
        Array<Contour> lines
        lineFill:Fill(kept, p, lineWidth, lineWidth * 0.5, lines)
        i = 0
        repeat while i < lines:GetSize()
            Contour line = lines:Get(i)
            line:keepShort = true
            skin:Add(line)
            i = i + 1
        end
        i = 0
        repeat while i < kept:GetSize()
            gapAreas:Add(kept:Get(i))
            i = i + 1
        end
    end

    private action GapContours(integer p) returns Array<Contour>
        Array<Contour> area
        integer k = gapStart:Get(p)
        repeat while k < gapStart:Get(p + 1)
            area:Add(gapAreas:Get(k))
            k = k + 1
        end
        return area
    end

    private action InnerContours(integer p) returns Array<Contour>
        Array<Contour> area
        integer k = innerStart:Get(p)
        repeat while k < innerStart:Get(p + 1)
            area:Add(inner:Get(k))
            k = k + 1
        end
        return area
    end

    // area inside adative walls
    // the same as on uniform planes: the shell meta-scheme gives the walls their preferred width once a part is
    // (2 * wallCount + 1) widths wide, so they end wallCount widths in. Narrower parts get no fill from Generate's
    // fillArea (its centres need 2 * (wallCount + 0.5 - adaptiveFillOverlap) widths), and their walls fill them
    private action AdaptiveInner(Array<Contour> layer, Array<Contour> planeWalls) returns Array<Contour>
        return Inset(layer, lineWidth * cast(number, wallCount))
    end

    // number of failed adaptive walls
    // walls were uniform instead
    action GetAdaptiveFallbackCount returns integer
        return adaptiveFallbacks
    end

    // Extruded area of a set of paths: length times width, summed (mm^2). Uniform paths use lineWidth.
    private action ExtrudedArea(Array<Contour> paths) returns number
        number total = 0.0
        integer c = 0
        repeat while c < paths:GetSize()
            Contour path = paths:Get(c)
            integer n = path:GetSize()
            integer segments = n - 1
            if path:closed
                segments = n
            end
            integer s = 0
            repeat while s < segments
                integer t = (s + 1) mod n
                number dx = path:xs:Get(t) - path:xs:Get(s)
                number dy = path:ys:Get(t) - path:ys:Get(s)
                number width = lineWidth
                if path:IsAdaptive()
                    width = (path:ws:Get(s) + path:ws:Get(t)) / 2.0
                end
                total = total + math:SquareRoot(dx * dx + dy * dy) * width
                s = s + 1
            end
            c = c + 1
        end
        return total
    end

    // Area of outline (include outer wall, exclude holes)
    private action RegionArea(Array<Contour> loops) returns number
        number total = 0.0
        integer c = 0
        repeat while c < loops:GetSize()
            Contour loop = loops:Get(c)
            if loop:closed and loop:GetSize() >= 3
                if loop:isHole
                    total = total - loop:Area()
                else
                    total = total + loop:Area()
                end
            end
            c = c + 1
        end
        return total
    end
end
