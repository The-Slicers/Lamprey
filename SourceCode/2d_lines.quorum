use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Color
use Libraries.Containers.Array
use Libraries.Compute.Math
use geometry.Segment

class LineRender is Game
    public Array<Segment> segments
    Math math

    integer screenWidth = 1000
    integer screenHeight = 800
    number margin = 70.0

    number minX = 0.0
    number minY = 0.0
    number scale = 1.0
    number offsetX = 0.0
    number offsetY = 0.0

    action LineRender
        SetScreenSize(screenWidth, screenHeight)
        StartGame()
    end

    action CreateGame
        LoadTestSegments()      // replace with your own data
        ComputeTransform()

        integer count = segments:GetSize()
        integer i = 0
        repeat while i < count
            DrawSegment(segments:Get(i), i, count)
            i = i + 1
        end

        DrawSummary()
    end

    action Update(number seconds)
    end

    // ---------- test data: a counter-clockwise square ----------
    action LoadTestSegments
        AddSegment(0.0, 0.0, 10.0, 0.0)
        AddSegment(10.0, 0.0, 10.0, 10.0)
        AddSegment(10.0, 10.0, 0.0, 10.0)
        AddSegment(0.0, 10.0, 0.0, 0.0)
    end

    action AddSegment(number ax, number ay, number bx, number by)
        Segment s
        s:x0 = ax
        s:y0 = ay
        s:x1 = bx
        s:y1 = by
        segments:Add(s)
    end

    // ---------- world -> screen mapping ----------
    action ComputeTransform
        if segments:GetSize() = 0
            return now
        end

        Segment first = segments:Get(0)
        minX = first:x0
        minY = first:y0
        number maxX = first:x0
        number maxY = first:y0

        integer i = 0
        repeat while i < segments:GetSize()
            Segment s = segments:Get(i)
            minX = math:MinimumOf(minX, math:MinimumOf(s:x0, s:x1))
            minY = math:MinimumOf(minY, math:MinimumOf(s:y0, s:y1))
            maxX = math:MaximumOf(maxX, math:MaximumOf(s:x0, s:x1))
            maxY = math:MaximumOf(maxY, math:MaximumOf(s:y0, s:y1))
            i = i + 1
        end

        number worldW = maxX - minX
        number worldH = maxY - minY
        if worldW <= 0.0
            worldW = 1.0
        end
        if worldH <= 0.0
            worldH = 1.0
        end

        number availW = screenWidth - 2.0 * margin
        number availH = screenHeight - 2.0 * margin
        scale = math:MinimumOf(availW / worldW, availH / worldH)

        // center the drawing
        offsetX = margin + (availW - worldW * scale) / 2.0
        offsetY = margin + (availH - worldH * scale) / 2.0
    end

    action ToScreenX(number x) returns number
        return offsetX + (x - minX) * scale
    end

    action ToScreenY(number y) returns number
        return offsetY + (y - minY) * scale
    end

    // ---------- drawing ----------
    action DrawSegment(Segment s, integer index, integer count)
        number sx0 = ToScreenX(s:x0)
        number sy0 = ToScreenY(s:y0)
        number sx1 = ToScreenX(s:x1)
        number sy1 = ToScreenY(s:y1)

        // gradient color: first segment blue, last segment orange
        number t = 0.0
        if count > 1
            t = cast(number, index) / cast(number, count - 1)
        end
        Color color
        color:SetColor(1.0 * t + 0.1, 0.45, 1.0 - t, 1.0)

        // line body (LoadLine is relative to the drawable's position)
        Drawable line
        line:LoadLine(sx1 - sx0, sy1 - sy0, color)
        line:SetPosition(sx0, sy0)
        Add(line)

        number dx = sx1 - sx0
        number dy = sy1 - sy0
        number length = math:SquareRoot(dx * dx + dy * dy)

        if length > 0.0
            number ux = dx / length
            number uy = dy / length
            DrawArrowhead(sx0 + dx / 2.0, sy0 + dy / 2.0, ux, uy, length, color)
            DrawLabel(s, index, sx0 + dx / 2.0, sy0 + dy / 2.0, ux, uy, color)
        end

        DrawStartPoint(sx0, sy0)
        DrawEndPoint(sx1, sy1)
    end

    action DrawArrowhead(number midX, number midY, number ux, number uy,
                         number length, Color color)
        number size = math:MinimumOf(14.0, length / 3.0)
        number tipX = midX + ux * size / 2.0
        number tipY = midY + uy * size / 2.0

        // rotate the backward vector (-ux, -uy) by +/- 30 degrees
        number c = 0.866
        number sn = 0.5
        number w1x = (-ux * c + uy * sn) * size
        number w1y = (-ux * sn - uy * c) * size
        number w2x = (-ux * c - uy * sn) * size
        number w2y = (ux * sn - uy * c) * size

        Drawable wing1
        wing1:LoadLine(w1x, w1y, color)
        wing1:SetPosition(tipX, tipY)
        Add(wing1)

        Drawable wing2
        wing2:LoadLine(w2x, w2y, color)
        wing2:SetPosition(tipX, tipY)
        Add(wing2)
    end

    action DrawStartPoint(number x, number y)
        number r = 5.0
        Color green
        green:SetColor(0.1, 0.85, 0.2, 1.0)
        Drawable dot
        dot:LoadFilledCircle(r, green)
        dot:SetPosition(x - r, y - r)   // circles are positioned by bottom-left corner
        Add(dot)
    end

    action DrawEndPoint(number x, number y)
        number r = 8.0
        Color red
        red:SetColor(0.9, 0.15, 0.15, 1.0)
        Drawable ring
        ring:LoadCircle(r, red)
        ring:SetPosition(x - r, y - r)
        Add(ring)
    end

    action DrawLabel(Segment s, integer index, number midX, number midY,
                     number ux, number uy, Color color)
        // offset perpendicular to the segment (left-hand side)
        number px = -uy * 16.0
        number py = ux * 16.0

        Label label
        label:SetText("#" + index + " p" + s:planeIndex)
        label:SetColor(color)
        label:SetPosition(midX + px, midY + py)
        Add(label)
    end

    // ---------- winding + connectivity summary ----------
    action DrawSummary
        number area2 = 0.0
        integer gaps = 0
        number tolerance = 0.000001
        integer n = segments:GetSize()

        integer i = 0
        repeat while i < n
            Segment s = segments:Get(i)
            area2 = area2 + (s:x0 * s:y1 - s:x1 * s:y0)

            Segment next = segments:Get((i + 1) mod n)
            if math:AbsoluteValue(s:x1 - next:x0) > tolerance or
               math:AbsoluteValue(s:y1 - next:y0) > tolerance
                gaps = gaps + 1
            end
            i = i + 1
        end

        text winding = "degenerate (zero area)"
        if area2 > 0.0
            winding = "counter-clockwise"
        elseif area2 < 0.0
            winding = "clockwise"
        end

        Label summary
        summary:SetText("Segments: " + n + "   Winding: " + winding +
                        "   Signed area: " + (area2 / 2.0) +
                        "   Gaps: " + gaps)
        summary:SetPosition(10.0, screenHeight - 25.0)
        Add(summary)
    end
end