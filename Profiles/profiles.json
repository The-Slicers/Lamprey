{
    "_about": "Lamprey slicer profiles. Each profile lists only what it changes; 'inherits' names the profile it starts from, and anything not set anywhere uses the default in SourceCode/Profiles/ProfileSchema.quorum. Keys starting with _ are comments.",

    "bambu-p2s": {
        "_note": "Values from Main.BambuRun, except the bed: the P2S is 256 x 256 x 256 (Main used 220, which centred prints at 110, 110 and would tell Bambu Studio the plate is 220 mm).",
        "bedWidth": 256,
        "bedDepth": 256,
        "bedHeight": 256,
        "nozzleDiameter": 0.4,
        "startGcodeFile": "Templates/bambu-p2s/start.gcode",
        "endGcodeFile": "Templates/bambu-p2s/end.gcode",
        "bambuExtras": true,
        "write3mf": true,
        "printerModelId": "N7",
        "bambuSettingsTemplate": "Templates/bambu-p2s/p2s_project_settings.json",

        "filamentType": "PLA",
        "filamentColor": "#FFFFFF",
        "filamentDiameter": 1.75,
        "flow": 1.0,
        "maxFlow": 21,
        "nozzleTemperature": 210,
        "bedTemperature": 60,
        "bedType": "textured_plate",

        "unitScale": 1.0,
        "layerHeight": 0.2,
        "contourMaxGap": 0.2,
        "simplifyTolerance": 0.02,
        "minContourArea": 0.05,

        "lineWidth": 0.4,
        "wallCount": 3,
        "infillDensity": 0.15,
        "topLayers": 3,
        "bottomLayers": 3,

        "supportsEnabled": false,
        "adhesionType": "none",

        "outerWallSpeed": 200,
        "innerWallSpeed": 300,
        "skinSpeed": 200,
        "infillSpeed": 270,
        "supportSpeed": 150,
        "firstLayerSpeed": 50,
        "travelSpeed": 600,

        "accelOuterWall": 6000,
        "accelInnerWall": 10000,
        "accelSkin": 2000,
        "accelInfill": 10000,
        "accelSupport": 10000,
        "accelFirstLayer": 500,
        "accelTravel": 10000,

        "retractLength": 0.8,
        "retractSpeed": 30,
        "retractLimitCount": 90,
        "retractLimitWindow": 0.9,
        "zHop": 0.4,
        "zHopMinTravel": 1.5,

        "minLayerTime": 4,
        "minPrintSpeed": 20
    },

    "bambu-p2s-petg": {
        "_note": "Example of a filament variant. Export a sliced PETG plate from Bambu Studio and point bambuSettingsTemplate at it, or the 3MF keeps the PLA template's other filament settings (Lamprey warns about this).",
        "inherits": "bambu-p2s",
        "filamentType": "PETG",
        "nozzleTemperature": 250,
        "bedTemperature": 70,
        "fanMax": 128
    },

    "ender3-v2": {
        "_note": "Values from Main.EnderRun.",
        "bedWidth": 200,
        "bedDepth": 200,
        "bedHeight": 200,
        "nozzleDiameter": 0.4,
        "startGcodeFile": "Templates/ender3-v2/start.gcode",
        "endGcodeFile": "Templates/ender3-v2/end.gcode",
        "bambuExtras": false,
        "write3mf": false,

        "filamentType": "PLA",
        "filamentDiameter": 1.75,
        "flow": 1.0,
        "maxFlow": 10,
        "nozzleTemperature": 210,
        "bedTemperature": 60,

        "unitScale": 1.0,
        "layerHeight": 0.2,
        "contourMaxGap": 0.2,
        "simplifyTolerance": 0.02,
        "minContourArea": 0.05,

        "lineWidth": 0.4,
        "wallCount": 3,
        "infillDensity": 0.15,
        "topLayers": 4,
        "bottomLayers": 3,

        "supportsEnabled": true,
